<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!--
      CA1707: имена тестов содержат подчёркивания - это осознанная конвенция
      ПроверяемыйМетод_Сценарий_Ожидание, а не нарушение оформления.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrainingLog.Core\TrainingLog.Core.csproj" />
    <!-- Нужен ради EditExerciseViewModel: без него модели представления не покрыты тестами. -->
    <ProjectReference Include="..\..\src\TrainingLog\TrainingLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      UseWPF сужает набор неявных using'ов: System.IO и System.Net.Http пропадают.
      System.IO нужен TemporaryDatabase (Path, File, IOException), поэтому возвращаем явно.
    -->
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
