# Файлы миграций создаются инструментом dotnet ef и не должны правиться руками.
# Генератор всегда пишет блочные namespace, а корневой .editorconfig требует file-scoped
# с уровнем ошибки. generated_code отключает для этой папки применение правил оформления,
# иначе сборка падала бы на каждой новой миграции.
[*.cs]
generated_code = true
