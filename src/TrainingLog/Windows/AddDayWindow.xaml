<Window x:Class="TrainingLog.Windows.AddDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:AddDayViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="760"
        Height="480"
        MinWidth="620"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Окно одно и на добавление дня, и на правку: различаются только заголовок и то, что
      модель нашла в базе за эту дату. Заголовок и «Сохранить» приходят из модели, окно их
      не задаёт.

      Кнопки упражнений — это номера по порядку выполнения, подсказка на кнопке — название.
      Активное упражнение показывается по центру, а «‹» и «›» листают упражнения плана.
      Подходы набираются рядом с ним: вес над повторениями в одном столбце, «−» слева,
      «+» справа на обе строки.
    -->
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
          Стрелки перехода между упражнениями: полоса во всю высоту, рисунок по центру.

          Рамки у кнопки нет намеренно — полоса во всю высоту в системной рамке выглядит
          тяжело. Раз системной подсветки при наведении больше нет, она описана здесь же.
          Подложка взята системным цветом Control, как подложки панелей в остальных окнах,
          поэтому в тёмной теме она останется темнее фона окна, а не станет светлым пятном.
        -->
        <ControlTemplate x:Key="ArrowButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
          Цвета шеврона. Состояния берутся у кнопки-предка: у Path нет IsEnabled, поэтому
          иначе бледная недоступная стрелка загоралась бы при наведении.

          Порядок триггеров значим: IsEnabled=False объявлен последним и потому выигрывает у
          наведения — disabled не должен реагировать на мышь.
        -->
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">
                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="False">
                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
      Ctrl+S зовёт «Сохранить», а не «Сохранить и закрыть»: горячая клавиша означает «сохранить
      то, что набрано», и ждать после неё закрытия окна не должен никто. Объявлено в разметке
      же, а не в code-behind: KeyBinding не требует обработчика, и при смене команды привязка
      меняется в одном месте.
    -->
    <Window.InputBindings>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Дата" />

            <DatePicker Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        SelectedDate="{Binding Date}" />

            <TextBlock Grid.Column="2"
                       Margin="16,0,8,0"
                       VerticalAlignment="Center"
                       Text="План" />

            <ComboBox Grid.Column="3"
                      VerticalAlignment="Center"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Plans}"
                      SelectedItem="{Binding SelectedPlan}" />
        </Grid>

        <!--
          Кнопки упражнений переносятся на вторую строку, а не уходят за окно: упражнений в
          плане сколько угодно, а StackPanel без WrapPanel меряется под всё содержимое и
          обрезается краем окна. Та же причина, что и у подходов.

          Центрирование стоит на ItemsControl, а не на родительской сетке: центрированный
          элемент меряется под своё содержимое, и колонка * его не ограничит — это убьёт
          перенос (ловушка 29). Сам ItemsControl центрированный, потому что колонка * задана
          в родителе, то есть ограничение ширины ещё действует.
        -->
        <ItemsControl Grid.Row="1"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding Exercises}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                      Кнопка занимает номер по порядку выполнения, а не позицию в
                      отфильтрованном списке: номер и состав задаёт план, и он же показан
                      подсказкой вместе с названием.
                    -->
                    <Button Margin="0,0,6,0"
                            MinWidth="34"
                            Padding="8,4"
                            Command="{Binding DataContext.SelectExerciseCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Number}"
                            ToolTip="{Binding Name}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          Пока из базы читается прошлый день, ввод заблокирован целиком: навигация по
          упражнениям, поля веса и повторений и обе кнопки подхода. Ответ придёт в уже
          заполненные поля и затрёт набранное, поэтому блокируется область целиком, а не
          одни поля.

          Кнопки сохранения не блокируются: на дне, где подтягивание вообще идёт, сохранять
          нечего, и их гасит CanAccept — тот же самый. Отдельное состояние кнопок только
          разошлось бы с правилом пригодности.
        -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0"
              IsEnabled="{Binding CanFill}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <!--
              Переходы между упражнениями стоят по краям и тянутся во всю высоту области ввода.
              Проверку активности снимает WPF сама по CanExecute команды, поэтому у первого
              упражнения «‹» бледная, а у последнего «›».

              Шеврон нарисован заливкой, а не обводкой: толщина штриха при Stretch="Uniform"
              масштабировалась бы вместе с рисунком и зависела бы от размера окна, а в
              заливке толщина часть геометрии и одинакова всегда.

              Высота рисунка задана явно. Без неё Uniform растянет шеврон по всей ширине
              полосы: колонка фиксированная, и иначе стрелка занимала бы её целиком,
              слипаясь с полями ввода.
            -->
            <Button Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding PreviousCommand}"
                    Template="{StaticResource ArrowButtonTemplate}"
                    ToolTip="Предыдущее упражнение">
                <Path Height="22"
                      Stretch="Uniform"
                      Data="M 9,2 L 3,11 L 9,20 L 6,20 L 0,11 L 6,2 Z"
                      Style="{StaticResource Chevron}" />
            </Button>

            <!--
              Отступ по бокам — чтобы «−» и «+» не прилипали к «‹» и «›»: центральная область
              стоит между навигацией, и без зазора четыре кнопки читаются как одна полоса.
            -->
                <Grid Grid.Column="1"
                      Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                  Название упражнения переносится по словам, а не обрезается: названия в
                  плане пишут как хочется, и длинное «Жим лёжа в нижней части груди узким
                  хватом» не должно упираться в край окна.

                  Два центрирования работают вместе, и одно без другого не годится.
                  HorizontalAlignment центрирует сам элемент — короткое название выглядит
                  как раньше. TextAlignment центрирует строки внутри элемента — при переносе
                  на несколько строк каждая встаёт по центру, а не по левому краю своей же
                  строки.

                  Элемент центрированный, и по ловушке 29 его ширину должен бы задавать
                  размер содержимого. Здесь это безопасно: надпись лежит в строке Auto, а
                  ограничивающая колонка * стоит уровнем выше, в родительской сетке. Надпись
                  и область подходов получают одну ширину, поэтому подходы не уезжают.
                  В горизонтальном StackPanel или колонке Auto такое центрирование сломало
                  бы перенос, и там центрировать нельзя.
                -->
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,4,0,12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Current.Name, TargetNullValue=''}" />

                <!--
                  Подходы переносятся на вторую строку, а не уходят за окно: у каждого
                  упражнения подходов сколько угодно, а окно не умеет прокручиваться и просто
                  обрезает содержимое.

                  Ключ к переносу — колонка шириной *, и именно поэтому у Grid не может стоять
                  HorizontalAlignment="Center": центрированный элемент меряется под своё
                  содержимое, и колонка его не ограничит. Центрирование перенесено на
                  ItemsControl — он уже внутри ограниченной колонки.
                -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                      «−» и «+» нарисованы той же техникой, что и стрелки перехода между
                      упражнениями: тот же прозрачный шаблон кнопки и тот же стиль цвета,
                      поэтому гаснут и загораются одинаково.

                      Рисунок задан квадратом 22×22 и масштабируется 1:1. Это не избыточность:
                      у плюса и минуса, в отличие от шеврона, фигура широкая и низкая, и при
                      одном лишь Stretch="Uniform" с высотой штрих раздулся бы втрое. Заливка
                      вместо обводки — по той же причине, что и у шевронов: толщина обводки
                      масштабировалась бы вместе с рисунком.
                    -->
                    <Button Grid.Column="0"
                            Grid.RowSpan="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding RemoveSetCommand}"
                            Template="{StaticResource ArrowButtonTemplate}"
                            ToolTip="Убрать подход">
                        <Path Width="22"
                              Height="22"
                              Stretch="Uniform"
                              Data="M 2,9.5 L 20,9.5 L 20,12.5 L 2,12.5 Z"
                              Style="{StaticResource Chevron}" />
                    </Button>

                    <!--
                      Подход — это один столбец из двух полей: вес над повторениями. Ширина
                      у всех столбцов одна и та же, поэтому вес стоит ровно над своим
                      повторением, а столбцы совпадают между упражнениями. Переносится столбец
                      целиком, а не поля по отдельности.
                    -->
                    <ItemsControl Grid.Column="1"
                                  Grid.RowSpan="2"
                                  HorizontalAlignment="Center"
                                  ItemsSource="{Binding Current.Sets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!--
                              Нижний отступ разводит перенесённые строки: WrapPanel складывает
                              их вплотную и зазора между строками не создаёт. Отступ задан
                              столбцу подхода, а не панели: иначе разъедутся поля внутри
                              подхода, а не сами подходы.
                            -->
                            <DataTemplate>
                                <Grid Margin="0,0,8,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                      Поле веса — с чуть более тёмным системным фоном, чтобы
                                      отличаться от повторений под ним: подсказки не видно,
                                      пока в поле не наведёшь мышь. Оттенок системный, а не
                                      зашитый, поэтому в тёмной теме он остаётся темнее
                                      фона окна, а не становится светлым пятном.

                                      AllowedCharsInput отбрасывает всё, кроме цифр, точки и
                                      запятой, — и при наборе, и при вставке из буфера. Разбор
                                      в модели при этом остаётся: поле с двумя разделителями
                                      («5,5.5») фильтр пропустит, а вот TryParse отвергнет.
                                    -->
                                    <TextBox Grid.Row="0"
                                             Width="84"
                                             Padding="4,3"
                                             HorizontalContentAlignment="Center"
                                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                             helpers:AllowedCharsInput.Allowed="DigitsWithSeparators"
                                             ToolTip="Вес, кг"
                                             Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--
                                      Поле повторений — целое неотрицательное число, поэтому
                                      разделителей здесь не входит: только цифры.

                                      Плейсхолдер подсказывает повторения прошлого раза и
                                      рисуется ПОВЕРХ поля, а не под ним: фон у TextBox
                                      непрозрачный, и подложка под ним была бы не видна. Блок
                                      объявлен после TextBox именно поэтому — в Grid рисуется
                                      последним объявленным. IsHitTestVisible=False обязателен:
                                      без него надпись перехватывала бы нажатия, и в поле нельзя
                                      было бы ни поставить каретку, ни вставить из буфера.

                                      Цвет приглушённый системный, тот же, что у бледного
                                      недоступного текста: в тёмной теме подсказка не станет
                                      светлым пятном.
                                    -->
                                    <Grid Grid.Row="1"
                                          Width="84"
                                          Height="27"
                                          Margin="0,4,0,0">
                                        <TextBox Padding="4,3"
                                                 HorizontalContentAlignment="Center"
                                                 helpers:AllowedCharsInput.Allowed="Digits"
                                                 ToolTip="Повторения"
                                                 Text="{Binding RepetitionText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                   Text="{Binding RepetitionPlaceholder}"
                                                   Visibility="{Binding HasRepetitionPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="2"
                            Grid.RowSpan="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding AddSetCommand}"
                            Template="{StaticResource ArrowButtonTemplate}"
                            ToolTip="Добавить подход">
                        <Path Width="22"
                              Height="22"
                              Stretch="Uniform"
                              Data="M 9.5,2 L 12.5,2 L 12.5,20 L 9.5,20 Z M 2,9.5 L 20,9.5 L 20,12.5 L 2,12.5 Z"
                              Style="{StaticResource Chevron}" />
                    </Button>
                </Grid>
            </Grid>

            <Button Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Command="{Binding NextCommand}"
                    Template="{StaticResource ArrowButtonTemplate}"
                    ToolTip="Следующее упражнение">
                <Path Height="22"
                      Stretch="Uniform"
                      Data="M 0,2 L 6,11 L 0,20 L 3,20 L 9,11 L 3,2 Z"
                      Style="{StaticResource Chevron}" />
            </Button>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

<!--
              Отказ по двум причинам: день не сохранился либо в поле ввели недопустимое.
              Второе приходит сюда событием AllowedCharsInput.Rejected из code-behind: правило
              одно на все поля, и объяснение отказа не изобретается у каждого окна отдельно.

              Отказ и индикатор стоят в сетке, а не в горизонтальной панели: панель отдаёт
              содержимому бесконечную ширину, и перенос строк у отказа перестал бы работать
              (ловушка 29). Колонка * даёт отказу ширину, Auto — индикатору ровно его.
            -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           TextWrapping="Wrap"
                           Foreground="Firebrick"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="{Binding Status}" />

                <!--
                  Индикатор чтения из базы — рядом с отказом, а не поверх области ввода.
                  Оба сообщения одного рода и место у них одно: если повесить надпись поверх
                  полей, она погасла бы вместе с ними, потому что отключается IsEnabled того
                  же контейнера, и выглядела бы частью заблокированного содержимого, а не
                  сообщением. Кроме того, на заблокированной области она лежала бы на
                  бледном фоне рядом с бледными полями.

                  Привязан CanFill, а не !IsLoading: разметка не должна повторять вычисления
                  модели.
                -->
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="Загрузка…"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!--
              «Сохранить» слева, остальные две справа: частое действие — у левой руки, а кнопка
              закрытия рядом с отменой читается как «всё равно уходит». IsDefault у «Сохранить»
              единственный в окне: иначе Enter звал бы обе.
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  Кнопка в колонке Auto, а надпись — в колонке * между ней и правыми кнопками.
                  Пока надпись стояла в одной колонке Auto с кнопкой, дефект был отложенным, а не
                  настоящим: Auto-колонка не сжимается никогда, а колонка-распорка между двумя
                  Auto спасает ровно до тех пор, пока запаса хватает. С датой источника надпись
                  стала втрое длиннее — и на узком окне «Отменить» уходила за край (ловушка 38).
                -->
                <Button Grid.Column="0"
                        Padding="14,4"
                        VerticalAlignment="Center"
                        Command="{Binding SaveCommand}"
                        Content="Сохранить"
                        IsDefault="True" />

                <!--
                  Надпись стоит у «Сохранить», а не у кнопок закрытия: она относится к тому, что
                  сейчас не записано, а не к закрытию окна. Цвет тот же, что у сообщения об
                  отказе, — красный на белом.

                  Дата источника — второй Run того же элемента, а не отдельный TextBlock с
                  отступом: расстояние между словами задавал бы разметки, а текст живёт в
                  модели, и два элемента разъехались бы при первой же правке формулировки.

                  Отступ задан на самой надписи, а не на панели: в горизонтальной панели отступ
                  контейнера отодвигает панель от края колонки, а элементы внутри по-прежнему
                  стоят вплотную (ловушка 37).

                  HorizontalAlignment не задан намеренно: центрированный элемент меряется под
                  своё содержимое и колонкой не ограничивается, то есть перенос перестал бы
                  работать и дефект вернулся бы (ловушка 29). Нужен Stretch — значение по
                  умолчанию.

                  Mode=OneWay обязателен на Run.Text: привязка без сеттера у источника
                  двусторонняя по умолчанию и упала бы при создании окна — ловушка 31.
                -->
                <TextBlock Grid.Column="1"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="Firebrick"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Не сохранено" />
                    <Run Text="{Binding PulledFromDateText, Mode=OneWay}" />
                </TextBlock>

                <!--
                  Панель по центру по вертикали, а не на всю высоту строки. В горизонтальной
                  ориентации StackPanel даёт каждому ребёнку полную высоту слота, а не его
                  естественную, и вложенная кнопка с VerticalAlignment=Stretch (значение по
                  умолчанию) за ней тянется. Пока строка была высотой в одну линию, слот и
                  естественная высота совпадали и растяжения не было видно; с переносом надписи
                  на две строки кнопки справа вытянулись по высоте.

                  Кнопки внутри не трогаем: VerticalAlignment на панели уже решил задачу, и
                  повторять его на каждой кнопке значило бы дублировать решение панели.
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Padding="14,4"
                            Command="{Binding SaveAndCloseCommand}"
                            Content="Сохранить и закрыть" />

                    <Button Margin="8,0,0,0"
                            Padding="14,4"
                            Content="Отменить"
                            IsCancel="True" />
                </StackPanel>
            </Grid>

            <!--
              Отказ по вводу в полях подходов — та же всплывающая подсказка, что в главном окне:
              один контрол на оба окна, поэтому вид и срок жизни не могут разойтись.

              Нарисована поверх содержимого окна, а не в отдельном окне: второе окно WPF отнимает
              у окна наведение и курсор (ловушка 34). В потоке разметки она ничего не занимает и
              не сдвигает: подходы и кнопки остаются на своих местах. Отказов сохранения она не
              касается — они остаются красной строкой над кнопками и живут до успешного
              сохранения.

              Target задаёт окно из code-behind по Source события отказа: полей подходов много и
              они создаются по составу упражнения, имени у них в разметке нет, а вот отказавшее
              поле событие знает. Panel.ZIndex поднимает подсказку над содержимым окна: порядок
              отрисовки задаётся им среди соседей.
            -->
            <helpers:StatusHint x:Name="InputHint"
                                Panel.ZIndex="10"
                                ClosedCommand="{Binding Hint.ClearCommand}"
                                DismissCommand="{Binding Hint.DismissCommand}"
                                IsOpen="{Binding Hint.IsVisible}"
                                Text="{Binding Hint.Text}" />
        </Grid>
    </Grid>
</Window>
