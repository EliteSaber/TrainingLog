<Window x:Class="TrainingLog.Windows.AddDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:AddDayViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="760"
        Height="480"
        MinWidth="620"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Окно одно и на добавление дня, и на правку: различаются только заголовок и то, что
      модель нашла в базе за эту дату. Заголовок и «Сохранить» приходят из модели, окно их
      не задаёт.

      Кнопки упражнений — это номера по порядку выполнения, подсказка на кнопке — название.
      Активное упражнение показывается по центру, а «‹» и «›» листают упражнения плана.
      Подходы набираются рядом с ним: вес над повторениями в одном столбце, «−» слева,
      «+» справа на обе строки.
    -->
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
          Стрелки перехода между упражнениями: полоса во всю высоту, рисунок по центру.

          Рамки у кнопки нет намеренно — полоса во всю высоту в системной рамке выглядит
          тяжело. Раз системной подсветки при наведении больше нет, она описана здесь же.
          Подложка взята системным цветом Control, как подложки панелей в остальных окнах,
          поэтому в тёмной теме она останется темнее фона окна, а не станет светлым пятном.
        -->
        <ControlTemplate x:Key="ArrowButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
          Цвета шеврона. Состояния берутся у кнопки-предка: у Path нет IsEnabled, поэтому
          иначе бледная недоступная стрелка загоралась бы при наведении.

          Порядок триггеров значим: IsEnabled=False объявлен последним и потому выигрывает у
          наведения — disabled не должен реагировать на мышь.
        -->
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">
                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="False">
                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
      Ctrl+S зовёт «Сохранить», а не «Сохранить и закрыть»: горячая клавиша означает «сохранить
      то, что набрано», и ждать после неё закрытия окна не должен никто. Объявлено в разметке
      же, а не в code-behind: KeyBinding не требует обработчика, и при смене команды привязка
      меняется в одном месте.
    -->
    <Window.InputBindings>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Дата" />

            <DatePicker Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        SelectedDate="{Binding Date}" />

            <TextBlock Grid.Column="2"
                       Margin="16,0,8,0"
                       VerticalAlignment="Center"
                       Text="План" />

            <ComboBox Grid.Column="3"
                      VerticalAlignment="Center"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Plans}"
                      SelectedItem="{Binding SelectedPlan}" />
        </Grid>

        <!--
          Кнопки упражнений переносятся на вторую строку, а не уходят за окно: упражнений в плане
          сколько угодно, а StackPanel без WrapPanel меряется под всё содержимое.

          Центрирование стоит на ItemsControl, а не на родительской сетке: центрированный элемент
          меряется под своё содержимое, и колонка * его не ограничит — перенос умрёт (ловушка 29).
        -->
        <ItemsControl Grid.Row="1"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding Exercises}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                      Кнопка занимает номер по порядку выполнения, а не позицию в списке: номер и
                      состав задаёт план, и он же показан подсказкой вместе с названием.
                    -->
                    <Button Margin="0,0,6,0"
                            MinWidth="34"
                            Padding="8,4"
                            Command="{Binding DataContext.SelectExerciseCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Number}"
                            ToolTip="{Binding Name}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          Пока из базы читается прошлый день, ввод заблокирован целиком: ответ придёт в уже
          заполненные поля и затрёт набранное.

          Кнопки сохранения не блокируются: на дне, где подтягивание идёт, сохранять нечего, и их
          гасит CanAccept. Отдельное состояние кнопок разошлось бы с правилом пригодности.
        -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0"
              IsEnabled="{Binding CanFill}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <!--
              Переходы между упражнениями стоят по краям и тянутся во всю высоту области ввода.
              Активность снимает WPF сама по CanExecute, поэтому у первого упражнения «‹» бледная,
              а у последнего «›».

              Шеврон нарисован заливкой, а не обводкой: при Stretch="Uniform" толщина обводки
              масштабировалась бы вместе с рисунком, а в заливке она часть геометрии.

              Высота рисунка задана явно: без неё Uniform растянет шеврон по всей ширине полосы, и
              стрелка занимала бы колонку целиком.
            -->

            <Button Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Command="{Binding PreviousCommand}"
                    Template="{StaticResource ArrowButtonTemplate}"
                    ToolTip="Предыдущее упражнение">
                <Path Height="22"
                      Stretch="Uniform"
                      Data="M 9,2 L 3,11 L 9,20 L 6,20 L 0,11 L 6,2 Z"
                      Style="{StaticResource Chevron}" />
            </Button>

            <!--
              Отступ по бокам — чтобы «−» и «+» не прилипали к «‹» и «›»: центральная область
              стоит между навигацией, и без зазора четыре кнопки читаются как одна полоса.
            -->
                <Grid Grid.Column="1"
                      Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <!--
                      Строка примечания единственная со звёздочкой: вертикальный запас области ввода
                      уходит в неё, и по раскрытию поле тянется вместе с окном. Раньше все три строки
                      были Auto, и окно выше просто добавляло пустоту снизу — по ширине так не
                      выходит, там колонка * ограничивает содержимое, а WrapPanel переносится
                      (ловушка 29).

                      MinHeight — высота заголовка Expander с маркерами, и он не про удобство, а про
                      индикацию: на ужатом окне строка сжимается в несколько пикселей, и вместе с
                      ней исчез бы заголовок — единственный след примечания. Само поле минимальной
                      высоты не имеет.
                    -->
                    <RowDefinition Height="*" MinHeight="24" />
                </Grid.RowDefinitions>

                <!--
                  Название упражнения переносится по словам, а не обрезается: длинное название из
                  плана не должно упираться в край окна.

                  Два центрирования работают вместе: HorizontalAlignment центрирует сам элемент,
                  TextAlignment — строки внутри него.

                  Элемент центрированный, и по ловушке 29 его ширину должен бы задавать размер
                  содержимого. Здесь это безопасно: надпись лежит в строке Auto, а ограничивающая
                  колонка * стоит уровнем выше. В горизонтальном StackPanel или колонке Auto такое
                  центрирование сломало бы перенос.
                -->
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,4,0,12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Current.Name, TargetNullValue=''}" />

                <!--
                  Подходы переносятся на вторую строку, а не уходят за окно: подходов у упражнения
                  сколько угодно, а окно не умеет прокручиваться.

                  Ключ к переносу — колонка шириной *, и именно поэтому у Grid не может стоять
                  HorizontalAlignment="Center": центрированный элемент меряется под своё содержимое,
                  и колонка его не ограничит. Центрирование перенесено на ItemsControl — он уже
                  внутри ограниченной колонки.
                -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                      «−» и «+» нарисованы той же техникой, что и стрелки перехода между
                      упражнениями: тот же прозрачный шаблон кнопки и тот же стиль цвета,
                      поэтому гаснут и загораются одинаково.

                      Рисунок задан квадратом 22×22 и масштабируется 1:1. Это не избыточность:
                      у плюса и минуса, в отличие от шеврона, фигура широкая и низкая, и при
                      одном лишь Stretch="Uniform" с высотой штрих раздулся бы втрое. Заливка
                      вместо обводки — по той же причине, что и у шевронов: толщина обводки
                      масштабировалась бы вместе с рисунком.
                    -->
                    <Button Grid.Column="0"
                            Grid.RowSpan="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding RemoveSetCommand}"
                            Template="{StaticResource ArrowButtonTemplate}"
                            ToolTip="Убрать подход">
                        <Path Width="22"
                              Height="22"
                              Stretch="Uniform"
                              Data="M 2,9.5 L 20,9.5 L 20,12.5 L 2,12.5 Z"
                              Style="{StaticResource Chevron}" />
                    </Button>

                    <!--
                      Подход — это один столбец из двух полей: вес над повторениями. Ширина
                      у всех столбцов одна и та же, поэтому вес стоит ровно над своим
                      повторением, а столбцы совпадают между упражнениями. Переносится столбец
                      целиком, а не поля по отдельности.
                    -->
                    <ItemsControl Grid.Column="1"
                                  Grid.RowSpan="2"
                                  HorizontalAlignment="Center"
                                  ItemsSource="{Binding Current.Sets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!--
                              Нижний отступ разводит перенесённые строки: WrapPanel складывает
                              их вплотную и зазора между строками не создаёт. Отступ задан
                              столбцу подхода, а не панели: иначе разъедутся поля внутри
                              подхода, а не сами подходы.
                            -->
                            <DataTemplate>
                                <Grid Margin="0,0,8,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                      Поле веса — с чуть более тёмным системным фоном, чтобы отличаться
                                      от повторений под ним: подсказки не видно, пока в поле не наведёшь
                                      мышь. Оттенок системный, поэтому в тёмной теме он остаётся темнее
                                      фона окна, а не становится светлым пятном.

                                      AllowedCharsInput отбрасывает всё, кроме цифр и разделителей, — и
                                      при наборе, и при вставке. Разбор в модели остаётся: «5,5.5»
                                      фильтр пропустит, а TryParse отвергнет.

                                      Part задаёт Tab-переход: поля идут по единой цепочке
                                      «все веса, затем все повторения», а не по порядку дерева.
                                    -->
                                    <TextBox Grid.Row="0"
                                             Width="84"
                                             Padding="4,3"
                                             HorizontalContentAlignment="Center"
                                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                             helpers:AllowedCharsInput.Allowed="DigitsWithSeparators"
                                             helpers:SetFieldNavigation.Part="Weight"
                                             ToolTip="Вес, кг"
                                             Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--
                                      Поле повторений — целое неотрицательное число, поэтому
                                      разделителей здесь нет: только цифры. По Tab поле идёт по той же
                                      единой цепочке, что и вес: сначала все веса, затем все повторения.

                                      Плейсхолдер рисуется ПОВЕРХ поля: фон у TextBox непрозрачный, и
                                      подложка под ним была бы не видна, поэтому блок объявлен после
                                      TextBox — в Grid рисуется последним. IsHitTestVisible=False
                                      обязателен: иначе надпись перехватывала бы нажатия и в поле
                                      нельзя было бы ни поставить каретку, ни вставить из буфера.
                                    -->
                                    <Grid Grid.Row="1"
                                          Width="84"
                                          Height="27"
                                          Margin="0,4,0,0">
                                        <TextBox Padding="4,3"
                                                 HorizontalContentAlignment="Center"
                                                 helpers:AllowedCharsInput.Allowed="Digits"
                                                 helpers:SetFieldNavigation.Part="Repetitions"
                                                 ToolTip="Повторения"
                                                 Text="{Binding RepetitionText, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                   Text="{Binding RepetitionPlaceholder}"
                                                   Visibility="{Binding HasRepetitionPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="2"
                            Grid.RowSpan="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding AddSetCommand}"
                            Template="{StaticResource ArrowButtonTemplate}"
                            ToolTip="Добавить подход">
                        <Path Width="22"
                              Height="22"
                              Stretch="Uniform"
                              Data="M 9.5,2 L 12.5,2 L 12.5,20 L 9.5,20 Z M 2,9.5 L 20,9.5 L 20,12.5 L 2,12.5 Z"
                              Style="{StaticResource Chevron}" />
                    </Button>
                </Grid>

                <!--
                  Примечание принадлежит упражнению, а не подходу, поэтому поле стоит третьей
                  строкой под подходами и привязано к текущему упражнению, а не к подходу.
                  Скрыто по умолчанию: примечаний у упражнения обычно нет, и постоянно
                  висящее поле съедало бы высоту области ввода у каждого упражнения.

                  А до выбора плана скрыто вовсе: упражнений ещё нет, а показывать поле
                  примечания там, где некому его заполнить, незачем. Показ привязан к
                  HasCurrent, а не к Current: путь через Current не разрешается, пока Current
                  равен null, и привязка отдаёт значение по умолчанию целевого свойства — а у
                  Visibility это Visible (ловушка 43).

                  Состояние раскрытия живёт в строке упражнения, поэтому у каждого упражнения
                  оно своё и переключение «‹» и «›» не закрывает то, что открыто у соседнего.
                  Mode=TwoWay задан явно: у Expander.IsExpanded он и так двусторонний по
                  умолчанию, а полагаться на это молча — ровно тот случай, что разбирает
                  ловушка 31.
                -->
                <Expander Grid.Row="2"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Stretch"
                          IsExpanded="{Binding Current.IsNotesExpanded, Mode=TwoWay}"
                          Visibility="{Binding HasCurrent,
                                               Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <!--
                          В шапке Expander нет ни одной кнопки: шапка — сам ToggleButton, и кнопка
                          внутри неё дёргала бы ещё и раскрытие (ловушка 15). Отступ задан на самих
                          надписях, а не на панели: в горизонтальной панели отступ контейнера
                          отодвигает панель, а элементы внутри стоят вплотную (ловушка 37).

                          Маркеров два, и это не украшение: примечание, введённое в это упражнение,
                          и подсказка из прошлого дня — разные вещи, а в свёрнутом виде у них нет
                          других следов. Подсказка бледная, введённое примечание — обычным цветом
                          текста. У самого поля подсказки (ToolTip) нет: большой ToolTip над полем
                          закрывал бы его собой; у маркера она есть, потому что пустой кружок сам
                          по себе ничего не значит.

                          Видимость маркеров задана DataTrigger, а не конвертером: путь идёт через
                          Current, который до выбора плана равен null, а ломаная привязка с
                          конвертером отдаёт Visible (ловушка 43).
                        -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Примечание" />

                            <TextBlock Margin="6,0,0,0" Text="•">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.HasNote}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--
                              Маркер живёт в рамке, а не в самом TextBlock: у TextBlock содержимое
                              объявлено как Inlines, поэтому свойство-элемент предка (ToolTip) попадает
                              в ту коллекцию и роняет окно при создании (ловушка 44).

                              Прозрачная подложка у рамки обязательна: без неё пустая рамка мышь не ловит
                              (ловушка 42). Видимость задана рамке, а не блоку: иначе прозрачная рамка
                              продолжала бы ловить мышь при скрытом маркере. Предел ширины
                              обязателен: без него длинная строка уехала бы за край экрана.

                              Это второе окно, а такие отнимают у окна наведение (ловушка 34) — но на
                              маркере это было и до правки, блок лишь стал крупнее.
                            -->
                            <Border Margin="6,0,0,0" Background="Transparent">
                                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="○" />

                                <Border.ToolTip>
                                    <StackPanel MaxWidth="320">
                                        <TextBlock Margin="0,0,0,4"
                                                   FontWeight="SemiBold"
                                                   Text="Примечание прошлого дня" />

                                        <TextBlock MaxHeight="240"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Current.NotePlaceholder,
                                                                  TargetNullValue=''}" />
                                    </StackPanel>
                                </Border.ToolTip>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.HasNotePlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </Expander.Header>

                    <!--
                      Поле многострочное, и высоту ему задаёт строка *, а не содержимое: MaxHeight
                      здесь не просто не нужен, он вреден — предел отменяет растяжение (ловушка 12).
                      Границу даёт строка *, переполнение ловит VerticalScrollBarVisibility="Auto".
                      AcceptsReturn=True перехватывает Enter раньше кнопки IsDefault, поэтому Enter
                      вставляет строку, а не сохраняет день.

                      Растягивается поле само, без VerticalAlignment: Expander по умолчанию Stretch,
                      его ContentPresenter отдаёт остаток обоим вложенным уровням.

                      Ширину задаёт колонка *. HorizontalAlignment не задан намеренно: центрированный
                      элемент меряется под своё содержимое, и перенос перестал бы работать
                      (ловушка 29).

                      Плейсхолдер — тот же приём, что у повторений: объявлен после TextBox (в Grid
                      рисуется последним, а подложка под непрозрачным полем была бы не видна) и с
                      IsHitTestVisible=False, иначе надпись перехватывала бы нажатия и в поле нельзя
                      было бы ни поставить каретку, ни вставить из буфера (ловушка 36).

                      Обрезка двумя средствами обязательна: MaxHeight ограничивает только разметку, а
                      TextBlock текст за своим слотом всё равно рисует. Клип стоит на сетке, а не на
                      блоке: слот блока равен его MaxHeight, и на низком поле текст ушёл бы мимо.

                      Многоточия в многострочном режиме в WPF нет: MaxLines у TextBlock не существует,
                      а TextTrimming работает только при TextWrapping="NoWrap". Поэтому подсказка
                      обрывается по месту, а полный текст отдаёт подсказкой у маркера «○».

                      Видимость — тоже DataTrigger, а не конвертер: путь через Current при невыбранном
                      упражнении ломается и оставляет Visible (ловушка 43).
                    -->
                    <Grid ClipToBounds="True" Margin="0,6,0,0">
                        <TextBox AcceptsReturn="True"
                                 Padding="4,3"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Current.NoteText,
                                                TargetNullValue='',
                                                UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="5,4,0,0"
                                   MaxHeight="66"
                                   VerticalAlignment="Top"
                                   ClipToBounds="True"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Current.NotePlaceholder, TargetNullValue=''}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Current.HasNotePlaceholder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Expander>
            </Grid>

            <Button Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Command="{Binding NextCommand}"
                    Template="{StaticResource ArrowButtonTemplate}"
                    ToolTip="Следующее упражнение">
                <Path Height="22"
                      Stretch="Uniform"
                      Data="M 0,2 L 6,11 L 0,20 L 3,20 L 9,11 L 3,2 Z"
                      Style="{StaticResource Chevron}" />
            </Button>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

<!--
              Отказ бывает по двум причинам: день не сохранился либо в поле ввели недопустимое.
              Второе приходит сюда событием AllowedCharsInput.Rejected из code-behind: правило
              одно на все поля, и объяснение отказа не изобретается у каждого окна отдельно.

              Отказ и индикатор стоят в сетке, а не в горизонтальной панели: панель отдаёт
              содержимому бесконечную ширину, и перенос строк у отказа перестал бы работать
              (ловушка 29). Колонка * даёт отказу ширину, Auto — индикатору ровно его.
            -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           TextWrapping="Wrap"
                           Foreground="Firebrick"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="{Binding Status}" />

                <!--
                  Индикатор чтения из базы — рядом с отказом, а не поверх области ввода.
                  Оба сообщения одного рода и место у них одно: если повесить надпись поверх
                  полей, она погасла бы вместе с ними, потому что отключается IsEnabled того
                  же контейнера, и выглядела бы частью заблокированного содержимого, а не
                  сообщением. Кроме того, на заблокированной области она лежала бы на
                  бледном фоне рядом с бледными полями.

                  Привязан CanFill, а не !IsLoading: разметка не должна повторять вычисления
                  модели.
                -->
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="Загрузка…"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!--
              «Сохранить» слева, остальные две справа: частое действие — у левой руки, а кнопка
              закрытия рядом с отменой читается как «всё равно уходит». IsDefault у «Сохранить»
              единственный в окне: иначе Enter звал бы обе.
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  Кнопка в колонке Auto, а надпись — в колонке * между ней и правыми кнопками.
                  Пока надпись стояла в одной колонке Auto с кнопкой, дефект был отложенным, а не
                  настоящим: Auto-колонка не сжимается никогда, а колонка-распорка между двумя
                  Auto спасает ровно до тех пор, пока запаса хватает. С датой источника надпись
                  стала втрое длиннее — и на узком окне «Отменить» уходила за край (ловушка 38).
                -->
                <Button Grid.Column="0"
                        Padding="14,4"
                        VerticalAlignment="Center"
                        Command="{Binding SaveCommand}"
                        Content="Сохранить"
                        IsDefault="True" />

                <!--
                  Надпись стоит у «Сохранить», а не у кнопок закрытия: она относится к тому, что не
                  записано. Цвет тот же, что у сообщения об отказе.

                  Дата источника — второй Run того же элемента: расстояние между словами задавал бы
                  разметка, а текст живёт в модели, и два элемента разъехались бы при правке
                  формулировки.

                  Отступ задан на самой надписи, а не на панели: в горизонтальной панели отступ
                  контейнера отодвигает панель, а элементы внутри стоят вплотную (ловушка 37).
                  HorizontalAlignment не задан намеренно: центрированный элемент не переносится
                  (ловушка 29), нужен Stretch.

                  Mode=OneWay обязателен на Run.Text: привязка без сеттера у источника двусторонняя
                  по умолчанию и упала бы при создании окна (ловушка 31).
                -->
                <TextBlock Grid.Column="1"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="Firebrick"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Не сохранено" />
                    <Run Text="{Binding PulledFromDateText, Mode=OneWay}" />
                </TextBlock>

                <!--
                  Панель по центру по вертикали, а не на всю высоту строки. В горизонтальной
                  ориентации StackPanel даёт каждому ребёнку полную высоту слота, а не его
                  естественную, и вложенная кнопка с VerticalAlignment=Stretch (значение по
                  умолчанию) за ней тянется. Пока строка была высотой в одну линию, слот и
                  естественная высота совпадали и растяжения не было видно; с переносом надписи
                  на две строки кнопки справа вытянулись по высоте.

                  Кнопки внутри не трогаем: VerticalAlignment на панели уже решил задачу, и
                  повторять его на каждой кнопке значило бы дублировать решение панели.
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Padding="14,4"
                            Command="{Binding SaveAndCloseCommand}"
                            Content="Сохранить и закрыть" />

                    <Button Margin="8,0,0,0"
                            Padding="14,4"
                            Content="Отменить"
                            IsCancel="True" />
                </StackPanel>
            </Grid>

            <!--
              Отказ по вводу в полях подходов — та же всплывающая подсказка, что в главном окне:
              один контрол на оба окна, поэтому вид и срок жизни не могут разойтись.

              Нарисована поверх содержимого окна, а не в отдельном окне: второе окно WPF отнимает
              у окна наведение и курсор (ловушка 34). В потоке разметки она ничего не занимает и
              не сдвигает: подходы и кнопки остаются на своих местах. Отказов сохранения она не
              касается — они остаются красной строкой над кнопками и живут до успешного
              сохранения.

              Target задаёт окно из code-behind по Source события отказа: полей подходов много и
              они создаются по составу упражнения, имени у них в разметке нет, а вот отказавшее
              поле событие знает. Panel.ZIndex поднимает подсказку над содержимым окна: порядок
              отрисовки задаётся им среди соседей.
            -->
            <helpers:StatusHint x:Name="InputHint"
                                Panel.ZIndex="10"
                                ClosedCommand="{Binding Hint.ClearCommand}"
                                DismissCommand="{Binding Hint.DismissCommand}"
                                IsOpen="{Binding Hint.IsVisible}"
                                Text="{Binding Hint.Text}" />
        </Grid>
    </Grid>
</Window>
