<Window x:Class="TrainingLog.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="Параметры"
        Width="420"
        SizeToContent="Height"
        MinWidth="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      Поле устроено и настроено как на главном окне: та же ширина, те же отступы и
      центрирование, тот же фильтр цифр. Одно и то же число в двух окнах иначе читалось бы как
      два разных счётчика.
    -->
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Подпись и поле в одну строку, две Auto-колонки. Не горизонтальная панель: она меряет
          содержимое бесконечной шириной, и перенос у подписи перестал бы работать (ловушка 29).
          Не колонка `*` под подпись при Auto под поле: `*` заберёт весь остаток и уведёт поле к
          правому краю, оставив дыру между подписью и полем.

          MinWidth у поля — пол колонки, ниже которого она не сжимается: нехватку ширины забирает
          подпись и переносится по словам, а поле остаётся прежним. Без него нехватка делилась бы
          между ними поровну (ловушка 38) и поле обрезало бы цифру.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              Background="Transparent" обязателен: с null-фоном подпись ловит клик только по
              буквам, и клик по пробелу не передал бы фокус (ловушка 13). HorizontalAlignment не
              задан намеренно — центрированный элемент не переносится (ловушка 29).
            -->
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Background="Transparent"
                       TextWrapping="Wrap"
                       Text="Количество отображаемых дней"
                       helpers:ClickToFocus.Target="{Binding ElementName=DaysCountBox}" />

            <TextBox x:Name="DaysCountBox"
                     Grid.Column="1"
                     Width="52"
                     MinWidth="52"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Padding="4,3"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     helpers:AllowedCharsInput.Allowed="Digits"
                     Text="{Binding DaysCount, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--
          Две строки адреса базы. Кнопка у директории открывает выбор папки, у наименования —
          выбор файла *.db: одного диалога «и папка, и файл» в стандартных окнах нет, а файл заодно
          подставляет директорию целиком — оба поля остаются согласованы.
          Обработчики живут в code-behind: диалоги — работа интерфейса, модели представления им не место.

          Средняя колонка `*`: путь длиннее подписи и кнопки, нехватку ширины забирает поле.
        -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Background="Transparent"
                       TextWrapping="Wrap"
                       Text="Директория БД"
                       helpers:ClickToFocus.Target="{Binding ElementName=DirectoryBox}" />

            <TextBox x:Name="DirectoryBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Padding="4,3"
                     helpers:OverflowTip.Enabled="True"
                     Text="{Binding DatabaseDirectory, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Content="Обзор…"
                    Click="OnPickDirectory" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Background="Transparent"
                       TextWrapping="Wrap"
                       Text="Наименование БД"
                       helpers:ClickToFocus.Target="{Binding ElementName=NameBox}" />

            <TextBox x:Name="NameBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Padding="4,3"
                     helpers:OverflowTip.Enabled="True"
                     Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Content="Выбрать файл…"
                    Click="OnPickDatabaseFile" />
        </Grid>

        <!--
          Отказ записи — красной строкой до успеха, а не подсказкой: подсказка живёт пять секунд,
          а настройка не записана. Строка в сетке, а не в панели: панель отдаёт бесконечную
          ширину, и перенос перестал бы работать (ловушка 29).
        -->
        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="Firebrick"
                   Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Text="{Binding Status}" />

        <!--
          IsDefault один в окне: иначе Enter звал бы обе кнопки.
        -->
        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Padding="14,4"
                    Command="{Binding SaveCommand}"
                    Content="Сохранить"
                    IsDefault="True" />

            <Button Margin="8,0,0,0"
                    Padding="14,4"
                    Content="Отменить"
                    IsCancel="True" />
        </StackPanel>

        <!--
          Та же подсказка, что в главном окне и в окне дня, — один контрол на три окна, иначе вид
          и срок разошлись бы. Рисуется элементом поверх содержимого, а не окном Popup: второе
          окно отнимает у окна наведение и курсор (ловушка 34). Target задаёт code-behind: привязку
          на свойстве, которым пишет окно, ставить нельзя — она заменяется локальным значением
          навсегда (ловушка 11).
        -->
        <helpers:StatusHint x:Name="InputHint"
                            Panel.ZIndex="10"
                            ClosedCommand="{Binding Hint.ClearCommand}"
                            DismissCommand="{Binding Hint.DismissCommand}"
                            IsOpen="{Binding Hint.IsVisible}"
                            Text="{Binding Hint.Text}" />
    </Grid>
</Window>
