<Window x:Class="TrainingLog.Windows.EditExerciseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:core="clr-namespace:TrainingLog.Core;assembly=TrainingLog.Core"
        d:DataContext="{d:DesignInstance Type=vm:EditExerciseViewModel}"
        mc:Ignorable="d"
        Title="Редактирование упражнения"
        Width="380"
        SizeToContent="Height"
        MinWidth="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Стеклянные кнопки — ловушка 6: ресурсы окна живут в окне -->
                <ResourceDictionary Source="pack://application:,,,/Themes/GlassButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Background="Transparent" обязателен: с null-фоном подпись ловит клик только по буквам (ловушка 13). -->
        <TextBlock Grid.Row="0"
                   Background="Transparent"
                   Text="Название упражнения"
                   helpers:ClickToFocus.Target="{Binding ElementName=NameBox}" />

        <!--
          AcceptsReturn="False" оставляет Enter подтверждением, а переводы строк при вставке
          WPF вычищает сам. MaxHeight обязателен рядом с Wrap: у переноса по умолчанию
          VerticalScrollBarVisibility="Hidden", и без предела поле растёт бесконечно.
        -->
        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 AcceptsReturn="False"
                 MaxHeight="96"
                 MaxLength="{x:Static core:NameRules.MaxNameLength}"
                 Padding="4,3"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource GlassButtonSoft}"
                    Command="{Binding AcceptCommand}"
                    helpers:Hotkey.Id="EditExercise.Accept"
                    Content="Принять"
                    IsDefault="True" />

            <Button Margin="4,0,0,0"
                    Style="{StaticResource GlassButtonSoft}"
                    Content="Отменить"
                    helpers:Hotkey.Id="EditExercise.Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
