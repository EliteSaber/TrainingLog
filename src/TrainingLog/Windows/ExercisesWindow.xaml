<Window x:Class="TrainingLog.Windows.ExercisesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:core="clr-namespace:TrainingLog.Core;assembly=TrainingLog.Core"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:ExercisesViewModel}"
        mc:Ignorable="d"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource BodySize}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        Style="{DynamicResource AppWindowStyle}"
        Title="Упражнения"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Стили темы — ловушка 6: ресурсы окна живут в окне. Палитра и токены шрифта живут на уровне приложения: своими оконными экземплярами они перекрыли бы подмену. -->
                <ResourceDictionary Source="pack://application:,,,/TrainingLog;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Ресурсы объявлены в окне, а не в App.xaml: окно должно создаваться без приложения (ловушка 6). -->
            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Свой экземпляр по той же причине: у конвертера состояния нет. -->
            <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Полоса заголовка: отрицательные отступы снимают отступ корневой сетки — полоса от краёв окна. -->
        <helpers:TitleBar Grid.Row="0"
                          Margin="-12,-12,-12,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              Кнопки-иконки слева от поля: импорт и экспорт — действия над справочником целиком, а
              не над одной строкой. Панель горизонтальная, чтобы вторая кнопка добавилась рядом
              первой и не трогала колонки.

              Иконки штрихом, а не заливкой, как шестерёнка: готовых значков в проекте нет, а
              геометрия из трёх линий — это стрелка в подставку и стрелка из неё.

              Высоты в ряду нет ни у кого: высоту задаёт «Добавить», остальные растягиваются под
              неё, поэтому панель VerticalAlignment не задаёт. Горизонтальная панель отдаёт детям
              всю высоту слота, и кнопки становятся ровно такими же, как поле и «Добавить»
              (ловушка 50).

              Отступ по вертикали меньше, чем по горизонтали — намеренно: у растянутой кнопки он
              в высоту не идёт, но задаёт её желаемый размер, и он должен остаться ниже высоты
              ряда. С отступом 8 кнопка-иконка стала бы выше «Добавить» и подняла весь ряд.

              Экспорт без привязки команды: путь выбирает диалог в окне, и команда выполнилась бы
              с пустым параметром. Серое состояние — IsEnabled, как у «Сохранить» в окне импорта.
            -->
            <StackPanel Grid.Column="0"
                        Grid.Row="1"
                        Margin="0,0,8,0"
                        Orientation="Horizontal">
                <Button Style="{StaticResource GlassButtonIconSoft}"
                        Command="{Binding ImportCommand}"
                        helpers:Hotkey.Id="Exercises.Import"
                        ToolTip="Импорт упражнений из файла">
                    <Button.Content>
                        <Path Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 12,3 L 12,12 M 8,8 L 12,12 L 16,8 M 4,15 L 4,20 L 20,20 L 20,15" />
                    </Button.Content>
                </Button>

                <!--
                  Отрицательный margin сжимает воздух из резервов шаблона 6+6 до 8, тела
                  кнопок не соприкасаются — механика в ловушке 47.
                -->
                <Button Margin="-4,0,0,0"
                        Style="{StaticResource GlassButtonIconSoft}"
                        Click="OnExportClick"
                        IsEnabled="{Binding CanExport}"
                        helpers:Hotkey.Id="Exercises.Export"
                        ToolTip="Выгрузить упражнения в файл">
                    <Button.Content>
                        <Path Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 12,12 L 12,3 M 8,7 L 12,3 L 16,7 M 4,15 L 4,20 L 20,20 L 20,15" />
                    </Button.Content>
                </Button>
            </StackPanel>

            <!--
              MaxHeight ниже, чем в окне правки: поле стоит над списком и не должно сильно сдвигать его при вводе.

              VerticalAlignment не задан, как и у соседей по ряду: высоту ряда задаёт «Добавить», а
              поле растягивается под неё. С VerticalAlignment поле стало бы своей высоты и
              разошлось с кнопками на пару пикселей (ловушка 50).
            -->
            <TextBox Grid.Column="1"
                     AcceptsReturn="False"
                     MaxHeight="60"
                     MaxLength="{x:Static core:NameRules.MaxNameLength}"
                     Padding="4,3"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource GlassButtonSoft}"
                    Command="{Binding AddCommand}"
                    helpers:Hotkey.Id="Exercises.Add"
                    Content="Добавить" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Background="Transparent" обязателен: с null-фоном подпись ловит клик только по буквам (ловушка 13). -->
            <TextBlock Grid.Column="0"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       Text="Поиск"
                       helpers:ClickToFocus.Target="{Binding ElementName=FilterBox}" />

            <TextBox x:Name="FilterBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Padding="4,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,4"
                Padding="4,5"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="1">
            <Button HorizontalAlignment="Left"
                    Style="{StaticResource GlassButtonIconSoft}"
                    Command="{Binding ToggleSortCommand}"
                    helpers:Hotkey.Id="Exercises.ToggleSort"
                    ToolTip="Изменить направление сортировки">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название" />
                    <!--
                      Треугольник Path'ом, а не символом ▲/▼: рендер символа идёт по метрикам
                      шрифта, и стрелка читалась выше центра строки. Выравнивание Center в той же
                      строке ставит её точно в центр наименования. Цвет буквами не задаётся:
                      тон кнопки меняется состояниями, и Fill обязан ездить за её Foreground.
                    -->
                    <Path Margin="2,0,0,0"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          Data="M 0,0 L 9,0 L 4.5,6 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDescending}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </StackPanel>
            </Button>
        </Border>

        <!--
          Область списка снимает с себя отступ корневой сетки по бокам: полоса прокрутки живёт
          внутри ScrollViewer, и прижать её к краю окна иначе нечем.
        -->
        <Grid Grid.Row="4"
              Margin="-12,0,-12,0">
            <ScrollViewer helpers:ScrollBarGutter.Left="2"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExerciseList"
                              ItemsSource="{Binding Visible}"
                              helpers:RowSelection.Enabled="True">
                    <ItemsControl.ItemContainerStyle>
                        <!--
                          Отступ живёт на контейнере, а не на содержимом скролла: ScrollBarGutter
                          владеет правым отступом содержимого и затирал бы на нём привязку.
                        -->
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin"
                                    Value="{Binding ComputedVerticalScrollBarVisibility,
                                            RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                            Converter={StaticResource ScrollBarMargin},
                                            ConverterParameter=12}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Границу рисует контейнер строки, а не шаблон данных: иначе она привязана к содержимому, а не к строке. -->
                            <Border Margin="0,0,0,0"
                                    Padding="0,4"
                                    BorderBrush="{DynamicResource LineSoft}"
                                    BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Прозрачный фон ловит мышь по всей строке: без него клик проходит насквозь там, где ничего не нарисовано, и строка выделяется только по буквам (ловушка 13). -->
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(helpers:RowSelection.IsSelected), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHighlight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="4,0,8,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding Name}" />

                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GlassButtonIconSoft}"
                                            Command="{Binding DataContext.EditCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Редактировать" />

                                    <Button Grid.Column="2"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GlassButtonIconSoft}"
                                            Click="OnDeleteClick"
                                            CommandParameter="{Binding}"
                                            Content="Удалить" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       IsHitTestVisible="False"
                       Text="Справочник пуст"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Рамка окна: элемент-обводка поверх содержимого, до самых краёв окна (как на главном). -->
        <Border Grid.RowSpan="5"
                Margin="-12,-12,-12,-12"
                IsHitTestVisible="False"
                Style="{StaticResource WindowFrame}" />
    </Grid>
</Window>
