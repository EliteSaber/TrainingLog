<Window x:Class="TrainingLog.Windows.ExercisesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:core="clr-namespace:TrainingLog.Core;assembly=TrainingLog.Core"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:ExercisesViewModel}"
        mc:Ignorable="d"
        Title="Упражнения"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--
          Конвертер объявлен в окне, а не в App.xaml: так окно самодостаточно и создаётся
          без приложения. Общий словарь приложения недоступен, если окно открывают из теста
          или из другого хоста.
        -->
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              Как и в окне правки: перенос по словам вместо горизонтальной прокрутки.
              MaxHeight здесь ниже, чем в окне правки, — поле стоит над списком и не должно
              сильно сдвигать его при вводе.
            -->
            <TextBox Grid.Column="0"
                     AcceptsReturn="False"
                     MaxHeight="60"
                     MaxLength="{x:Static core:NameRules.MaxNameLength}"
                     Padding="4,3"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,4"
                    VerticalAlignment="Center"
                    Command="{Binding AddCommand}"
                    Content="Добавить" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              Подпись ведёт себя как подпись: клик по слову ставит фокус в поле. У ClickToFocus
              своё свойство с целью, потому что передачу фокуса по клику в WPF не делает никто,
              а Background="Transparent" нужен для попадания кликом: с null-фоном подпись
              ловит клик только по самим буквам.
            -->
            <TextBlock Grid.Column="0"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       Text="Поиск"
                       helpers:ClickToFocus.Target="{Binding ElementName=FilterBox}" />

            <TextBox x:Name="FilterBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Padding="4,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,4"
                Padding="4,5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
            <Button HorizontalAlignment="Left"
                    Padding="2,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ToggleSortCommand}"
                    ToolTip="Изменить направление сортировки">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название" />
                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding SortIndicator}" />
                </StackPanel>
            </Button>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer helpers:ScrollBarGutter.Left="2"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Границу рисует контейнер строки, а не шаблон данных: иначе она
                              привязана к содержимому, а не к строке. Линия идёт вплотную под
                              названием, отступ перед следующей строкой даёт Padding="0,4".
                            -->
                            <Border Margin="0,0,0,0"
                                    Padding="0,4"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="4,0,8,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding Name}" />

                                    <Button Grid.Column="1"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.EditCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Редактировать" />

                                    <Button Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Click="OnDeleteClick"
                                            CommandParameter="{Binding}"
                                            Content="Удалить" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Справочник пуст"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
