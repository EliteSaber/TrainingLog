<Window x:Class="TrainingLog.Windows.EditPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:core="clr-namespace:TrainingLog.Core;assembly=TrainingLog.Core"
        d:DataContext="{d:DesignInstance Type=vm:EditPlanViewModel}"
        mc:Ignorable="d"
        Title="План тренировки"
        Width="620"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Свой экземпляр: ресурсы окна живут в окне, общий словарь ему недоступен (ловушка 6). -->
        <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />

        <!--
          Иконка-кнопка рядом с полем ввода: полоса во всю высоту, глиф по центру, рамки нет
          намеренно — системная кнопка в этой строке стояла бы тяжелее соседнего списка и
          выглядела бы отдельным элементом управления. Раз системной подсветки при наведении
          больше нет, она описана здесь же.

          Подложка взята системным цветом, как подложки панелей в остальных окнах, поэтому
          в тёмной теме приведение останется темнее фона окна, а не станет светлым пятном.

          Padding привязан: без этого отступ на кнопке шаблон не читал бы вовсе, а нажимать
          пришлось бы по одному глифу.

          Порядок триггеров значим: IsEnabled=False объявлен последним и потому выигрывает —
          погашенная кнопка не должна отвечать на мышь.
        -->
        <ControlTemplate x:Key="IconButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="Transparent" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <!--
      Окно общее для добавления и правки: различаются только заголовок и подпись кнопки, которые
      задаёт модель представления. Высота фиксированная, списки прокручиваются: упражнений в
      справочнике сколько угодно, и растущее на них окно правки ехало бы за край экрана.

      Две колонки. Слева весь справочник по алфавиту с чекбоксами — это место для поиска. Справа
      упражнения плана в порядке выполнения с номерами и кнопками перестановки: отмечать и
      упорядочивать в одном списке нельзя, потому что алфавитный порядок и порядок выполнения
      противоречат друг другу, а ломать алфавитный поиск нельзя.
    -->
    <!-- Верхний отступ вдвое меньше бокового и нижнего и совпадает с зазором под подписью. -->
    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Background="Transparent"
                   Text="Наименование"
                   helpers:ClickToFocus.Target="{Binding ElementName=NameBox}" />

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 AcceptsReturn="False"
                 MaxHeight="96"
                 MaxLength="{x:Static core:NameRules.MaxNameLength}"
                 Padding="4,3"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <!--
          «На основе» относится к составу, а не к поиску, и стоит рядом с отбором упражнений.
          Списка источника отдельно нет — это те же планы, что и для проверки дубля, минус
          редактируемый.

          Между двумя группами разделитель: чекбокс отбирает состав, а «на основе» его
          заполняет, и без границы это читалось бы как одна длинная надпись.
        -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      VerticalAlignment="Center"
                      Content="Выбрать все"
                      IsThreeState="True"
                      IsChecked="{Binding IsAllChecked, Mode=TwoWay}" />

            <!--
              Высота не задаётся: растяжка берёт высоту строки, а она определяется самым высоким
              элементом — списком. Свое число здесь означало бы разъезд с системной темой.

              Ширина в 1 px обязана быть прижата к пикселю: начавшись на дробном, элемент такой
              ширины рисуется через два пикселя полупрозрачностью и выглядит толще и размыто.
              У линий между строками списков такой нужды нет — там толщина задаётся BorderThickness,
              и разметчик прижимает её сам.

              Цвет тот же, что у рамок панелей под строкой: разделитель читается как их
              продолжение и остаётся тёмным в тёмной теме.

              Поля у разделителя свои, и симметричные: у каждой стороны промежутка свой носитель —
              слева поле разделителя, справа поле подписи. Поля на одном элементе разделитель
              посередине не центрируют, а сдвигают в его сторону: без них он стоял бы вплотную к
              «Выбрать все».
            -->
            <Border Grid.Column="1"
                    Width="1"
                    Margin="9,0,9,0"
                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    SnapsToDevicePixels="True" />

            <!--
              Левое поле у подписи убрано: его несёт разделитель, иначе зазор справа от линии
              был бы 18 px против 9 слева.

              Асимметрия в «План» окна дня (16 и 8) вынужденная: у DatePicker свой внутренний
              правый отступ. Здесь такого поля нет — у CheckBox отступ справа нулевой, а рамка
              ComboBox начинается ровно на краю элемента, — поэтому равные поля и означают равные
              видимые зазоры.
            -->
            <TextBlock Grid.Column="2"
                       Margin="0,0,9,0"
                       VerticalAlignment="Center"
                       Text="На основе" />

            <ComboBox x:Name="BasePlanBox"
                      Grid.Column="3"
                      VerticalAlignment="Center"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding BasePlans}"
                      SelectedItem="{Binding BasePlan}" />

            <!--
              Высота берётся у списка привязкой, а не числом в разметке: высота ComboBox приходит
              из системной темы и меняется от DPI и масштаба шрифта, и своё число здесь разъехалось
              бы на другой машине — ровно как разъехался бы предел MaxLength, взятый не из правила.
            -->
            <Button Grid.Column="4"
                    Margin="6,0,0,0"
                    Padding="6,0"
                    Height="{Binding ActualHeight, ElementName=BasePlanBox}"
                    VerticalAlignment="Center"
                    Command="{Binding ResetBaseCommand}"
                    Content="✕"
                    Template="{StaticResource IconButtonTemplate}"
                    ToolTip="Сбросить" />
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="4,5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="4,0,0,6"
                               FontWeight="SemiBold"
                               Text="Все упражнения" />

                    <!--
                      Отрицательный отступ съедает Padding="4,5" вместе с рамкой в 1 px: иначе
                      полоса выходит за пределы рамки, а это читается как оборванная полоса.
                      Правая рамка вложена в левую, поэтому её полоса на 4 px дальше от внешней —
                      выровнять можно было бы только выведя её за линию рамки, и этого не сделано.
                    -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,-5,0"
                                  helpers:ScrollBarGutter.Left="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllExercises}">
                            <ItemsControl.ItemContainerStyle>
                                <!-- Отступ на контейнере, а не на содержимом скролла: ScrollBarGutter владеет правым отступом содержимого и затирал бы на нём привязку. -->
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin"
                                            Value="{Binding ComputedVerticalScrollBarVisibility,
                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                    Converter={StaticResource ScrollBarMargin},
                                                    ConverterParameter=5}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Границу рисует контейнер строки, а не шаблон данных: иначе она привязана к содержимому, а не к строке. -->
                                    <Border Padding="0,4"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Name}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               IsHitTestVisible="False"
                               Text="Справочник упражнений пуст">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!-- Плейсхолдер без конвертера: конвертера «коллекция пуста» в проекте нет, и ради одного случая заводить новый тип не хочется. -->
                                    <DataTrigger Binding="{Binding AllExercises.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="4,5"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="4,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="Порядок в плане" />

                        <!-- Так же, как в левой колонке: полоса у внутреннего края своей рамки. -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,-5,0"
                                      helpers:ScrollBarGutter.Left="2"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedExercises}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin"
                                                Value="{Binding ComputedVerticalScrollBarVisibility,
                                                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                        Converter={StaticResource ScrollBarMargin},
                                                        ConverterParameter=5}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,4"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           MinWidth="18"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"
                                                           Text="{Binding Position}" />

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Name}" />

                                                <Button Grid.Column="2"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        ToolTip="Выше" />

                                                <Button Grid.Column="3"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        ToolTip="Ниже" />

                                                <Button Grid.Column="4"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        ToolTip="Убрать из плана" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   IsHitTestVisible="False"
                                   Text="Отметьте упражнения слева">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedExercises.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Padding="14,4"
                    Command="{Binding AcceptCommand}"
                    Content="{Binding AcceptText}"
                    IsDefault="True" />

            <Button Margin="8,0,0,0"
                    Padding="14,4"
                    Content="Отменить"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
