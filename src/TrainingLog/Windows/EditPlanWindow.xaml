<Window x:Class="TrainingLog.Windows.EditPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:core="clr-namespace:TrainingLog.Core;assembly=TrainingLog.Core"
        d:DataContext="{d:DesignInstance Type=vm:EditPlanViewModel}"
        mc:Ignorable="d"
        Title="План тренировки"
        Width="620"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--
          Отступ списка справа, который снимается, пока вертикальная полоса на экране. Тот же
          конвертер, что в главном окне и в окнах справочника и планов, но объявлен здесь своим
          экземпляром: ресурсы окна живут в окне, и общий словарь приложения окну, открытому из
          теста или из другого хоста, недоступен.
        -->
        <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />
    </Window.Resources>
    <!--
      Окно общее для добавления и правки: различаются только заголовок и подпись кнопки,
      которые задаёт модель представления. Высота фиксированная, а списки прокручиваются:
      упражнений в справочнике сколько угодно, и растущее на них окно правки ехало бы за краем
      экрана.

      Две колонки. Слева весь справочник по алфавиту с чекбоксами — это место для поиска.
      Справа упражнения плана в порядке выполнения с номерами и кнопками перестановки:
      отмечать и упорядочивать в одном списке нельзя, потому что алфавитный порядок и порядок
      выполнения противоречат друг другу, а ломать алфавитный поиск нельзя.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Background="Transparent"
                   Text="Наименование"
                   helpers:ClickToFocus.Target="{Binding ElementName=NameBox}" />

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 AcceptsReturn="False"
                 MaxHeight="96"
                 MaxLength="{x:Static core:NameRules.MaxNameLength}"
                 Padding="4,3"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Grid.Row="2"
                  Margin="0,12,0,0"
                  VerticalAlignment="Center"
                  Content="Выбрать все"
                  IsThreeState="True"
                  IsChecked="{Binding IsAllChecked, Mode=TwoWay}" />

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="4,5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="4,0,0,6"
                               FontWeight="SemiBold"
                               Text="Все упражнения" />

                    <!--
                      Списки прижаты к внутреннему краю своих рамок: полоса прокрутки живёт
                      внутри ScrollViewer, и за пределы рамки она выходит только пересекая линию
                      рамки, а это читается как оборванная полоса. Поэтому отрицательный отступ
                      съедает Padding="4,5" вместе с рамкой в 1 px, а отступ списка живёт на
                      контейнере строки и справа снимается, пока полоса на экране. Правая рамка
                      вложена в левую, поэтому её полоса оказывается на 4 px дальше от внешней
                      рамки — выровнять их можно было бы только выведя её за линию рамки, и
                      этого не сделано.
                    -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,-5,0"
                                  helpers:ScrollBarGutter.Left="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllExercises}">
                            <ItemsControl.ItemContainerStyle>
                                <!--
                                  Отступ живёт на контейнере, а не на содержимом скролла:
                                  ScrollBarGutter владеет правым отступом содержимого и затирает
                                  на нём привязку. Слева отступ всегда 5 px.
                                -->
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin"
                                            Value="{Binding ComputedVerticalScrollBarVisibility,
                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                    Converter={StaticResource ScrollBarMargin},
                                                    ConverterParameter=5}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                      Границу рисует контейнер строки, а не шаблон данных: иначе
                                      она привязана к содержимому, а не к строке. Отступы и цвет
                                      те же, что у строк справочника упражнений.
                                    -->
                                    <Border Padding="0,4"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Name}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               IsHitTestVisible="False"
                               Text="Справочник упражнений пуст">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!--
                                      Плейсхолдер без конвертера: у плана это доменная модель,
                                      а конвертера «коллекция пуста» в проекте нет, и ради одного
                                      случая заводить новый тип не хочется.
                                    -->
                                    <DataTrigger Binding="{Binding AllExercises.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="4,5"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="4,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="Порядок в плане" />

                        <!--
                          Так же, как в левой колонке: полоса у внутреннего края своей рамки,
                          отступ на контейнере и справа снимается, пока полоса на экране.
                        -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,-5,0"
                                      helpers:ScrollBarGutter.Left="2"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedExercises}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin"
                                                Value="{Binding ComputedVerticalScrollBarVisibility,
                                                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                        Converter={StaticResource ScrollBarMargin},
                                                        ConverterParameter=5}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,4"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           MinWidth="18"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"
                                                           Text="{Binding Position}" />

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Name}" />

                                                <Button Grid.Column="2"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        ToolTip="Выше" />

                                                <Button Grid.Column="3"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        ToolTip="Ниже" />

                                                <Button Grid.Column="4"
                                                        Margin="4,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        ToolTip="Убрать из плана" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   IsHitTestVisible="False"
                                   Text="Отметьте упражнения слева">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedExercises.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Padding="14,4"
                    Command="{Binding AcceptCommand}"
                    Content="{Binding AcceptText}"
                    IsDefault="True" />

            <Button Margin="8,0,0,0"
                    Padding="14,4"
                    Content="Отменить"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
