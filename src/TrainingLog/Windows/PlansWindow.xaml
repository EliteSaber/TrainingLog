<Window x:Class="TrainingLog.Windows.PlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:PlansViewModel}"
        mc:Ignorable="d"
        Title="Планы"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Ресурсы объявлены в окне, а не в App.xaml: окно должно создаваться без приложения (ловушка 6). -->
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Свой экземпляр по той же причине: у конвертера состояния нет. -->
        <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Отдельной строкой над поиском, а не рядом с ним: в одной строке с полем кнопка читалась бы как действие над результатом поиска. -->
        <Button Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,4"
                HorizontalAlignment="Stretch"
                Command="{Binding AddCommand}"
                Content="Добавить" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       Text="Поиск"
                       helpers:ClickToFocus.Target="{Binding ElementName=FilterBox}" />

            <TextBox x:Name="FilterBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Padding="4,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,4"
                Padding="4,5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
            <Button HorizontalAlignment="Left"
                    Padding="2,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ToggleSortCommand}"
                    ToolTip="Изменить направление сортировки">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название" />
                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding SortIndicator}" />
                </StackPanel>
            </Button>
        </Border>

        <!-- Область списка снимает с себя отступ корневой сетки по бокам: полоса прокрутки живёт внутри ScrollViewer. -->
        <Grid Grid.Row="3"
              Margin="-12,0,-12,0">
            <ScrollViewer helpers:ScrollBarGutter.Left="2"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemContainerStyle>
                        <!--
                          Отступ живёт на контейнере, а не на содержимом скролла: ScrollBarGutter
                          владеет правым отступом содержимого и затирал бы на нём привязку. На
                          контейнере он и не конфликтует с отступом карточки вниз.
                        -->
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin"
                                    Value="{Binding ComputedVerticalScrollBarVisibility,
                                            RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                            Converter={StaticResource ScrollBarMargin},
                                            ConverterParameter=12}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Строка плана — рамка, а внутри неё Expander: нажатие на наименование
                              или треугольник раскрывает состав упражнений прямо в строке.
                              Отдельного окна со списком и GroupBox с ручным раскрытием нет:
                              обработчика нажатия на Header у GroupBox не бывает, а раскрытие
                              уже есть у Expander.

                              Рамка рисуется на Border, а не на самом Expander: так она обводит и
                              кнопки действий справа от наименования. У Expander своя рамка
                              погашена, иначе поверх неё получилось бы две.

                              Кнопки вынесены из шапки Expander в отдельную колонку Grid: шапка —
                              это ToggleButton, и нажатие на кнопку внутри неё доезжало бы до
                              него, то есть «Редактировать» переключала бы и сам план (ловушка 15).
                            -->
                            <Border Margin="0,0,0,6"
                                    Padding="4,3"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Expander Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              BorderThickness="0">
                                        <Expander.Header>
                                            <TextBlock HorizontalAlignment="Left"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Name}" />
                                        </Expander.Header>

                                        <Grid Margin="20,4,0,6">
                                            <ItemsControl ItemsSource="{Binding PlanExercises}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Шаблон смотрит на строки связи, а не на Exercises: номер есть только у них. -->
                                                        <Border Padding="0,3"
                                                                BorderBrush="#E0E0E0"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           MinWidth="18"
                                                                           Margin="0,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="Gray"
                                                                           Text="{Binding Order}" />

                                                                <TextBlock Grid.Column="1"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding Exercise.Name}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Foreground="Gray"
                                                       Text="В плане нет упражнений">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlanExercises.Count}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Expander>

                                    <StackPanel Grid.Column="1"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal">
                                        <Button Padding="8,2"
                                                Command="{Binding DataContext.EditCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Редактировать" />

                                        <Button Margin="4,0,0,0"
                                                Padding="8,2"
                                                Click="OnDeleteClick"
                                                CommandParameter="{Binding}"
                                                Content="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Планы отсутствуют"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
