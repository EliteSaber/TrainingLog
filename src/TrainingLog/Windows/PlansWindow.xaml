<Window x:Class="TrainingLog.Windows.PlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:PlansViewModel}"
        mc:Ignorable="d"
        Title="Планы"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--
          Конвертер объявлен в окне, а не в App.xaml: так окно самодостаточно и создаётся
          без приложения. Общий словарь приложения недоступен, если окно открывают из теста
          или из другого хоста.
        -->
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Кнопка «Добавить» стоит отдельной строкой над поиском, а не рядом с ним: в одной
          строке с полем поиска она читалась как часть этого поля — то есть как действие
          над результатом поиска, а не над всем списком планов.
        -->
        <Button Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,4"
                HorizontalAlignment="Stretch"
                Command="{Binding AddCommand}"
                Content="Добавить" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       Text="Поиск"
                       helpers:ClickToFocus.Target="{Binding ElementName=FilterBox}" />

            <TextBox x:Name="FilterBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Padding="4,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,4"
                Padding="4,5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
            <Button HorizontalAlignment="Left"
                    Padding="2,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ToggleSortCommand}"
                    ToolTip="Изменить направление сортировки">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название" />
                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding SortIndicator}" />
                </StackPanel>
            </Button>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer helpers:ScrollBarGutter.Left="2"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Строка плана — рамка, а внутри неё Expander: нажатие на
                              наименование или треугольник раскрывает состав упражнений прямо
                              в строке, отдельного окна со списком нет. Отдельного окна со
                              списком и GroupBox с ручным раскрытием здесь нет по двум
                              причинам: у GroupBox обработчика нажатия на Header не бывает
                              вовсе, а раскрытие уже есть у Expander.

                              Рамка рисуется на Border, а не на самом Expander: так она
                              обводит и кнопки действий, лежащие справа от наименования.
                              У Expander своя рамка погашена, иначе поверх неё получилось бы
                              две. Заодно на Border переехали отступы внутри — прежние
                              Margin у Expander и StackPanel с кнопками.

                              Кнопки вынесены из шапки Expander в отдельную колонку Grid:
                              шапка Expander — это ToggleButton, и нажатие на кнопку внутри
                              неё доезжало бы до него, то есть «Редактировать» переключала бы
                              и сам план. Здесь колонка Grid растягивает кнопки к правому
                              краю рамки, а наименование остаётся слева.
                            -->
                            <Border Margin="0,0,0,6"
                                    Padding="4,3"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Expander Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              BorderThickness="0">
                                        <Expander.Header>
                                            <TextBlock HorizontalAlignment="Left"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Name}" />
                                        </Expander.Header>

                                        <Grid Margin="20,4,0,6">
                                            <ItemsControl ItemsSource="{Binding PlanExercises}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!--
                                                          Состав показывается по порядку
                                                          выполнения с номерами, поэтому шаблон
                                                          смотрит на строки связи: у них есть
                                                          и номер, и ссылка на упражнение.
                                                          Вычисляемое Exercises даёт только
                                                          наименования и номера в нём нет.
                                                        -->
                                                        <Border Padding="0,3"
                                                                BorderBrush="#E0E0E0"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           MinWidth="18"
                                                                           Margin="0,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="Gray"
                                                                           Text="{Binding Order}" />

                                                                <TextBlock Grid.Column="1"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding Exercise.Name}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Foreground="Gray"
                                                       Text="В плане нет упражнений">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlanExercises.Count}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Expander>

                                    <StackPanel Grid.Column="1"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal">
                                        <Button Padding="8,2"
                                                Command="{Binding DataContext.EditCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Редактировать" />

                                        <Button Margin="4,0,0,0"
                                                Padding="8,2"
                                                Click="OnDeleteClick"
                                                CommandParameter="{Binding}"
                                                Content="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Планы отсутствуют"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
