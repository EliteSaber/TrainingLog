<Window x:Class="TrainingLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="560"
        Width="900"
        MinWidth="640"
        MinHeight="360">
    <Window.Resources>
        <ContextMenu x:Key="SettingsMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Упражнения"
                      Command="{Binding OpenExercisesCommand}" />

            <MenuItem Header="Планы"
                      Command="{Binding OpenPlansCommand}" />
        </ContextMenu>

        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding Title}" />

            <!--
              Сколько дней показывать — рядом с заголовком, а не внизу: это настройка показа,
              а не действие над записью. Значение применяется кнопкой, поэтому поле не
              меняет список само и список не перечитывается на каждый введённый символ.
              Пустое или негодное поле гасит «Применить» — считать дни по мусору нельзя.
            -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="Количество дней" />

                <TextBox Width="52"
                         Margin="8,0,0,0"
                         Padding="4,3"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text="{Binding DaysCount, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Button Grid.Column="3"
                    Margin="0,0,12,0"
                    Padding="14,4"
                    VerticalAlignment="Center"
                    Command="{Binding ApplyCommand}"
                    Content="Применить" />

            <Button x:Name="SettingsButton"
                    Grid.Column="4"
                    Padding="8"
                    VerticalAlignment="Center"
                    Focusable="False"
                    ToolTip="Параметры"
                    Click="OnSettingsButtonClick"
                    ContextMenu="{StaticResource SettingsMenu}">
                <Button.Content>
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                          Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z" />
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,16,0,0">
            <!--
          Дней может быть много, а столбцов в дне — сколько подходов, и это число ничем не
          ограничено: ширина дня не зависит от ширины окна. Поэтому прокрутка по обеим
          осям, иначе длинный день просто обрезался бы. Зазор слева от полосы — тот же
          ScrollBarGutter, что в остальных списках.
        -->
        <ScrollViewer helpers:ScrollBarGutter.Left="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Четыре строки дня: план, упражнения, вес, повторения. Дата одна
                              на все строки — она задаёт день, а не упражнение.

                              Столбцы упражнений, весов и повторений — три горизонтальных
                              списка, а не Grid с колонками: количество колонок у дня равно
                              числу подходов всех упражнений и меняется от дня к дню, а
                              динамические ColumnDefinition'ы разъезжались бы по ширине.
                              Ширина ячейки фиксирована и задана моделью, поэтому вес стоит
                              ровно над своим повторением, а столбцы совпадают.
                            -->
                            <Border Padding="0,10,0,10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                      Дата одна на все четыре строки: она задаёт день, а не
                                      упражнение. Ширину столбца задаёт содержимое — оно
                                      одинаково у всех дней в одной и той же позиции, а
                                      столбцы подписей общие для всех четырёх строк.
                                    -->
                                    <TextBlock Grid.Column="0"
                                               Grid.RowSpan="4"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"
                                               Text="{Binding DateText}" />

                                    <TextBlock Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Grid.Row="0"
                                               Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding PlanName}" />

                                    <ItemsControl Grid.Column="2"
                                                  Grid.Row="1"
                                                  ItemsSource="{Binding Exercises}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="{Binding Width}"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Column="1"
                                               Grid.Row="2"
                                               Margin="0,2,12,0"
                                               Text="Вес" />

                                    <ItemsControl Grid.Column="2"
                                                  Grid.Row="2"
                                                  ItemsSource="{Binding Sets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="{Binding CellWidth}"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding WeightText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Column="1"
                                               Grid.Row="3"
                                               Margin="0,2,12,0"
                                               Text="Повторения" />

                                    <ItemsControl Grid.Column="2"
                                                  Grid.Row="3"
                                                  ItemsSource="{Binding Sets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="{Binding CellWidth}"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding RepetitionText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Записей пока нет"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Button Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Padding="14,4"
                Command="{Binding AddDayCommand}"
                Content="Добавить день" />
    </Grid>
</Window>