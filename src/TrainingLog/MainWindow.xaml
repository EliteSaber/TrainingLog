<Window x:Class="TrainingLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="560"
        Width="900"
        MinWidth="640"
        MinHeight="360">
    <Window.Resources>
        <ContextMenu x:Key="SettingsMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Упражнения"
                      Command="{Binding OpenExercisesCommand}" />

            <MenuItem Header="Планы"
                      Command="{Binding OpenPlansCommand}" />
        </ContextMenu>

        <!--
          Меню строки дня. DataContext задаётся не здесь, а при открытии, в
          OnDayContextMenuOpening: у ContextMenu отдельное логическое дерево, и до окна
          добраться из него нельзя (ловушка 41). Поэтому и команда, и её параметр приходят
          сверху — из открывающего кода, а не привязкой.

          Контекстное меню открывается само по правому клику в любом месте строки:
          ContextMenuService находит меню у элемента под мышью и поднимается вверх, поэтому
          клик по названию плана или по столбцу подхода попадает в меню дня.

          Побочный эффект тот же, что у меню шестерёнки: пока меню открыто, окно не получает
          наведения (ловушка 34). В строке дня наведения нет, так что это видно только по
          курсору.
        -->
        <ContextMenu x:Key="DayContextMenu">
            <MenuItem Header="Редактировать"
                      Command="{Binding EditDayCommand}" />
        </ContextMenu>

        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
          Отступ рамки строки дня по состоянию полосы: пока полоса на экране, правый отступ
          снимается. Величина приходит параметром конвертера, поэтому он ничего не знает про
          отступы окна.
        -->
        <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding Title}" />

            <!--
              Сколько дней показывать — рядом с заголовком, а не внизу: это настройка показа,
              а не действие над записью. Значение применяется кнопкой, поэтому поле не
              меняет список само и список не перечитывается на каждый введённый символ.
              Пустое или негодное поле гасит «Применить» — считать дни по мусору нельзя.

              AllowedCharsInput оставляет в поле только цифры, поэтому «мусор» здесь остаётся
              пустым полем и значением за пределом MaxDaysCount — оба случая гасят кнопку.

              Подпись передаёт фокус полю по клику тем же поведением, что «Поиск» в справочнике
              упражнений: ни TextBlock, ни Label в WPF этого не делают (ловушка 13).
              Background="Transparent" обязателен — без фона подпись попадает под мышь только по
              самим буквам, и клик по пробелу между словами не сработал бы.
            -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Background="Transparent"
                           VerticalAlignment="Center"
                           Text="Количество дней"
                           helpers:ClickToFocus.Target="{Binding ElementName=DaysCountBox}" />

                <TextBox x:Name="DaysCountBox"
                         Width="52"
                         Margin="8,0,0,0"
                         Padding="4,3"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         helpers:AllowedCharsInput.Allowed="Digits"
                         Text="{Binding DaysCount, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--
              Enter применяет количество дней. IsDefault, а не горячая клавиша: в окне дня,
              окне правки упражнения и окне правки плана Enter подтверждает кнопку именно
              так, и KeyBinding в проекте занят под Ctrl+S. Оба механизма на одной кнопке
              означали бы двойное выполнение.

              До кнопки Enter доходит сам: фильтр цифр глотает в PreviewKeyDown только
              пробел (AllowedCharsInput), а AcceptsReturn у поля не задан, то есть остаётся
              False — Enter подтверждает, а не добавляет строку.
            -->
            <Button Grid.Column="3"
                    Margin="0,0,12,0"
                    Padding="14,4"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    Command="{Binding ApplyCommand}"
                    Content="Применить" />

            <Button x:Name="SettingsButton"
                    Grid.Column="4"
                    Padding="8"
                    VerticalAlignment="Center"
                    Focusable="False"
                    ToolTip="Параметры"
                    Click="OnSettingsButtonClick"
                    ContextMenu="{StaticResource SettingsMenu}">
                <Button.Content>
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                          Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z" />
                </Button.Content>
            </Button>
        </Grid>

        <!--
          Линия над списком дней: отделяет список от шапки и идёт от края окна до края. Стоит
          сразу над ScrollViewer, поэтому зазор 16 px остаётся над ней, а не после неё.

          Высота задаётся самой рамкой: у Border без содержимого желаемый размер равен толщине
          границы, то есть этой строке хватает высоты в 1 px без Height.

          Отрицательные отступы по бокам снимают отступ корневой сетки (16 px), и Padding здесь
          не нужен: возвращать отступ нечего, содержимого у линии нет. Отрицательные отступы
          безопасны — обрезает только само окно, а корневая сетка содержимое не обрезает.

          Сам отступ корневой сетки на детей намеренно не переносится: он один на всё окно, и
          на него же опирается правило положения подсказки (PopupPlacement).

          Тон и толщина — те же, что у разделителей в списках: #E0E0E0, 1 px.
        -->
        <Border Grid.Row="1"
                Margin="-16,16,-16,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />

        <!--
          Область дней снимает с себя отступ корневой сетки по бокам: вертикальная полоса
          прокрутки живёт внутри ScrollViewer, и прижать её к краю окна иначе нечем — вместе с
          ней у края встал бы только уголок пустого фона. Отступ не пропал, а переехал внутрь
          строки дня, поэтому дата, подписи и числа остались на прежних местах — и с полосой,
          и без неё. Вертикальный зазор не трогаем: он у линии над списком.
        -->
        <Grid Grid.Row="2"
              Margin="-16,0,-16,0">
            <!--
          Дней может быть много, а столбцов в дне — сколько подходов, и это число ничем не
          ограничено: ширина дня не зависит от ширины окна. Поэтому прокрутка по обеим
          осям, иначе длинный день просто обрезался бы.

          Зазор слева от полосы — тот же ScrollBarGutter, что в остальных списках, и он
          остаётся: это воздух между содержимым и полосой, а не отступ строки. Отступ строки
          справа живёт отдельно и снимается, пока полоса на экране, — см. рамку ниже.
        -->
        <ScrollViewer helpers:ScrollBarGutter.Left="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Days}"
                              MouseDoubleClick="OnDayDoubleClick">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Пять строк дня: план, упражнения, вес, повторения и примечание.
                              Дата стоит в своей колонке и задаёт день, а не упражнение; в этой же
                              колонке — подписи «Вес», «Повторения» и «Примечание», поэтому
                              значения начинаются сразу за датой, а не за отдельной колонкой
                              подписей.

                              Столбцы упражнений, весов, повторений и примечаний — четыре
                              горизонтальных списка, а не Grid с колонками: количество колонок у
                              дня равно числу подходов всех упражнений и меняется от дня к дню, а
                              динамические ColumnDefinition'ы разъезжались бы по ширине. Ширина
                              ячейки фиксирована и задана моделью, поэтому вес стоит ровно над своим
                              повторением, а столбцы совпадают.

                              Упражнение читается как блок: название — заголовок над своими
                              столбцами, по центру своей строки, а по краям блока — вертикальные
                              линии, отделяющие его от соседних упражнений. Ширину блока даёт
                              модель (подходы упражнения на CellWidth), и по той же формуле она
                              считается для списков веса и повторений, а поэтому границы блока
                              совпадают с краями его столбцов.

                              По блоку кликается целиком — дата, план, упражнения, вес и
                              повторения, а также пустые места строки. Правый клик открывает
                              меню с одним пунктом, двойной — правку дня. Дабл-клик подписан на
                              список дней, а не на Border: у Border нет собственного события
                              MouseDoubleClick (он есть у Control), и в разметке оно не
                              ставится, а список дней — ItemsControl, то есть Control. Строка дня
                              находится по элементу под мышью штатным ContainerFromElement.
                              Подписка на Border тоже вышла бы не туда: клик мимо строк открыл бы
                              правку не на том дне.

                              Две рамки, а не одна: внешняя ловит мышь, внутренняя держит вид.
                              Меню и подписки висят на внешней, а отступ и разделитель — на
                              внутренней.

                              Внешняя без заливки не ловила бы мышь там, где ничего не
                              нарисовано: без фона Border попадает под мышь только по
                              нарисованному, и пустые ячейки под датой и левее подписей
                              пропускали бы нажатие насквозь, мимо строки.

                              MinWidth нужен по другой причине: строка меряется бесконечной
                              шириной (у скролла горизонтальная прокрутка), и без него шириной
                              своего содержимого: правее последнего упражнения строки не было бы
                              вовсе, и клик некуда было бы отнести. Ширина берётся у ближайшего
                              ItemsControl — это ширина его содержимого, то есть вертикальная
                              полоса и зазор ScrollBarGutter уже вычтены. От самого ScrollViewer
                              брать нельзя: строка уехала бы под полосу, и список получил бы
                              лишнюю горизонтальную прокрутку.

                              Внутренняя рамка — это прежняя строка дня целиком: отступ 16 px,
                              вертикальные поля и нижний разделитель те же. Отступ переехал сюда с
                              корневой сетки, потому что полоса прокрутки живёт внутри
                              ScrollViewer и к краю окна прижимается только вместе с ним.

                              Единственное, что здесь меняется, — правый отступ рамки: пока
                              вертикальная полоса на экране, его нет. Полоса стоит у самого края
                              окна и отнимает место у содержимого, а отступ поверх добавлял бы
                              воздух, которого слева нет, и таблица читалась бы разорванной.
                              Когда полоса уходит, отступ возвращается, и строка снова
                              симметрична. Слева он всегда 16 px.

                              Источник — ComputedVerticalScrollBarVisibility, а не
                              VerticalScrollBarVisibility: первое это фактическое состояние
                              полосы, которое скролл сам обновляет при её появлении и
                              исчезновении, второе — только настройка (Auto/Visible). Свойство
                              читаемое, поэтому режим привязки не указан: писать отступ обратно
                              нельзя, и конвертер такого обратного превращения и не умеет.
                            -->
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Background="Transparent"
                                    ContextMenu="{StaticResource DayContextMenu}"
                                    ContextMenuOpening="OnDayContextMenuOpening">
                                <Border Margin="{Binding ComputedVerticalScrollBarVisibility,
                                                             RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                             Converter={StaticResource ScrollBarMargin},
                                                             ConverterParameter=16}"
                                        Padding="0,10,0,10"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--
                                          Дата стоит в колонке вместе с подписями «Вес» и
                                          «Повторения» и задаёт её ширину: она одинакова у всех дней
                                          в одной и той же позиции, а подписи короче — поэтому они
                                          прижаты к своим значениям вправо. Больше дата не на все
                                          строки: под ней пусто, и это оставлено сознательно —
                                          упражнения сдвинуты влево, а строка их названий под датой
                                          осталась пустой.
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Top"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DateText}" />

                                        <!--
                                          Название плана больше не натянуто на две колонки. В сетке под
                                          бесконечной шириной ScrollViewer элемент, перекрывающий
                                          несколько Auto-колонок, отдаёт лишнюю ширину по ним, и
                                          длинное название раздвигало колонку подписей, а с ней всю
                                          таблицу упражнений вправо. Теперь колонку даты задаёт только
                                          дата, и длинное название на подписи не влияет.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Margin="0,0,0,6"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding PlanName}" />

                                        <!--
                                          Подложка строки «Вес»: строка должна читаться как отдельная,
                                          поэтому подпись и её значения лежат на одной полосе чуть
                                          темнее фона. Полоса идёт от левого края дня до последнего
                                          столбца: подпись «Вес» и её числа — одна строка, и полоса
                                          накрывает обе её части, колонку даты включительно. Элемент
                                          пустой, поэтому строка Auto от него не растёт, а
                                          растягивается на её высоту.

                                          Объявлена раньше списка границ — не по смыслу, а по порядку
                                          отрисовки: в Grid рисуется последним объявленным (как
                                          плейсхолдер поверх поля в окне дня), и полоса рядом со своей
                                          строкой закрыла бы сквозные линии упражнений.

                                          Оттенок зашит, а не взят системной кистью: фон окна сам
                                          SystemColors.ControlBrush, то есть кисть того же оттенка была
                                          бы неотличима от подложки, а темнее системного оттенка здесь
                                          и взять нечего. Обратная сторона — в тёмной теме полоса
                                          станет светлой. В окне дня поле веса наоборот берётся
                                          системным ControlBrush, и там это единственное, что темнее
                                          фона поля. Разнонаправленно и осознанно: там фон поля
                                          белый, здесь фон окна серый.
                                        -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="#E6E6E6"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Подложка строки «Примечание» — та же полоса и по той же
                                          причине: строка читается как отдельная, как «Вес». Объявлена
                                          здесь, а не рядом со своим списком, по порядку отрисовки:
                                          в Grid рисуется последним объявленным, и полоса рядом со своей
                                          строкой закрыла бы сквозные линии упражнений.

                                          Полоса идёт от левого края дня, то есть накрывает и колонку
                                          даты с подписью, — как и у веса.
                                        -->
                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="#E6E6E6"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Упражнение читается как блок: название — заголовок над
                                          своими столбцами, по центру по горизонтали и по
                                          вертикали, а по краям блока — вертикальные линии,
                                          отделяющие его от соседних упражнений.

                                          Границы и названия — два списка по одному Exercises, и это
                                          не раздвоение по смыслу, а единственный способ получить
                                          сквозную линию рядом с названием, оставшимся в своей
                                          строке: элемент, который держит название, живёт ровно в
                                          одной строке и выше неё рамку не нарисует. Список границ
                                          натянут Grid.RowSpan на четыре строки (название, вес,
                                          повторения, примечание), а VerticalContentAlignment обязателен:
                                          у ItemsControl содержимое выравнивается по умолчанию вверх,
                                          панель меряется под своё содержимое, и без растяжения
                                          линии дошли бы только до шапки (ловушка 40). Дальше
                                          работает ловушка 39: дети горизонтального StackPanel
                                          получают полную высоту слота, поэтому рамка на всю высоту
                                          блока.

                                          Ширину блока даёт модель — подходы упражнения на
                                          CellWidth, — и по той же формуле считаются столбцы веса и
                                          повторений, поэтому обе линии попадают точно на внешние
                                          края столбцов своего упражнения, а разбирать в разметке,
                                          где кончается упражнение, не нужно: ни флагов
                                          «первый и последний подход», ни рамки на каждой ячейке.

                                          Список границ объявлен первым, то есть рисуется под
                                          названиями: обе линии в шапке ложатся на одни и те же
                                          пиксели, поэтому полосы вдвое не получается. Он же
                                          IsHitTestVisible=False: нажатия сквозь линии идти должны.

                                          Общая граница соседних упражнений — это две линии вплотную,
                                          то есть полоса вдвое шире одиночной рамки у края дня.
                                          Между упражнениями есть и воздух, но задавать его — значит
                                          вернуть в строку дня вторую константу расстояния.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      Grid.RowSpan="4"
                                                      VerticalContentAlignment="Stretch"
                                                      IsHitTestVisible="False"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            BorderBrush="#E0E0E0"
                                                            BorderThickness="1,0,1,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Название стоит в своей строке и по центру именно этой
                                          строки, а не своей высоты: строка Auto растёт под самое
                                          длинное название дня, и VerticalAlignment ставит по её
                                          середине все названия, включая короткие. По умолчанию у
                                          TextBlock Stretch, и с ним название снова прижалось бы к
                                          верху строки.

                                          TextAlignment центрирует строки внутри заданной ширины.
                                          HorizontalAlignment на самом TextBlock не ставится: по
                                          ловушке 29 центрированный элемент меряется под своё
                                          содержимое, и перенос перестаёт работать. Ширину задаёт
                                          Border, и она равна ширине блока упражнения — той же, что
                                          занимают его подходы.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="6,0"
                                                            BorderBrush="#E0E0E0"
                                                            BorderThickness="1,0,1,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Подписи «Вес» и «Повторения» стоят в колонке даты и
                                          прижаты вправо. Так они остаются вплотную к своим значениям:
                                          колонку задаёт дата (около 170 px), а «Повторения» занимает
                                          около 68, и оставшись слева, подписи оторвались бы от чисел
                                          на всю эту разницу. Собственный Margin справа — это зазор до
                                          значений: расстояние между соседями задаётся на самих
                                          соседях (ловушка 37).

                                          Значение стоит по центру своей ячейки, а не по центру
                                          ячейки блока: центрирует TextAlignment, то есть строки
                                          внутри заданной ширины (как в названиях упражнений).

                                          HorizontalAlignment у этих значений не работал и был бы
                                          бесполезен: у ребёнка горизонтального StackPanel слот по
                                          оси раскладки равен DesiredSize.Width, а Width и есть это
                                          самое желаемое, поэтому Left, Center и Stretch выглядят
                                          одинаково (ловушка 39). Центрировать сам элемент нельзя и
                                          по второй причине — ловушка 29: центрированный элемент
                                          меряется под своё содержимое, и ширина ячейки перестала бы
                                          его ограничивать.

                                          Ширина ячейки задана моделью, поэтому вес остаётся ровно
                                          над своим повторением, а столбцы упражнений совпадают со
                                          столбцами подходов.
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="2"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Вес" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="2"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding WeightText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="3"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Повторения" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="3"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding RepetitionText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="4"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Примечание" />

                                        <!--
                                          Примечание принадлежит упражнению, а не подходу, поэтому
                                          это ещё один горизонтальный список по Exercises в своей
                                          строке, а не что-то в ячейке подхода. Ширина блока — та
                                          же, что у названия и у столбцов подходов, поэтому кнопка
                                          «Показать» растягивается ровно на колонки своего
                                          упражнения.

                                          Показывается кнопкой, потому что текст примечания коротким
                                          не бывает: в строку журнала он не помещается, а
                                          подсказкой показывается по требованию — тем же контролом,
                                          что и отказ по вводу. Без примечания на его месте прочерк
                                          посередине блока: пустоты в строке быть не должно, иначе
                                          упражнение без примечания выглядит как обрезанное.

                                          Своих боковых рамок у ячейки нет: вертикальные линии блока
                                          идут сквозными линиями от первого списка, натянутого на
                                          четыре строки, — ровно как под названием упражнения. Ещё
                                          одна пара линий на том же месте была бы просто вдвое
                                          темнее.

                                          Вид по наличию примечания задан DataTrigger, а не
                                          конвертером, как маркеры примечания в окне дня: правило одно
                                          на оба места (ловушка 43).

                                          Кнопка объявлена раньше прочерка, а прочерк занимает всю
                                          рамку: в Grid рисуется последним объявленным, и нажатие по
                                          прочерку должно доходить до кнопки под ним, пока та видима.
                                          Когда примечание есть, прочерк свёрнут и ничего не ловит
                                          (Collapsed, а не Hidden).

                                          Своим MouseDoubleClick кнопка не гасит: двойной клик по ней —
                                          это перечитывание примечания, и правку дня он открывать
                                          не должен, но событие поднимается от элемента под
                                          указателем, и на самой кнопке помечать его бесполезно —
                                          до списка дней оно доходит как ни в чём не бывало.
                                          Поэтому двойной клик разбирается в OnDayDoubleClick
                                          (ловушка 45).
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="4"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="1,2">
                                                        <Grid>
                                                            <Button Padding="1,1"
                                                                    FontSize="11"
                                                                    Click="OnShowNoteClick">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>

                                                                <!--
                                                                  Надпись кнопки — отдельный блок с
                                                                  обрезкой, а не содержимое строкой: при
                                                                  одном подходе блок упражнения узок
                                                                  (CellWidth = 60), и надпись шириной
                                                                  блока не поместилась бы в него, а
                                                                  вышла бы за край и налегла на соседнее
                                                                  упражнение. Обрезка здесь страховка, а не
                                                                  ожидаемый вид: шрифт на пункт меньше
                                                                  подписи строки как раз ради этого.
                                                                  Обрезка работает только без переноса,
                                                                  поэтому перенос здесь не задан (ловушка 36).
                                                                -->
                                                                <TextBlock Text="Показать"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Button>

                                                            <!--
                                                              Прочерк стоит по центру блока, а
                                                              HorizontalAlignment="Center" на нём
                                                              бесполезен: слот у ребёнка рамки с
                                                              заданной шириной совпадает с ней самой,
                                                              а центрирует строки внутри заданной ширины
                                                              TextAlignment (ловушка 39). Тон бледный —
                                                              тот же, что у «Записей пока нет»:
                                                              примечания нет, и читаться это должно как
                                                              пустота, а не как значение.
                                                            -->
                                                            <TextBlock Foreground="Gray"
                                                                       Text="—"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Записей пока нет"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Button Grid.Row="3"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Padding="14,4"
                Command="{Binding AddDayCommand}"
                Content="Добавить день" />

<!--
          Подсказка окна — тот же контрол, что в окне дня: она нарисована поверх содержимого окна
          и ничего не сдвигает. Вид, срок жизни и поведение при закрытии описаны в самом
          StatusHint, правило позиционирования — в PopupPlacement (ловушки 34 и 32).

          Здесь ею показываются два разных сообщения: отказ по вводу в «Количество дней» и
          примечание упражнения по кнопке «Показать». Различаются они тоном и сроком жизни, и оба
          заданы моделью (Hint.Kind и Hint.Lifetime) — то, что показывается, решает модель, а
          рисует контрол.

          Якорей (Target) в разметке нет: подсказка встаёт под то поле или ту кнопку, откуда
          пришло сообщение, и окно переставляет якорь с одного на другой. Привязка на этом свойстве
          и невозможна: локальное присваивание заменило бы её навсегда (ловушка 11).

          Стоит последним в корневой сетке и с Panel.ZIndex: порядок отрисовки в WPF задаётся
          ZIndex среди соседей, а из шапки подсказка не смогла бы перекрыть ни список дней, ни
          нижние кнопки.
        -->
        <helpers:StatusHint x:Name="InputHint"
                            Panel.ZIndex="10"
                            ClosedCommand="{Binding Hint.ClearCommand}"
                            DismissCommand="{Binding Hint.DismissCommand}"
                            IsOpen="{Binding Hint.IsVisible}"
                            Kind="{Binding Hint.Kind}"
                            Lifetime="{Binding Hint.Lifetime}"
                            Text="{Binding Hint.Text}" />
    </Grid>
</Window>
