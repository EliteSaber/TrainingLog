<Window x:Class="TrainingLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:kb="clr-namespace:System.Windows.Input;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource BodySize}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        Style="{DynamicResource AppWindowStyle}"
        Title="{Binding Title}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Стили темы — ловушка 6: ресурсы окна живут в окне, иначе окно не создаётся без
                  Application. Палитра и токены шрифта живут на уровне приложения: своими
                  оконными экземплярами они перекрыли бы подмену.
                -->
                <ResourceDictionary Source="pack://application:,,,/TrainingLog;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="SettingsMenu"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Упражнения"
                          Command="{Binding OpenExercisesCommand}" />

                <MenuItem Header="Планы"
                          Command="{Binding OpenPlansCommand}" />

                <!--
                  Параметры отделены разделителем и стоят последними: это единственный пункт, который
                  не открывает справочник, а меняет само приложение. Разделитель объявлен в меню, а не
                  сделан отступом у пункта — иначе отступ остался бы висеть в воздухе. Линия идёт во
                  всю ширину карточки — по тем же правилам, что остальные разделители приложения.

                  Стиль назначен явно, а не оставлен неявным: внутри ContextMenu тема WPF
                  перебивает неявный стиль Separator (у него есть DefaultStyleKey, а тема
                  регистрирует его стилем по ключу) — и разделитель получался тематическим: со
                  сдвигом 30 px и цветом #D7D7D7 в обеих темах. Подробности — в Themes/Controls.xaml.
                -->
                <Separator Style="{StaticResource {x:Type Separator}}" />

                <MenuItem Header="Параметры…"
                          Command="{Binding OpenSettingsCommand}" />
            </ContextMenu>

            <!--
              Меню строки дня. DataContext задаётся не здесь, а при открытии, в
              OnDayContextMenuOpening: у ContextMenu отдельное логическое дерево, и до окна
              добраться из него нельзя (ловушка 52). Поэтому и команда, и её параметр приходят
              сверху — из открывающего кода, а не привязкой.

              Контекстное меню открывается само по правому клику в любом месте строки:
              ContextMenuService находит меню у элемента под мышью и поднимается вверх, поэтому
              клик по названию плана или по столбцу подхода попадает в меню дня.

              Побочный эффект тот же, что у меню шестерёнки: пока меню открыто, окно не получает
              наведения (ловушка 43). В строке дня наведения нет, так что это видно только по
              курсору.
            -->
            <ContextMenu x:Key="DayContextMenu">
                <MenuItem Header="Редактировать"
                          Command="{Binding EditDayCommand}" />
            </ContextMenu>

            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!--
              Отступ рамки строки дня по состоянию полосы: пока полоса на экране, правый отступ
              снимается. Величина приходит параметром конвертера, поэтому он ничего не знает про
              отступы окна.
            -->
            <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />

            <!--
              Сводка свёрнутого фильтра: кнопка без вида кнопки. Фон прозрачный, рамки и отступов
              нет, поэтому кликабельной становится вся надпись, а выглядит она обычным текстом.
              Наведение и нажатие меняют цвет — так видно, что по сводке можно щёлкнуть. Фокуса у
              кнопки нет: клавиатурой блок разворачивает шеврон, и лишняя остановка Tab не нужна.
            -->
            <Style x:Key="FilterSummaryLink" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryPressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Полоса заголовка вместо системной. Отрицательные отступы снимают отступ корневой сетки —
          тот же приём, что у разделителя ниже: полоса обязана идти от самих краёв окна.
        -->
        <helpers:TitleBar Grid.Row="0"
                          Margin="-16,-16,-16,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              Шапка показывает только настройки показа. Надпись «Журнал тренировок» стоит в средней
              колонке и видна только при свёрнутом фильтре: тогда это единственный заголовок шапки,
              а центр свободного места приходится ровно между свёрнутым блоком и шестерёнкой.
              В развёрнутом виде заголовка нет совсем — место занимают фильтры.

              Развёрнутый вид — таблица из двух строк: в первой «С» и «Показать все», во второй
              «До» и «Количество дней». По строкам выровнены и даты, и настройки, поэтому поле
              числа стоит ровно напротив поля «До» независимо от высоты шрифта, а «Применить»
              центрируется по общей высоте обеих строк. Шестерёнка живёт в отдельной колонке: она
              действие окна, а не показ, и остаётся справа.

              Шеврон слева сворачивает блок до одной строки-сводки: «29.10.2026 — 18.11.2026 [4]»
              или «Последние 4». Свёрнутый вид прячет поля, галочку и «Применить», а показывает
              только применённый фильтр: введённое, но не принятое, сводку не меняет. Щелчок по
              самой сводке разворачивает блок — это та же команда, что у шеврона.

              Всё в шапке применяется одной кнопкой «Применить» (и Enter): даты, галочка и число
              — одно состояние показа, а не три разных. Поэтому крестик очистки даты список не
              перечитывает — он правит фильтр, как и сам выбор даты.
            -->
            <Grid Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  Шеврон: плоская кнопка 20×20 без объёма и свечения — вровень с полями, а не
                  стеклянной пилюлей. Вниз — блок свёрнут, вверх — развёрнут; направление меняет
                  Data триггером, а не два разных пути. Подсказка приходит из модели.
                -->
                <Button Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource GlassButtonIconFlat}"
                        ToolTip="{Binding FiltersToggleText}"
                        AutomationProperties.Name="{Binding FiltersToggleText}"
                        Command="{Binding ToggleFiltersCommand}"
                        helpers:Hotkey.Id="Main.FiltersToggle">
                    <Path Width="10"
                          Height="10"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 0,0 L 7,7 L 14,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True">
                                        <Setter Property="Data" Value="M 0,7 L 7,0 L 14,7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <Grid Grid.Column="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiltersExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Background="Transparent"
                               VerticalAlignment="Center"
                               Text="С"
                               helpers:ClickToFocus.Target="{Binding ElementName=DateFromPicker}" />

                    <DatePicker x:Name="DateFromPicker"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="170"
                                Margin="8,0,16,0"
                                VerticalAlignment="Center"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                helpers:DatePickerClear.Command="{Binding ClearDateFromCommand}" />

                    <!--
                      Галочка стоит рядом с полем числа: она снимает именно его ограничение. Пока она
                      отмечена, поле числа недоступно, а его подпись бледнеет — так видно, что число
                      сейчас не действует, но настройка не потеряна.

                      Квадрат чекбокса стоит по центру над полем числа и равен ему по высоте: Tag —
                      ширина поля (шаблон не видит элементы окна), Height — его ActualHeight.
                    -->
                    <CheckBox Grid.Row="0"
                              Grid.Column="2"
                              Height="{Binding ActualHeight, ElementName=DaysCountBox}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource CheckBoxSquareRight}"
                              Tag="{Binding ActualWidth, ElementName=DaysCountBox}"
                              Content="Показать все"
                              IsChecked="{Binding ShowAll, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,8,0,0"
                               Background="Transparent"
                               VerticalAlignment="Center"
                               Text="До"
                               helpers:ClickToFocus.Target="{Binding ElementName=DateToPicker}" />

                    <DatePicker x:Name="DateToPicker"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="170"
                                Margin="8,8,16,0"
                                VerticalAlignment="Center"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                helpers:DatePickerClear.Command="{Binding ClearDateToCommand}" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,8,12,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Background="Transparent"
                                   VerticalAlignment="Center"
                                   Text="Количество дней"
                                   helpers:ClickToFocus.Target="{Binding ElementName=DaysCountBox}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAll}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                          BlurOnKeys возвращает фокус списку по Esc и Enter: без снятия фокуса поле гасит
                          стрелки выделения кареткой, а клик по журналу фокус не переносит (нефокусируемое).
                          Enter не гасится — «Применить» срабатывает IsDefault'ом, и фокус уходит уже после.
                        -->
                        <TextBox x:Name="DaysCountBox"
                                 Width="52"
                                 Margin="8,0,0,0"
                                 Padding="4,3"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsCountEnabled}"
                                 helpers:AllowedCharsInput.Allowed="Digits"
                                 helpers:BlurOnKeys.Keys="Escape,Enter"
                                 helpers:BlurOnKeys.Target="{Binding ElementName=DaysList}"
                                 Text="{Binding DaysCount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--
                      Enter применяет фильтр. IsDefault, а не горячая клавиша: KeyBinding в проекте
                      занят под Ctrl+S, а оба механизма на одной кнопке означали бы двойное выполнение. До
                      кнопки Enter доходит сам: фильтр цифр глотает в PreviewKeyDown только пробел, а
                      AcceptsReturn у поля не задан.

                      Кнопка относится к обеим строкам, поэтому RowSpan и центрирование по их общей
                      высоте, а не отдельный ряд.
                    -->
                    <!--
                      На время чтения «Применить» уступает место кольцу: надпись скрыта через
                      Hidden, а не Collapsed, поэтому ширина кнопки не меняется и шапка не
                      прыгает. Кольцо — дорожка TextSecondary с прозрачностью и акцентная дуга;
                      вращается по часовой, пока IsBusy. Чтение уходит в фон (см. RefreshAsync),
                      иначе UI-поток был бы занят и анимация стояла.

                      Кольцо фиксированное, 16×16, как шестерёнка и шеврон: иконки в проекте не
                      масштабируются вместе со шрифтом. Доступное имя задано явно — с текстом оно
                      исчезло бы.
                    -->
                    <Button Grid.RowSpan="2"
                            Grid.Column="3"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GlassButtonSoft}"
                            IsDefault="True"
                            AutomationProperties.Name="Применить"
                            Command="{Binding ApplyCommand}"
                            helpers:Hotkey.Id="Main.Apply">
                        <Grid>
                            <TextBlock Text="Применить">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Width="16"
                                  Height="16"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform />
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ApplySpinner">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.9"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ApplySpinner" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Дорожка: полное кольцо, приглушённое, чтобы дуга читалась отдельно. -->
                                <Ellipse Width="14"
                                         Height="14"
                                         Stroke="{DynamicResource TextSecondary}"
                                         StrokeThickness="2"
                                         Opacity="0.35" />

                                <!-- Дуга ~100°: от верха по часовой, с круглыми торцами. -->
                                <Path Width="16"
                                      Height="16"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Stretch="None"
                                      Data="M 8,1 A 7,7 0 0 1 14.894,9.215"
                                      Stroke="{DynamicResource AccentStrong}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>

                <!--
                  Свёрнутый вид: одна строка-сводка вместо полей. Это кнопка, а не TextBlock:
                  щелчок по всей надписи разворачивает блок той же командой, что и шеврон.
                  Видимость обратна развёрнутому блоку, а текст собирает модель — с датами,
                  числом в скобках или знаком бесконечности. TextTrimming остался у TextBlock
                  внутри кнопки: длинная сводка обрезается, как и раньше.
                -->
                <Button x:Name="FilterSummaryButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ToolTip="{Binding FiltersToggleText}"
                        Command="{Binding ToggleFiltersCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterSummaryLink}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiltersExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding FilterSummary}"
                               TextTrimming="CharacterEllipsis" />
                </Button>
            </Grid>

            <!--
              Заголовок виден только при свёрнутом фильтре: в развёрнутом виде на его месте
              фильтры, и подпись дублировала бы название из полосы окна. Центрируется по средней
              колонке — то есть между правым краем фильтра и шестерёнкой.
            -->
            <TextBlock x:Name="HeaderTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="{Binding Title}"
                       FontSize="{DynamicResource TitleSize}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiltersExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--
              Шестерёнка «Параметры…»: на стекле; Fill пути привязан к Foreground
              кнопки — состояния (наведение, нажатие, отключение) красят иконку из
              триггеров стиля вместе с текстом.
            -->
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Padding="8"
                    VerticalAlignment="Center"
                    Style="{StaticResource GlassButtonIconSoft}"
                    Focusable="False"
                    ToolTip="Параметры"
                    Click="OnSettingsButtonClick"
                    helpers:Hotkey.Id="Main.SettingsMenu"
                    ContextMenu="{StaticResource SettingsMenu}">
                <Button.Content>
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z" />
                </Button.Content>
            </Button>
        </Grid>

        <!--
          Линия над списком дней: стоит сразу над ScrollViewer, поэтому зазор 16 px остаётся над
          ней, а не после неё. Высоты задаёт сама рамка — у Border без содержимого это толщина
          границы.

          Отрицательные отступы по бокам снимают отступ корневой сетки; они безопасны, потому что
          обрезает только само окно. Отступ на детей намеренно не переносится: он один на всё окно,
          и на него же опирается правило положения подсказки.
        -->
        <Border Grid.Row="2"
                Margin="-16,16,-16,0"
                BorderBrush="{DynamicResource LineSoft}"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />

        <!--
          Область дней снимает с себя отступ корневой сетки по бокам: полоса прокрутки живёт внутри
          ScrollViewer, и прижать её к краю окна иначе нечем. Отступ не пропал, а переехал внутрь
          строки дня, поэтому дата, подписи и числа остались на прежних местах — и с полосой, и без
          неё.
        -->
        <Grid Grid.Row="3"
              Margin="-16,0,-16,0">
            <!--
          Список фокусируем и гасим его стрелочную навигацию. Фокус — цель для BlurOnKeys:
          Esc и Enter уводят клавиатурный фокус с поля количества дней сюда. Продвижение
          выделения стрелками ведёт окно целиком (OnWindowPreviewKeyDown): туннель у корня
          маршрута доходит до обработчика при любом фокусе и гасит нажатие прежде, чем
          ScrollViewer успел прокрутить содержимое всплывающей стрелкой. DirectionalNavigation=None
          держит про запас неназначенные стрелки: без значения по умолчанию (Continue) они
          перескакивали бы фокусом по кнопкам строк, «как по tab», вместо честного скролла
          содержимого.

          ScrollViewer живёт в шаблоне списка, а не над ним (ловушка 38): иначе высота списка не
          ограничена, панель строила бы все дни разом, и журнал на сотни дней тормозил бы каждым
          перечитыванием. В шаблоне связка ScrollViewer + ItemsPresenter + CanContentScroll
          работает как у ListBox'а: строится только видимое, а контейнеры при прокрутке
          переиспользуются (Recycling), и строка дня на сотни элементов стоит единицы миллисекунд.
          Попиксельная единица (ScrollUnit) держит прокрутку плавной: дни разной высоты,
          и пошаговая прокрутка дёргала бы их целиком.
        -->
            <ItemsControl x:Name="DaysList"
                          ItemsSource="{Binding Days}"
                          Focusable="True"
                          kb:KeyboardNavigation.DirectionalNavigation="None"
                          helpers:RowSelection.Enabled="True"
                          MouseDoubleClick="OnDayDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <!--
                          Прокрутка по обеим осям: ширина дня не зависит от ширины окна, и длинный
                          день просто обрезался бы. Зазор слева от полосы — тот же ScrollBarGutter,
                          а отступ строки справа живёт отдельно и снимается конвертером.

                          Имя нужно окну: скролл живёт в шаблоне, и взять его можно только по имени
                          шаблона — журнал держит место при перечитывании (OnDaysChanged).
                        -->
                        <helpers:RowScrollViewer x:Name="DaysScroll"
                                              helpers:ScrollBarGutter.Left="2"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </helpers:RowScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Пять строк дня: план, упражнения, вес, повторения и примечание. Дата стоит
                              в своей колонке и задаёт день, а не упражнение; в этой же колонке —
                              подписи «Вес», «Повторения» и «Примечание».

                              Столбцы упражнений, весов, повторений и примечаний — четыре
                              горизонтальных списка, а не Grid с колонками: число столбцов у дня равно
                              числу подходов, а динамические ColumnDefinition'ы разъезжались бы по
                              ширине. Ширину ячейки задаёт модель, поэтому вес стоит ровно над своим
                              повторением, а столбцы совпадают.

                              По блоку кликается целиком. Два клика открывают правку дня, правый — меню
                              с одним пунктом, а двойной подписан на список дней, а не на Border: у
                              Border нет MouseDoubleClick, и клик мимо строк открыл бы правку не на том
                              дне. Строка дня находится по элементу под мышью штатным
                              ContainerFromElement.

                              Две рамки, а не одна: внешняя ловит мышь, внутренняя держит вид. Внешняя
                              без заливки не ловила бы мышь там, где ничего не нарисовано, и пустые
                              ячейки пропускали бы нажатие насквозь. MinWidth нужен потому, что строка
                              меряется бесконечной шириной (горизонтальная прокрутка), а брать её у
                              ScrollViewer нельзя: строка уехала бы под полосу.

                              Внутренняя рамка — прежняя строка дня целиком: отступ 16 px переехал на
                              неё, потому что полоса прокрутки живёт внутри ScrollViewer и к краю
                              окна прижимается только вместе с ним.

                              Единственное, что здесь меняется, — правый отступ рамки: пока полоса на
                              экране, его нет, иначе полоса читалась бы оторванной от содержимого.
                              Источник — ComputedVerticalScrollBarVisibility, то есть фактическое
                              состояние полосы; писать отступ обратно нельзя, поэтому режим привязки
                              не указан.
                            -->

                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    ContextMenu="{StaticResource DayContextMenu}"
                                    ContextMenuOpening="OnDayContextMenuOpening">
                                <!--
                                  Выделение строки кликом — на внешней рамке: она тянется на всю
                                  ширину строки, а внутренняя начинается после отступа 16 px, и
                                  подсветка на ней оставляла бы слева незакрашенное поле. Прозрачный
                                  фон живёт стилем, а не атрибутом: локальное значение перекрыло
                                  бы сеттер триггера.
                                -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <!--
                                              Признак выделения живёт на элементе данных, а не на
                                              контейнере: контейнеры переиспользуются панелью, и
                                              оставленный на контейнере признак подсветил бы чужую
                                              строку (ISelectableRow).
                                            -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHighlight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Margin="{Binding ComputedVerticalScrollBarVisibility,
                                                             RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                             Converter={StaticResource ScrollBarMargin},
                                                             ConverterParameter=16}"
                                        Padding="0,10,0,10"
                                        BorderBrush="{DynamicResource LineSoft}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--
                                          Дата стоит в колонке вместе с подписями «Вес» и «Повторения»
                                          и задаёт её ширину: она одинакова у всех дней, а подписи
                                          короче — поэтому они прижаты к своим значениям вправо. Больше
                                          дата не на все строки: под ней пусто, и это сделано
                                          сознательно — упражнения сдвинуты влево.
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Top"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DateText}" />

                                        <!--
                                          Название плана не натянуто на две колонки: в сетке под
                                          бесконечной шириной элемент, перекрывающий несколько
                                          Auto-колонок, отдаёт лишнюю ширину по ним, и длинное название
                                          раздвигало колонку подписей, а с ней всю таблицу вправо.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Margin="0,0,0,6"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding PlanName}" />

                                        <!--
                                          Подложка строки «Вес»: строка должна читаться как отдельная,
                                          поэтому подпись и её значения лежат на полосе чуть темнее
                                          фона. Элемент пустой, поэтому строка Auto от него не растёт.

                                          Объявлена раньше списка границ не по смыслу, а по порядку
                                          отрисовки: в Grid рисуется последним объявленным, и полоса
                                          рядом со своей строкой закрыла бы сквозные линии упражнений.

                                          Подложка — токен SurfaceAlt, а не системная кисть: фон
                                          окна того же холодного семейства, и ControlBrush на нём
                                          была бы неотличима от самой подложки. Токен тёмная тема
                                          потемнеет сама, и разнонаправленные решения уйдут.
                                        -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="{DynamicResource SurfaceAlt}"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Подложка строки «Примечание» — та же полоса и по той же
                                          причине: строка читается как отдельная. Объявлена здесь, а не
                                          рядом со своим списком, по порядку отрисовки.
                                        -->
                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="{DynamicResource SurfaceAlt}"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Упражнение читается как блок: название — заголовок над своими
                                          столбцами, по краям блока — вертикальные линии.

                                          Границы и названия — два списка по одному Exercises, и это
                                          единственный способ получить сквозную линию рядом с названием:
                                          элемент, который держит название, живёт ровно в одной строке и
                                          выше неё рамку не нарисует. Список границ натянут
                                          Grid.RowSpan на четыре строки, а VerticalContentAlignment
                                          обязателен: у ItemsControl содержимое выравнивается вверх,
                                          панель меряется под своё содержимое, и без растяжения линии
                                          дошли бы только до шапки (ловушки 51 и 50).

                                          Ширину блока даёт модель, и по той же формуле считаются
                                          столбцы веса и повторений, поэтому обе линии попадают точно на
                                          внешние края столбцов своего упражнения — разбирать в
                                          разметке, где кончается упражнение, не нужно.

                                          Список границ объявлен первым, то есть рисуется под
                                          названиями: обе линии в шапке ложатся на одни пиксели, и полосы
                                          вдвое не получается. Он же IsHitTestVisible=False.

                                          Общая граница соседних упражнений — две линии вплотную, то
                                          есть полоса вдвое шире одиночной рамки у края дня.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      Grid.RowSpan="4"
                                                      VerticalContentAlignment="Stretch"
                                                      IsHitTestVisible="False"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            BorderBrush="{DynamicResource LineSoft}"
                                                            BorderThickness="1,0,1,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Название стоит в своей строке и по центру именно этой
                                          строки, а не своей высоты: строка Auto растёт под самое
                                          длинное название дня, и VerticalAlignment ставит по её
                                          середине все названия, включая короткие. По умолчанию у
                                          TextBlock Stretch, и с ним название снова прижалось бы к
                                          верху строки.

                                          TextAlignment центрирует строки внутри заданной ширины.
                                          HorizontalAlignment на самом TextBlock не ставится: по
                                          ловушке 35 центрированный элемент меряется под своё
                                          содержимое, и перенос перестаёт работать. Ширину задаёт
                                          Border, и она равна ширине блока упражнения — той же, что
                                          занимают его подходы.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="6,0"
                                                            BorderBrush="{DynamicResource LineSoft}"
                                                            BorderThickness="1,0,1,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Подписи «Вес» и «Повторения» стоят в колонке даты и прижаты
                                          вправо: колонку задаёт дата (около 170 px), а «Повторения»
                                          занимает около 68, и оставшись слева, подписи оторвались бы от
                                          чисел. Собственный Margin справа — зазор до значений:
                                          расстояние задаётся на самих соседях (ловушка 48).

                                          Значение центрирует TextAlignment, то есть строки внутри
                                          заданной ширины. HorizontalAlignment у значений бесполезен:
                                          слот у ребёнка горизонтального StackPanel равен
                                          DesiredSize.Width, а Width и есть это самое желаемое
                                          (ловушка 50), а центрировать сам элемент нельзя — он меряется
                                          под своё содержимое (ловушка 35).
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="2"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Вес" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="2"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding WeightText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="3"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Повторения" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="3"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding RepetitionText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="4"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Примечание" />

                                        <!--
                                          Примечание принадлежит упражнению, а не подходу, поэтому это ещё
                                          один горизонтальный список по Exercises в своей строке. Ширина
                                          блока — та же, что у названия и столбцов подходов, поэтому
                                          кнопка «Показать» растягивается ровно на колонки своего
                                          упражнения.

                                          Показывается кнопкой, потому что текст примечания коротким не
                                          бывает: в строку журнала он не помещается, а подсказкой
                                          показывается по требованию. Без примечания на его месте
                                          прочерк: пустоты в строке быть не должно.

                                          Своих боковых рамок у ячейки нет: вертикальные линии блока идут
                                          сквозными от первого списка — ещё одна пара линий на том же месте
                                          была бы просто вдвое темнее. Вид по наличию примечания задан
                                          DataTrigger, а не конвертером: правило одно на оба места с
                                          маркерами в окне дня (ловушка 54).

                                          Кнопка объявлена раньше прочерка, а прочерк занимает всю рамку:
                                          в Grid рисуется последним объявленным, и нажатие по прочерку
                                          должно доходить до кнопки под ним.

                                          Своим MouseDoubleClick кнопка не гасит: двойной клик по ней —
                                          это перечитывание примечания, и правку дня открывать он не
                                          должен, но событие поднимается от элемента под указателем.
                                          Поэтому двойной клик разбирается в OnDayDoubleClick
                                          (ловушка 45).
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="4"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="1,2">
                                                        <Grid>
                                                            <Button Padding="1,1"
                                                                    Click="OnShowNoteClick"
                                                                    helpers:Hotkey.Id="Main.ShowNote">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>

                                                                <!--
                                                                  Обрезка, а не перенос: при одном подходе
                                                                  блок узок (CellWidth = 60), и надпись
                                                                  шириной блока вышла бы за край на
                                                                  соседнее упражнение. Обрезка работает
                                                                  только без переноса, поэтому перенос
                                                                  здесь не задан (ловушка 44).
                                                                -->
                                                                <TextBlock Text="Показать"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Button>

                                                            <!--
                                                              Прочерк по центру блока, а
                                                              HorizontalAlignment="Center" на нём
                                                              бесполезен: слот у ребёнка рамки с
                                                              заданной шириной совпадает с ней самой,
                                                              а центрирует TextAlignment (ловушка 50).
                                                              Тон бледный — примечания нет, и читаться
                                                              это должно как пустота, а не как значение.
                                                            -->
                                                            <TextBlock Foreground="{DynamicResource TextSecondary}"
                                                                       Text="—"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       IsHitTestVisible="False"
                       Text="{Binding EmptyText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!--
          Кнопка «Добавить день» по мокапу docs/glassButtonSoftStates.svg, стиль
          AddDayButtonSoft (радиус 2) — в Themes/GlassButton.xaml: четыре состояния (обычное, наведённое,
          нажатая, недоступная) и мягкие торцы вместо прямых (то же при радиусом 2, что и в
          скруглённом варианте — 4). Иконку «+» несет содержимое: Stroke привязан
          к Foreground кнопки, и триггеры состояний красят иконку вместе с текстом.
        -->
        <Button Grid.Row="4"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource AddDayButtonSoft}"
                Command="{Binding AddDayCommand}"
                helpers:Hotkey.Id="Main.AddDay">
            <!--
              Колонки по содержимому, не '*' : при авто-ширине кнопки '*' мерялась бы по
              доступному месту окна, и кнопка растянулась бы на всю ячейку. Иконка и надпись
              задают ширину, а минимум 216 из стиля сохраняет габарит мокапа при 100 %.
              Правый отступ надписи 42 (= 16 отступа иконки + 10 иконка + 16 зазор) балансирует
              левую группу: с полями шаблона по 6 слева и справа надпись стоит по центру кнопки.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Width="10"
                      Height="10"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Data="M1,5 H9 M5,1 V9"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square" />

                <TextBlock Grid.Column="1"
                           Margin="16,0,42,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Добавить день" />
            </Grid>
        </Button>

<!--
          Подсказка окна — тот же контрол, что в окне дня: нарисована поверх содержимого и ничего не
          сдвигает (ловушки 43 и 40). Показываются ею два разных сообщения — отказ по вводу в
          «Количество дней» и примечание упражнения по кнопке «Показать»; тон и срок задаёт модель
          (Hint.Kind и Hint.Lifetime).

          Якоря в разметке нет: окно переставляет его с поля на кнопку и обратно, а привязка на этом
          свойстве невозможна — локальное присваивание заменило бы её навсегда (ловушка 11).

          Стоит последним и с Panel.ZIndex: порядок отрисовки задаётся ZIndex среди соседей, и из
          шапки подсказка не смогла бы перекрыть ни список дней, ни нижние кнопки.
        -->
        <helpers:StatusHint x:Name="InputHint"
                            Panel.ZIndex="10"
                            ClosedCommand="{Binding Hint.ClearCommand}"
                            DismissCommand="{Binding Hint.DismissCommand}"
                            IsOpen="{Binding Hint.IsVisible}"
                            Kind="{Binding Hint.Kind}"
                            Lifetime="{Binding Hint.Lifetime}"
                            Text="{Binding Hint.Text}" />

        <!--
          Рамка окна: системную снял WindowChrome, и окно сливалось со светлым столом.
          Элемент-обводка поверх содержимого: отрицательные отступы снимают отступ корневой
          сетки — тот же приём, что у полосы заголовка; IsHitTestVisible=False не перехватывает
          ни мышь у краёв, ни полосу захвата. На развёрнутом окне рама гасится стилем.
        -->
        <Border Grid.RowSpan="5"
                Margin="-16,-16,-16,-16"
                IsHitTestVisible="False"
                Style="{StaticResource WindowFrame}" />
    </Grid>
</Window>
