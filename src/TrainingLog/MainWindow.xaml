<Window x:Class="TrainingLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrainingLog.ViewModels"
        xmlns:helpers="clr-namespace:TrainingLog.Controls"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="560"
        Width="900"
        MinWidth="640"
        MinHeight="360">
    <Window.Resources>
        <ContextMenu x:Key="SettingsMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Упражнения"
                      Command="{Binding OpenExercisesCommand}" />

            <MenuItem Header="Планы"
                      Command="{Binding OpenPlansCommand}" />

            <!--
              Параметры отделены разделителем и стоят последними: это единственный пункт, который
              не открывает справочник, а меняет само приложение. Разделитель объявлен в меню, а не
              сделан отступом у пункта — иначе отступ остался бы висеть в воздухе.
            -->
            <Separator />

            <MenuItem Header="Параметры…"
                      Command="{Binding OpenSettingsCommand}" />
        </ContextMenu>

        <!--
          Меню строки дня. DataContext задаётся не здесь, а при открытии, в
          OnDayContextMenuOpening: у ContextMenu отдельное логическое дерево, и до окна
          добраться из него нельзя (ловушка 41). Поэтому и команда, и её параметр приходят
          сверху — из открывающего кода, а не привязкой.

          Контекстное меню открывается само по правому клику в любом месте строки:
          ContextMenuService находит меню у элемента под мышью и поднимается вверх, поэтому
          клик по названию плана или по столбцу подхода попадает в меню дня.

          Побочный эффект тот же, что у меню шестерёнки: пока меню открыто, окно не получает
          наведения (ловушка 34). В строке дня наведения нет, так что это видно только по
          курсору.
        -->
        <ContextMenu x:Key="DayContextMenu">
            <MenuItem Header="Редактировать"
                      Command="{Binding EditDayCommand}" />
        </ContextMenu>

        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
          Отступ рамки строки дня по состоянию полосы: пока полоса на экране, правый отступ
          снимается. Величина приходит параметром конвертера, поэтому он ничего не знает про
          отступы окна.
        -->
        <helpers:ScrollBarMarginConverter x:Key="ScrollBarMargin" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding Title}" />

            <!--
              Сколько дней показывать — рядом с заголовком, а не внизу: это настройка показа, а не
              действие над записью. Значение применяется кнопкой, поэтому поле не меняет список само.
              Пустое или негодное поле гасит «Применить»; AllowedCharsInput оставляет только цифры,
              поэтому «мусор» здесь — пустое поле и значение за пределом DaysCountRules, оба случая
              гасят кнопку.

              Background="Transparent" у подписи обязателен: без фона она попадает под мышь только по
              самим буквам, и клик по пробелу не передал бы фокус (ловушка 13).
            -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Background="Transparent"
                           VerticalAlignment="Center"
                           Text="Количество дней"
                           helpers:ClickToFocus.Target="{Binding ElementName=DaysCountBox}" />

                <TextBox x:Name="DaysCountBox"
                         Width="52"
                         Margin="8,0,0,0"
                         Padding="4,3"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         helpers:AllowedCharsInput.Allowed="Digits"
                         Text="{Binding DaysCount, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--
              Enter применяет количество дней. IsDefault, а не горячая клавиша: KeyBinding в проекте
              занят под Ctrl+S, а оба механизма на одной кнопке означали бы двойное выполнение. До
              кнопки Enter доходит сам: фильтр цифр глотает в PreviewKeyDown только пробел, а
              AcceptsReturn у поля не задан.
            -->
            <Button Grid.Column="3"
                    Margin="0,0,12,0"
                    Padding="14,4"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    Command="{Binding ApplyCommand}"
                    Content="Применить" />

            <Button x:Name="SettingsButton"
                    Grid.Column="4"
                    Padding="8"
                    VerticalAlignment="Center"
                    Focusable="False"
                    ToolTip="Параметры"
                    Click="OnSettingsButtonClick"
                    ContextMenu="{StaticResource SettingsMenu}">
                <Button.Content>
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                          Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z" />
                </Button.Content>
            </Button>
        </Grid>

        <!--
          Линия над списком дней: стоит сразу над ScrollViewer, поэтому зазор 16 px остаётся над
          ней, а не после неё. Высоты задаёт сама рамка — у Border без содержимого это толщина
          границы.

          Отрицательные отступы по бокам снимают отступ корневой сетки; они безопасны, потому что
          обрезает только само окно. Отступ на детей намеренно не переносится: он один на всё окно,
          и на него же опирается правило положения подсказки.
        -->
        <Border Grid.Row="1"
                Margin="-16,16,-16,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />

        <!--
          Область дней снимает с себя отступ корневой сетки по бокам: полоса прокрутки живёт внутри
          ScrollViewer, и прижать её к краю окна иначе нечем. Отступ не пропал, а переехал внутрь
          строки дня, поэтому дата, подписи и числа остались на прежних местах — и с полосой, и без
          неё.
        -->
        <Grid Grid.Row="2"
              Margin="-16,0,-16,0">
            <!--
          Прокрутка по обеим осям: ширина дня не зависит от ширины окна, и длинный день просто
          обрезался бы. Зазор слева от полосы — тот же ScrollBarGutter, а отступ строки справа живёт
          отдельно и снимается конвертером.
        -->
        <ScrollViewer helpers:ScrollBarGutter.Left="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Days}"
                              MouseDoubleClick="OnDayDoubleClick">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Пять строк дня: план, упражнения, вес, повторения и примечание. Дата стоит
                              в своей колонке и задаёт день, а не упражнение; в этой же колонке —
                              подписи «Вес», «Повторения» и «Примечание».

                              Столбцы упражнений, весов, повторений и примечаний — четыре
                              горизонтальных списка, а не Grid с колонками: число столбцов у дня равно
                              числу подходов, а динамические ColumnDefinition'ы разъезжались бы по
                              ширине. Ширину ячейки задаёт модель, поэтому вес стоит ровно над своим
                              повторением, а столбцы совпадают.

                              По блоку кликается целиком. Два клика открывают правку дня, правый — меню
                              с одним пунктом, а двойной подписан на список дней, а не на Border: у
                              Border нет MouseDoubleClick, и клик мими строк открыл бы правку не на том
                              дне. Строка дня находится по элементу под мышью штатным
                              ContainerFromElement.

                              Две рамки, а не одна: внешняя ловит мышь, внутренняя держит вид. Внешняя
                              без заливки не ловила бы мышь там, где ничего не нарисовано, и пустые
                              ячейки пропускали бы нажатие насквозь. MinWidth нужен потому, что строка
                              меряется бесконечной шириной (горизонтальная прокрутка), а брать её у
                              ScrollViewer нельзя: строка уехала бы под полосу.

                              Внутренняя рамка — прежняя строка дня целиком: отступ 16 px переехал на
                              неё, потому что полоса прокрутки живёт внутри ScrollViewer и к краю
                              окна прижимается только вместе с ним.

                              Единственное, что здесь меняется, — правый отступ рамки: пока полоса на
                              экране, его нет, иначе полоса читалась бы оторванной от содержимого.
                              Источник — ComputedVerticalScrollBarVisibility, то есть фактическое
                              состояние полосы; писать отступ обратно нельзя, поэтому режим привязки
                              не указан.
                            -->

                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Background="Transparent"
                                    ContextMenu="{StaticResource DayContextMenu}"
                                    ContextMenuOpening="OnDayContextMenuOpening">
                                <Border Margin="{Binding ComputedVerticalScrollBarVisibility,
                                                             RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                             Converter={StaticResource ScrollBarMargin},
                                                             ConverterParameter=16}"
                                        Padding="0,10,0,10"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--
                                          Дата стоит в колонке вместе с подписями «Вес» и «Повторения»
                                          и задаёт её ширину: она одинакова у всех дней, а подписи
                                          короче — поэтому они прижаты к своим значениям вправо. Больше
                                          дата не на все строки: под ней пусто, и это сделано
                                          сознательно — упражнения сдвинуты влево.
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Top"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DateText}" />

                                        <!--
                                          Название плана не натянуто на две колонки: в сетке под
                                          бесконечной шириной элемент, перекрывающий несколько
                                          Auto-колонок, отдаёт лишнюю ширину по ним, и длинное название
                                          раздвигало колонку подписей, а с ней всю таблицу вправо.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Margin="0,0,0,6"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding PlanName}" />

                                        <!--
                                          Подложка строки «Вес»: строка должна читаться как отдельная,
                                          поэтому подпись и её значения лежат на полосе чуть темнее
                                          фона. Элемент пустой, поэтому строка Auto от него не растёт.

                                          Объявлена раньше списка границ не по смыслу, а по порядку
                                          отрисовки: в Grid рисуется последним объявленным, и полоса
                                          рядом со своей строкой закрыла бы сквозные линии упражнений.

                                          Оттенок зашит, а не взят системной кистью: фон окна сам
                                          ControlBrush, и такая кисть была бы неотличима от подложки.
                                          В тёмной теме полоса станет светлой — в окне дня фон поля
                                          белый, здесь фон окна серый, и решения разнонаправленные.
                                        -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="#E6E6E6"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Подложка строки «Примечание» — та же полоса и по той же
                                          причине: строка читается как отдельная. Объявлена здесь, а не
                                          рядом со своим списком, по порядку отрисовки.
                                        -->
                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Background="#E6E6E6"
                                                IsHitTestVisible="False" />

                                        <!--
                                          Упражнение читается как блок: название — заголовок над своими
                                          столбцами, по краям блока — вертикальные линии.

                                          Границы и названия — два списка по одному Exercises, и это
                                          единственный способ получить сквозную линию рядом с названием:
                                          элемент, который держит название, живёт ровно в одной строке и
                                          выше неё рамку не нарисует. Список границ натянут
                                          Grid.RowSpan на четыре строки, а VerticalContentAlignment
                                          обязателен: у ItemsControl содержимое выравнивается вверх,
                                          панель меряется под своё содержимое, и без растяжения линии
                                          дошли бы только до шапки (ловушки 40 и 39).

                                          Ширину блока даёт модель, и по той же формуле считаются
                                          столбцы веса и повторений, поэтому обе линии попадают точно на
                                          внешние края столбцов своего упражнения — разбирать в
                                          разметке, где кончается упражнение, не нужно.

                                          Список границ объявлен первым, то есть рисуется под
                                          названиями: обе линии в шапке ложатся на одни пиксели, и полосы
                                          вдвое не получается. Он же IsHitTestVisible=False.

                                          Общая граница соседних упражнений — две линии вплотную, то
                                          есть полоса вдвое шире одиночной рамки у края дня.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      Grid.RowSpan="4"
                                                      VerticalContentAlignment="Stretch"
                                                      IsHitTestVisible="False"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            BorderBrush="#E0E0E0"
                                                            BorderThickness="1,0,1,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Название стоит в своей строке и по центру именно этой
                                          строки, а не своей высоты: строка Auto растёт под самое
                                          длинное название дня, и VerticalAlignment ставит по её
                                          середине все названия, включая короткие. По умолчанию у
                                          TextBlock Stretch, и с ним название снова прижалось бы к
                                          верху строки.

                                          TextAlignment центрирует строки внутри заданной ширины.
                                          HorizontalAlignment на самом TextBlock не ставится: по
                                          ловушке 29 центрированный элемент меряется под своё
                                          содержимое, и перенос перестаёт работать. Ширину задаёт
                                          Border, и она равна ширине блока упражнения — той же, что
                                          занимают его подходы.
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="1"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="6,0"
                                                            BorderBrush="#E0E0E0"
                                                            BorderThickness="1,0,1,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                          Подписи «Вес» и «Повторения» стоят в колонке даты и прижаты
                                          вправо: колонку задаёт дата (около 170 px), а «Повторения»
                                          занимает около 68, и оставшись слева, подписи оторвались бы от
                                          чисел. Собственный Margin справа — зазор до значений:
                                          расстояние задаётся на самих соседях (ловушка 37).

                                          Значение центрирует TextAlignment, то есть строки внутри
                                          заданной ширины. HorizontalAlignment у значений бесполезен:
                                          слот у ребёнка горизонтального StackPanel равен
                                          DesiredSize.Width, а Width и есть это самое желаемое
                                          (ловушка 39), а центрировать сам элемент нельзя — он меряется
                                          под своё содержимое (ловушка 29).
                                        -->
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="2"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Вес" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="2"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding WeightText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="3"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Повторения" />

                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="3"
                                                      ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Width="{Binding CellWidth}"
                                                               TextAlignment="Center"
                                                               Text="{Binding RepetitionText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="4"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,12,0"
                                                   Text="Примечание" />

                                        <!--
                                          Примечание принадлежит упражнению, а не подходу, поэтому это ещё
                                          один горизонтальный список по Exercises в своей строке. Ширина
                                          блока — та же, что у названия и столбцов подходов, поэтому
                                          кнопка «Показать» растягивается ровно на колонки своего
                                          упражнения.

                                          Показывается кнопкой, потому что текст примечания коротким не
                                          бывает: в строку журнала он не помещается, а подсказкой
                                          показывается по требованию. Без примечания на его месте
                                          прочерк: пустоты в строке быть не должно.

                                          Своих боковых рамок у ячейки нет: вертикальные линии блока идут
                                          сквозными от первого списка — ещё одна пара линий на том же месте
                                          была бы просто вдвое темнее. Вид по наличию примечания задан
                                          DataTrigger, а не конвертером: правило одно на оба места с
                                          маркерами в окне дня (ловушка 43).

                                          Кнопка объявлена раньше прочерка, а прочерк занимает всю рамку:
                                          в Grid рисуется последним объявленным, и нажатие по прочерку
                                          должно доходить до кнопки под ним.

                                          Своим MouseDoubleClick кнопка не гасит: двойной клик по ней —
                                          это перечитывание примечания, и правку дня открывать он не
                                          должен, но событие поднимается от элемента под указателем.
                                          Поэтому двойной клик разбирается в OnDayDoubleClick
                                          (ловушка 45).
                                        -->
                                        <ItemsControl Grid.Column="1"
                                                      Grid.Row="4"
                                                      ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Padding="1,2">
                                                        <Grid>
                                                            <Button Padding="1,1"
                                                                    FontSize="11"
                                                                    Click="OnShowNoteClick">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />

                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>

                                                                <!--
                                                                  Обрезка, а не перенос: при одном подходе
                                                                  блок узок (CellWidth = 60), и надпись
                                                                  шириной блока вышла бы за край на
                                                                  соседнее упражнение. Обрезка работает
                                                                  только без переноса, поэтому перенос
                                                                  здесь не задан (ловушка 36).
                                                                -->
                                                                <TextBlock Text="Показать"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Button>

                                                            <!--
                                                              Прочерк по центру блока, а
                                                              HorizontalAlignment="Center" на нём
                                                              бесполезен: слот у ребёнка рамки с
                                                              заданной шириной совпадает с ней самой,
                                                              а центрирует TextAlignment (ловушка 39).
                                                              Тон бледный — примечания нет, и читаться
                                                              это должно как пустота, а не как значение.
                                                            -->
                                                            <TextBlock Foreground="Gray"
                                                                       Text="—"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       Text="Записей пока нет"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Button Grid.Row="3"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Padding="14,4"
                Command="{Binding AddDayCommand}"
                Content="Добавить день" />

<!--
          Подсказка окна — тот же контрол, что в окне дня: нарисована поверх содержимого и ничего не
          сдвигает (ловушки 34 и 32). Показываются ею два разных сообщения — отказ по вводу в
          «Количество дней» и примечание упражнения по кнопке «Показать»; тон и срок задаёт модель
          (Hint.Kind и Hint.Lifetime).

          Якоря в разметке нет: окно переставляет его с поля на кнопку и обратно, а привязка на этом
          свойстве невозможна — локальное присваивание заменило бы её навсегда (ловушка 11).

          Стоит последним и с Panel.ZIndex: порядок отрисовки задаётся ZIndex среди соседей, и из
          шапки подсказка не смогла бы перекрыть ни список дней, ни нижние кнопки.
        -->
        <helpers:StatusHint x:Name="InputHint"
                            Panel.ZIndex="10"
                            ClosedCommand="{Binding Hint.ClearCommand}"
                            DismissCommand="{Binding Hint.DismissCommand}"
                            IsOpen="{Binding Hint.IsVisible}"
                            Kind="{Binding Hint.Kind}"
                            Lifetime="{Binding Hint.Lifetime}"
                            Text="{Binding Hint.Text}" />
    </Grid>
</Window>
