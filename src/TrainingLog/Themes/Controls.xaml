<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:TrainingLog.Controls">
    <!--
      Единый вид контролов: поля, галочки, комбобоксы, кнопки строк, подсказки, меню,
      вкладки, спойлеры, прокрутка. Неявные стили (без x:Key): любой TextBox/CheckBox/... в окне и в отдельном
      дереве попапа получает их сам.

      Все ссылки на палитру — DynamicResource: PopupRoot не поднимается вверх по дереву к
      Window, а словарь вливается и на уровне приложения — так работает и сверху (окно), и
      снизу (попапы). StaticResource внутри этого файла — только для ресурсов, объявленных
      выше в нём же.

      Не поддерживается (и не используется): IsEditable у ComboBox (шаблон без TextBox-editor),
      ExpandDirection кроме Down у Expander (внутри списка планов только Down).
    -->

    <!--
      Сдвиг шеврона Expander'а к видимому центру строки: считает ExpanderChrome.AlignOffset
      по FontFamily и FontSize, объявлен внутри шаблона ниже по правилу StaticResource.
    -->
    <helpers:FontCenterOffsetConverter x:Key="FontCenterOffset" />

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="8,5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox: белое поле с рамкой до наведения; фокус подсвечивает рамку, а не подложку -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowHighlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Button: плоская мини-кнопка для ячеек таблиц («Показать» в строке упражнения).
      Без MinHeight, жирного шрифта и широких полей — стеклянная обёртка раздувает ряд;
      габарит задаёт место вызова. Неявный стиль не трогает крупные кнопки: у них явный
      Style по ключам из GlassButton.xaml, который перекрывает неявный.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="Transparent" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: галочка на белом квадрате; content в отдельном столбце, квадрат прижат к первой строке -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!--
                          Квадрат и подпись центрируются относительно друг друга: окно ставит
                          сам контрол в центр строки, и прижатый к верху квадрат с запасом
                          съезжал ниже центра строки текста. Центр — поведение системного
                          шаблона; у многострочных подписей квадрат встаёт по центру блока.
                        -->
                        <Border x:Name="Box"
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource FieldBorder}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <!-- Рычажок Path, а не «✓» глифом шрифта: рисунок в любой гарнитуре одинаковый -->
                            <Path x:Name="Check"
                                  Data="M 2.5,7 L 5.5,10 L 10.5,4"
                                  Stroke="{DynamicResource AccentStrong}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Hidden" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: белое поле + стрелка; выпадающий список — отдельное окно с белой рамкой -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Правое поле больше стрелки: подписи выбранных пунктов не наезжают на неё -->
        <Setter Property="Padding" Value="7,2,18,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Path x:Name="Arrow"
                              Width="9"
                              Height="6"
                              HorizontalAlignment="Right"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center"
                              Data="M 0,0 L 4.5,4.5 L 9,0"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" />
                        <!--
                          Переключатель клика. Сам ComboBox по клику поле не открывает: в
                          поставляемых шаблонах это делает ToggleButton, чей IsChecked записан
                          в IsDropDownOpen двусторонней привязкой. Прозрачный и без своего вида:
                          рисуют рамка и стрелка ниже по Z; Focusable=False, чтобы фокус брал
                          ComboBox напоказ.
                        -->
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,2,0,6"
                                    Background="{DynamicResource FieldBackground}"
                                    BorderBrush="{DynamicResource LineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="0,2"
                                    SnapsToDevicePixels="True">
                                <!--
                                  CanContentScroll обязателен: без него список шрифтов измеряет все
                                  виртуализованные пункты разом и первый показ зависает.
                                -->
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункты dropdown: подсветка наведения и клавиатуры одна (IsHighlighted — и то и другое) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Frame"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu / ContextMenu: верхняя полоса прозрачна, само меню — белая карточка с рамкой -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,2"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Пункты меню: четыре шаблона роли. Общий каркас — рамка с подсветкой наведения; различаются
      только Popup (у заголовков он есть, у просто пунктов нет), стрелка подменю и колонка
      сочетания клавиш. Иконки пунктов не рисуются: их нет ни в одном меню проекта.
    -->
    <ControlTemplate x:Key="MenuItemTopLevelHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Frame"
                    Background="Transparent"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Bottom">
                <Border Background="{DynamicResource FieldBackground}"
                        BorderBrush="{DynamicResource LineStrong}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="0,2"
                        SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemTopLevelItem" TargetType="MenuItem">
        <Border x:Name="Frame"
                Background="Transparent"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemSubmenuHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Frame"
                    Background="Transparent"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Grid.Column="0"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center" />

                    <TextBlock x:Name="GestureText"
                               Grid.Column="1"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{TemplateBinding InputGestureText}"
                               Visibility="Hidden" />

                    <Path Grid.Column="2"
                          Width="5"
                          Height="8"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right">
                <Border Background="{DynamicResource FieldBackground}"
                        BorderBrush="{DynamicResource LineStrong}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="0,2"
                        SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="GestureText" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Frame"
                Background="Transparent"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />

                <TextBlock x:Name="GestureText"
                           Grid.Column="1"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{TemplateBinding InputGestureText}"
                           Visibility="Hidden" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter TargetName="GestureText" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Умолчание — верхний заголовок; остальное подставляют триггеры роли -->
        <Setter Property="Template" Value="{DynamicResource MenuItemTopLevelHeader}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource MenuItemTopLevelItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource MenuItemSubmenuItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource MenuItemSubmenuHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="6,3"
                            Background="{DynamicResource LineSoft}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl / TabItem: плоские вкладки — выделенная на белом, линия раздела под ними -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Row="0"
                                  IsItemsHost="True" />
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource LineSoft}"
                                BorderThickness="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Frame"
                            Background="Transparent"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <!-- После наведения: у выделенной своя подложка, серое наведение не перекрывает -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource FieldBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Expander: шеврон поворачивается открытием, тело Expander' ниже. Только ExpandDirection=Down
      (в проекте другого нет), поэтому один шаблон вместо четырёх направленных.

      Тело фактонтно и шапке — Grid со строками Auto и *, а не StackPanel: StackPanel никогда не
      отдаёт содержимому остаток главной оси, и примечание окна дня, обязанное растянуться на
      *-строку редактора, рисуется в естественную одну строку, а запас высоты остаётся пустотой
      под телом. У Expander'ов с Auto-высотой (списки планов) вид не меняется: строка * измеряется
      как Auto, пока контент не растянут.
    -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderSite"
                                      Grid.Row="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <!--
                                          Поворот вокруг центра: без RenderTransformOrigin шеврон крутился
                                          вокруг точки (0,0) и при повороте улетал влево за пределы кнопки.
                                          Вертикальный сдвиг оптической доводки приходит по привязке из
                                          метрик предка-Expander'а (FontCenterOffset): бокс строки и видимый
                                          центр строки расходятся, и величина расхода меняется со шрифтом
                                          и кеглем, поэтому ручной сдвиг с места вызова на них не полагается.
                                        -->
                                        <Path x:Name="Chevron"
                                              Width="5"
                                              Height="9"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Data="M 0,0 L 4,4 L 0,8"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondary}"
                                              StrokeThickness="0">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform />
                                                    <TranslateTransform>
                                                        <TranslateTransform.Y>
                                                            <MultiBinding Converter="{StaticResource FontCenterOffset}">
                                                                <Binding Path="FontFamily"
                                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=Expander}" />
                                                                <Binding Path="FontSize"
                                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=Expander}" />
                                                            </MultiBinding>
                                                        </TranslateTransform.Y>
                                                    </TranslateTransform>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <!--
                                              Плавное вращение вместо мгновенного Setter'а.
                                              From в ExitActions фиксируем на 90: при деактивации триггера его
                                              Storyboard снимается и значение успевает упасть к базовому 0,
                                              поэтому без From выходная анимация была бы пустой (мгновенный рывок).
                                            -->
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                                                                         From="0" To="90"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                                                                         From="90" To="0"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Прокрутка: узкая полоса без стрелок — колесо и ползунок; цвет ползунка — линии,
      наведение темнее. Оба направления: ScrollViewer сам выбирает по Orientation.
    -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFrame"
                            Margin="3"
                            Background="{DynamicResource LineStrong}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFrame" Property="Background" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFrame" Property="Background" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbFrame" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="12" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="28"
                           Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Height="12" Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="28"
                           Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Неявный стиль переопределяет системный целиком: полосы прокрутки приложения везде свои -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
