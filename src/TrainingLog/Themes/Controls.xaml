<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:TrainingLog.Controls"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <!--
      Единый вид контролов: поля, галочки, комбобоксы, кнопки строк, подсказки, меню,
      вкладки, спойлеры, прокрутка. Неявные стили (без x:Key): любой TextBox/CheckBox/... в окне и в отдельном
      дереве попапа получает их сам.

      Все ссылки на палитру — DynamicResource: PopupRoot не поднимается вверх по дереву к
      Window, а словарь вливается и на уровне приложения — так работает и сверху (окно), и
      снизу (попапы). StaticResource внутри этого файла — только для ресурсов, объявленных
      выше в нём же.

      Не поддерживается (и не используется): IsEditable у ComboBox (шаблон без TextBox-editor),
      ExpandDirection кроме Down у Expander (внутри списка планов только Down).
    -->

    <!--
      Сдвиг шеврона Expander'а к видимому центру строки: считает ExpanderChrome.AlignOffset
      по FontFamily и FontSize, объявлен внутри шаблона ниже по правилу StaticResource.
    -->
    <helpers:FontCenterOffsetConverter x:Key="FontCenterOffset" />

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="8,5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox: белое поле с рамкой до наведения; фокус подсвечивает рамку, а не подложку -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowHighlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--
              Рамка фокуса — триггером стиля, а не шаблона. Триггер шаблона пишет цвет прямо в
              «Frame» и перекрывает любой стиль, а поле захвата горячих клавиш подсвечивается
              своей рамкой (CaptureBorder) — и перекрывать её нельзя: подсветка захвата была бы
              не видна вовсе.

              Порядок отсюда: производный стиль (захват) → базовый стиль (фокус) → значения
              стиля, поэтому золотая рамка захвата побеждает синюю фокусную.
            -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Кнопка календаря в поле даты: плоская иконка, как стрелка у ComboBox. Отдельный стиль
      и не стеклянный по двум причинам. Стеклянный недоступен: StaticResource внутри словаря
      видит только свои ресурсы, а стили кнопок лежат в GlassButton.xaml — соседнем словаре
      (у окон он виден, потому что разметка окна разбирается после слияния). И стекло здесь
      было бы пятном: кнопка — часть поля, а не действие.
    -->
    <Style x:Key="DatePickerButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Крестик очистки даты: та же плоская «стеклянная» кнопка, что у очистки поиска в окне
      параметров (GlassButtonIconFlat), но объявленная здесь. Ссылаться на неё из этого словаря
      нельзя: StaticResource видит только ресурсы этого файла, а стекло лежит в GlassButton.xaml.
      Токены стекла — из палитры, поэтому вид совпадает с полем поиска.
    -->
    <Style x:Key="DatePickerClearButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AddDayGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AddDayBevel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AddDayGlassHover}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AddDayBevelHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      DatePicker: поле даты в журнале и окне дня.

      Системный DatePicker в светлой теме от наших полей неотличим — системное поле тоже
      белое, как FieldBackground, — и это скрывало, что стиля у него нет вовсе. В тёмной теме
      он остаётся белым и выбивается из ряда, поэтому шаблон свой.

      Текст даты — обычное поле приложения: DatePickerTextBox подхватывает неявный стиль
      TextBox и получает наши цвета, рамку и акцент в фокусе. Кнопка календаря — плоская
      иконка рядом с полем. Попап — системный календарь: сетку дней рисует тема WPF, а своя
      тема календаря — отдельная большая работа.

      Части шаблона — те, что ждёт сам DatePicker (PART_Root, PART_TextBox, PART_Button,
      PART_Popup): переименуешь — и он перестанет находить поле и кнопку. В частности, кнопка
      должна быть Button, а не ToggleButton: DatePicker подписывается на её Click. Справа от
      текста внутри поля лежит подпись DatePickerSuffix.Text — только для показа, не для ввода.

      Foreground задан отдельным токеном: DatePicker привязывает к нему Foreground календаря,
      а подложка календаря всегда светлая — в тёмной теме обычный TextPrimary дал бы светлый
      текст на белом.
    -->
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource TextOnLightSurface}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                          Стиль указан явно: неявный ищется по точному типу, а DatePickerTextBox —
                          подтип TextBox, и своего неявного стиля у него нет. Без явного стиля поле
                          осталось бы системным (и в светлой теме это не видно: системное поле тоже
                          белое).

                          {x:Type TextBox} — ссылка на неявный стиль по его ключу-типу; он объявлен
                          в этом же словаре, поэтому и виден.
                        -->
                        <!--
                          Подпись дня недели рисуется поверх текстовой части поля, перед кнопкой
                          календаря, в той же ячейке корневой сетки — вложенный контейнер менял
                          желаемый размер DatePicker. Поле сохраняет родные отступы 5,2, а справа
                          стоит резерв под то, что там лежит: 48, когда есть и подпись, и крестик.
                          Меньшие значения выставляют триггеры ниже. Цвет подписи задан явно:
                          DatePicker.Foreground — это TextOnLightSurface для календаря, и в тёмной
                          теме он слился бы с фоном поля, поэтому подпись красится в TextPrimary,
                          как и сама дата.

                          Отступ подписи справа — 30: место занято крестиком очистки. Когда
                          крестика нет (команда не задана или дата не выбрана), триггеры ниже
                          возвращают 4 — ровно прежний вид окна дня.
                        -->
                        <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Padding="5,2,48,2"
                                                       Style="{StaticResource {x:Type TextBox}}" />

                        <TextBlock x:Name="WeekdaySuffix"
                                   Grid.Column="0"
                                   Margin="0,0,30,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Path=(helpers:DatePickerSuffix.Text), RelativeSource={RelativeSource TemplatedParent}}" />

                        <!--
                          Крестик очистки — внутри поля, левее кнопки календаря: он часть поля,
                          как крестик очистки поиска в окне параметров, а не соседняя кнопка.
                          Резерв текста 48 px из шаблона уже вмещает его, поэтому ширина поля при
                          появлении крестика не меняется.

                          Видимость собирается триггерами: по умолчанию кнопка видима, а каждое
                          из двух условий «нечего очищать» гасит её. Так шаблон не требует
                          конвертеров и не знает модели окна.
                        -->
                        <Button x:Name="ClearButton"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DatePickerClearButton}"
                                Command="{Binding Path=(helpers:DatePickerClear.Command), RelativeSource={RelativeSource TemplatedParent}}"
                                ToolTip="Очистить дату">
                            <!-- Глиф нарисован путём, как у очистки поиска: на 9 px глиф шрифта мельче линии. -->
                            <Path Width="9"
                                  Height="9"
                                  Data="M 1,1 L 8,8 M 8,1 L 1,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>

                        <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DatePickerButton}"
                                ToolTip="Выбрать дату">
                            <!--
                              Глиф календаря нарисован, а не взят из файла: готовой иконки в
                              проекте нет, а иконки приложения рисуются путями. Цвет — Foreground
                              кнопки, как у прочих иконок: при наведении кнопка светлеет.
                            -->
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Data="M 2.5,3.5 L 13.5,3.5 L 13.5,14 L 2.5,14 Z M 2.5,6.5 L 13.5,6.5 M 5,1.5 L 5,4.5 M 11,1.5 L 11,4.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>

                        <!--
                          Содержимое попапа подставляет сам DatePicker (свой Calendar), поэтому
                          здесь оно пустое. Положение — от поля даты, а не от кнопки.
                        -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=PART_Root}"
                               StaysOpen="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                          Крестик прячется, когда очищать нечего или нечем: дата не выбрана либо
                          команда не задана. Условия стоят по отдельности, а не одним
                          MultiTrigger: у «не null» в XAML нет значения, а два независимых гашения
                          дают то же самое. Подпись дня возвращается к прежнему отступу, когда
                          крестика нет, — иначе в окне дня она стояла бы с лишним зазором.
                        -->
                        <Trigger Property="SelectedDate" Value="{x:Null}">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WeekdaySuffix" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="helpers:DatePickerClear.Command" Value="{x:Null}">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WeekdaySuffix" Property="Margin" Value="0,0,4,0" />
                        </Trigger>

                        <!--
                          Правый резерв текста равен тому, что в нём лежит. Раньше 48 px стояли
                          всегда, и в шапке главного окна, где подписи дня нет, пустые 26 px
                          читались белой плашкой, а дата обрезалась на её границе. Порядок
                          триггеров важен: более частное условие объявлено позже и перекрывает
                          общие, поэтому при пустых обоих остаётся 5.
                        -->
                        <Trigger Property="helpers:DatePickerSuffix.Text" Value="">
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="5,2,26,2" />
                        </Trigger>
                        <Trigger Property="helpers:DatePickerClear.Command" Value="{x:Null}">
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="5,2,34,2" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="helpers:DatePickerSuffix.Text" Value="" />
                                <Condition Property="helpers:DatePickerClear.Command" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="5,2,5,2" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Button: плоская мини-кнопка для ячеек таблиц («Показать» в строке упражнения).
      Без MinHeight, жирного шрифта и широких полей — стеклянная обёртка раздувает ряд;
      габарит задаёт место вызова. Неявный стиль не трогает крупные кнопки: у них явный
      Style по ключам из GlassButton.xaml, который перекрывает неявный.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="Transparent" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: галочка на белом квадрате; content в отдельном столбце, квадрат прижат к первой строке -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!--
                          Квадрат и подпись центрируются относительно друг друга: окно ставит
                          сам контрол в центр строки, и прижатый к верху квадрат с запасом
                          съезжал ниже центра строки текста. Центр — поведение системного
                          шаблона; у многострочных подписей квадрат встаёт по центру блока.
                        -->
                        <Border x:Name="Box"
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource FieldBorder}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <!-- Рычажок Path, а не «✓» глифом шрифта: рисунок в любой гарнитуре одинаковый -->
                            <Path x:Name="Check"
                                  Data="M 2.5,7 L 5.5,10 L 10.5,4"
                                  Stroke="{DynamicResource AccentStrong}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Hidden" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Чекбокс шапки: подпись слева, квадрат по центру правой зоны, ширина которой равна полю
      числа. Так центр квадрата совпадает с центром поля под ним, а сам квадрат равен полю по
      высоте — размеры приходят из экземпляра, а не заданы числом.

      Стиль именованный: неявный шаблон с квадратом слева остаётся общим для остальных окон.
    -->
    <Style x:Key="CheckBoxSquareRight"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <!-- Высота по умолчанию: от неё считается квадрат, если экземпляр не задал свою -->
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="Label"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />

                        <!--
                          Правая зона шириной с поле числа: квадрат центрируется в ней, и его
                          центр встаёт над центром поля «Количество дней» при любой ширине.
                          Ширину шаблон взять у окна не может, поэтому она приходит в Tag
                          чекбокса. Сторона квадрата — Height контрола, то есть высота поля.
                        -->
                        <Grid Grid.Column="1"
                              Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                              HorizontalAlignment="Right">
                            <Border x:Name="Box"
                                    Width="{TemplateBinding Height}"
                                    Height="{TemplateBinding Height}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FieldBackground}"
                                    BorderBrush="{DynamicResource FieldBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <!--
                                  Viewbox растягивает рычажок вместе с квадратом: тот же рисунок, что
                                  в общем шаблоне, но при 24–36 px не выглядит крошкой в пустом поле.
                                -->
                                <Viewbox x:Name="Check"
                                         Margin="5"
                                         Stretch="Uniform"
                                         Visibility="Hidden">
                                    <Path Data="M 2.5,7 L 5.5,10 L 10.5,4"
                                          Stroke="{DynamicResource AccentStrong}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: белое поле + стрелка; выпадающий список — отдельное окно с белой рамкой -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Правое поле больше стрелки: подписи выбранных пунктов не наезжают на неё -->
        <Setter Property="Padding" Value="7,2,18,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Path x:Name="Arrow"
                              Width="9"
                              Height="6"
                              HorizontalAlignment="Right"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center"
                              Data="M 0,0 L 4.5,4.5 L 9,0"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" />
                        <!--
                          Переключатель клика. Сам ComboBox по клику поле не открывает: в
                          поставляемых шаблонах это делает ToggleButton, чей IsChecked записан
                          в IsDropDownOpen двусторонней привязкой. Прозрачный и без своего вида:
                          рисуют рамка и стрелка ниже по Z; Focusable=False, чтобы фокус брал
                          ComboBox напоказ.
                        -->
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,2,0,6"
                                    Background="{DynamicResource FieldBackground}"
                                    BorderBrush="{DynamicResource LineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="0,2"
                                    SnapsToDevicePixels="True">
                                <!--
                                  CanContentScroll обязателен: без него список шрифтов измеряет все
                                  виртуализованные пункты разом и первый показ зависает.
                                -->
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункты dropdown: подсветка наведения и клавиатуры одна (IsHighlighted — и то и другое) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Frame"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Список: белое поле с рамкой, как у полей ввода, и узкая полоса прокрутки приложения.

      Списка в проекте раньше не было — окно параметров держало выпадающий список шрифтов.
      Системный ListBox в тёмной теме выбивается, как выбивался системный DatePicker, и
      свой шаблон здесь обязателен.

      Полоса прокрутки внутри шаблона, а не над списком: иначе панель получает меру без
      границ и строит весь список разом (ловушка 30), а семейств шрифтов сотни.
      CanContentScroll обязателен: попиксельная прокрутка виртуализации противоречит,
      ItemsPresenter строил бы весь ItemsSource.
    -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!--
          Панель задана явно: у ListBox она приходит из системной темы, а свой стиль тему
          заменяет, и без этого пункта список строился бы целиком.
        -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт списка: подсветка наведения и выбранного — разные, выбранный виден и без мыши -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowHighlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu / ContextMenu: верхняя полоса прозрачна, само меню — белая карточка с рамкой -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,2"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Пункты меню: четыре шаблона роли. Общий каркас — рамка с подсветкой наведения; различаются
      только Popup (у заголовков он есть, у просто пунктов нет), стрелка подменю и колонка
      сочетания клавиш. Иконки пунктов не рисуются: их нет ни в одном меню проекта.
    -->
    <ControlTemplate x:Key="MenuItemTopLevelHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Frame"
                    Background="Transparent"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Bottom">
                <Border Background="{DynamicResource FieldBackground}"
                        BorderBrush="{DynamicResource LineStrong}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="0,2"
                        SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemTopLevelItem" TargetType="MenuItem">
        <Border x:Name="Frame"
                Background="Transparent"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemSubmenuHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Frame"
                    Background="Transparent"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Grid.Column="0"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center" />

                    <TextBlock x:Name="GestureText"
                               Grid.Column="1"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{TemplateBinding InputGestureText}"
                               Visibility="Hidden" />

                    <Path Grid.Column="2"
                          Width="5"
                          Height="8"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right">
                <Border Background="{DynamicResource FieldBackground}"
                        BorderBrush="{DynamicResource LineStrong}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="0,2"
                        SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="GestureText" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Пустой столбик под сочетание клавиш убираем так же, как в MenuItemSubmenuItem -->
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Frame"
                Background="Transparent"
                CornerRadius="2"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />

                <TextBlock x:Name="GestureText"
                           Grid.Column="1"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{TemplateBinding InputGestureText}"
                           Visibility="Hidden" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter TargetName="GestureText" Property="Visibility" Value="Visible" />
            </Trigger>
            <!--
              Пустой столбик под сочетание клавиш: Hidden по WPF всё равно занимает место в вёрстке,
              и пустой GestureText оставлял справа от каждого пункта 24 px пустоты (его
              Margin="24,0,0,0"). Сочетаний в меню нет — колонку убираем вместе с пустотой.
              Триггер после триггера роли: срабатывают оба, и последний выигрывает.
            -->
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Умолчание — верхний заголовок; остальное подставляют триггеры роли -->
        <Setter Property="Template" Value="{DynamicResource MenuItemTopLevelHeader}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource MenuItemTopLevelItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource MenuItemSubmenuItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource MenuItemSubmenuHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Разделитель: линия от края до края — так же, как остальные разделители приложения (линия под
      шапкой, нижние разделители строк журнала). Горизонтального отступа нет: карточка меню сама
      отступает от своего края рамкой в 1 px, и линия упирается в её внутренний край. Вертикальные
      3 px — зазор между соседними пунктами меню.

      Ловушка: этот стиль неявный, и внутри ContextMenu он не действует. У Separator есть
      DefaultStyleKey, а тема WPF регистрирует его стилем ПО КЛЮЧУ {x:Type Separator} — тематический
      стиль по умолчанию перебивает неявный стиль из дерева ресурсов. Меню получало тему: линия со
      сдвигом 30 px (место под галочку) и цвет #D7D7D7, одинаковый в обеих темах. Объявление стиля
      в ContextMenu.Resources не помогает — помогает только явное назначение:
      Style="{StaticResource {x:Type Separator}}".
    -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="0,3"
                            Background="{DynamicResource MenuSeparator}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      TabControl / TabItem: вкладки — те же плоские сегменты, что и полоса переходов между
      окнами в настройках (стиль TabButton в Themes/GlassButton.xaml).

      Шаблон сегмента написан здесь второй раз: одна ControlTemplate служит одному типу
      контрола, а у вкладки и у кнопки разный источник содержимого — Header и Content.

      Полоса вкладок сдвинута влево на столько же, на сколько содержимое сдвинуто
      отступом Padding, и отделена от общей линии содержимого зазором в пиксель: иначе
      полоса торчит левее полей, а её линии сливаются с общей в одну толстую.
    -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Row="0"
                                  Margin="10,0,0,1"
                                  IsItemsHost="True" />
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource LineSoft}"
                                BorderThickness="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <!--
                          Подложка сегмента. Прозрачная у обычного: сегменты стоят на фоне окна
                          и читаются линиями, а не заливкой.
                        -->
                        <Border x:Name="Plate" Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <!--
                          Верхняя кромка: у выбранного сегмента тень от края углубления.
                          У обычного она прозрачна и места не занимает — толщина кромки
                          одинакова при любом состоянии, и выделенный сегмент не «прыгает».
                        -->
                        <Rectangle x:Name="TopEdge"
                                   Height="1"
                                   VerticalAlignment="Top"
                                   Fill="Transparent" />

                        <!--
                          Нижняя линия сегмента: у обычного — разделитель сегмента от
                          содержимого под ним, у выбранного — акцентная метка выбора.
                        -->
                        <Rectangle x:Name="BottomLine"
                                   Height="1"
                                   VerticalAlignment="Bottom"
                                   Fill="{DynamicResource LineSoft}" />

                        <!--
                          Разделитель соседей: у правого края сегмента, чтобы примыкающие
                          сегменты давали одну линию между собой.
                        -->
                        <Rectangle Width="1"
                                   HorizontalAlignment="Right"
                                   Fill="{DynamicResource LineSoft}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="TopEdge" Property="Fill" Value="{DynamicResource LineStrong}" />
                            <Setter TargetName="BottomLine" Property="Height" Value="2" />
                            <Setter TargetName="BottomLine" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Expander: шеврон поворачивается открытием, тело Expander' ниже. Только ExpandDirection=Down
      (в проекте другого нет), поэтому один шаблон вместо четырёх направленных.

      Тело фактонтно и шапке — Grid со строками Auto и *, а не StackPanel: StackPanel никогда не
      отдаёт содержимому остаток главной оси, и примечание окна дня, обязанное растянуться на
      *-строку редактора, рисуется в естественную одну строку, а запас высоты остаётся пустотой
      под телом. У Expander'ов с Auto-высотой (списки планов) вид не меняется: строка * измеряется
      как Auto, пока контент не растянут.
    -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderSite"
                                      Grid.Row="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <!--
                                          Поворот вокруг центра: без RenderTransformOrigin шеврон крутился
                                          вокруг точки (0,0) и при повороте улетал влево за пределы кнопки.
                                          Вертикальный сдвиг оптической доводки приходит по привязке из
                                          метрик предка-Expander'а (FontCenterOffset): бокс строки и видимый
                                          центр строки расходятся, и величина расхода меняется со шрифтом
                                          и кеглем, поэтому ручной сдвиг с места вызова на них не полагается.
                                        -->
                                        <Path x:Name="Chevron"
                                              Width="5"
                                              Height="9"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Data="M 0,0 L 4,4 L 0,8"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondary}"
                                              StrokeThickness="0">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform />
                                                    <TranslateTransform>
                                                        <TranslateTransform.Y>
                                                            <MultiBinding Converter="{StaticResource FontCenterOffset}">
                                                                <Binding Path="FontFamily"
                                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=Expander}" />
                                                                <Binding Path="FontSize"
                                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=Expander}" />
                                                            </MultiBinding>
                                                        </TranslateTransform.Y>
                                                    </TranslateTransform>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <!--
                                              Плавное вращение вместо мгновенного Setter'а.
                                              From в ExitActions фиксируем на 90: при деактивации триггера его
                                              Storyboard снимается и значение успевает упасть к базовому 0,
                                              поэтому без From выходная анимация была бы пустой (мгновенный рывок).
                                            -->
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                                                                         From="0" To="90"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                                                                         From="90" To="0"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Прокрутка: узкая полоса без стрелок — колесо и ползунок; цвет ползунка — линии,
      наведение темнее. Оба направления: ScrollViewer сам выбирает по Orientation.
    -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFrame"
                            Margin="3"
                            Background="{DynamicResource LineStrong}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFrame" Property="Background" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFrame" Property="Background" Value="{DynamicResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbFrame" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="12" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="28"
                           Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Height="12" Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="28"
                           Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Неявный стиль переопределяет системный целиком: полосы прокрутки приложения везде свои -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
