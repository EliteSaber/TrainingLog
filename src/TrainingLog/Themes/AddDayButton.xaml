<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Кнопка «Добавить день» по мокапу docs/exampleIcons.svg (компактный вариант):
      стеклянная кнопка с фаской, диагональным отблеском и иконкой «+». Четыре состояния
      мокапа — обычное, наведённое, нажатая, недоступная: триггеры меняют градиенты,
      прозрачности слоёв, эффекты свечения/тени и «утапливают» кнопку вниз на 1px.

      DropShadowEffect/BlurEffect вместо SVG-фильтров: Direction=90 кладёт тень строго
      вниз, как feOffset dy в мокапе. Уголков-скобок из мокапа здесь нет — стиль оставлен
      на четырёх состояниях без них, поля по краям — только под свечение и тень.
    -->
    <LinearGradientBrush x:Key="AddDayGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.38" Color="#E7F8FF" />
        <GradientStop Offset="0.52" Color="#B9E6FA" />
        <GradientStop Offset="1" Color="#8CCFEF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayGlassHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.35" Color="#EAFCFF" />
        <GradientStop Offset="0.52" Color="#A5ECFF" />
        <GradientStop Offset="1" Color="#5CC9F2" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayGlassActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#9FD8F0" />
        <GradientStop Offset="0.5" Color="#7BC4E8" />
        <GradientStop Offset="1" Color="#4FA8D6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayGlassDisabled" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F4F8FB" />
        <GradientStop Offset="0.38" Color="#E6EEF4" />
        <GradientStop Offset="0.52" Color="#D4E0E9" />
        <GradientStop Offset="1" Color="#C2D1DC" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.45" Color="#A8E4FF" />
        <GradientStop Offset="1" Color="#2B7FB9" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayBevelHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.45" Color="#C8F4FF" />
        <GradientStop Offset="1" Color="#19A0E0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayBevelActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2B7FB9" />
        <GradientStop Offset="0.55" Color="#4A9BC4" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayBevelDisabled" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.45" Color="#DDE7EE" />
        <GradientStop Offset="1" Color="#A8B8C4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayInnerBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#002B6F9E" />
        <GradientStop Offset="1" Color="#731D5A83" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayInnerBottomDisabled" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#007F95A5" />
        <GradientStop Offset="1" Color="#387F95A5" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddDayStreak" StartPoint="0,1" EndPoint="0.6,0">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.6" Color="#8CFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!--
      224 × 48 = кнопка 204×28 + поля 10px: без уголков запас нужен только под свечение
      и тень с их блюром. Тело кнопки — Margin 10,10, свечение считается от него.
    -->
    <Style x:Key="AddDayButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Verdana" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#08355C" />
        <Setter Property="Width" Value="224" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!--
                          Y2K-подсветка за кнопкой: размытый прямоугольник, в мокапе —
                          rect с feGaussianBlur stdDeviation=7 (на этом размере — 5).
                        -->
                        <Rectangle x:Name="Glow"
                                   Margin="18,21,18,12"
                                   RadiusX="5"
                                   RadiusY="5"
                                   Fill="#3FC4FF"
                                   Opacity="0.2"
                                   IsHitTestVisible="False">
                            <Rectangle.Effect>
                                <BlurEffect Radius="5" />
                            </Rectangle.Effect>
                        </Rectangle>

                        <!-- Тело кнопки: стекло, фаска и внутренние слои. -->
                        <Grid x:Name="Chrome" Margin="10,10,10,10">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="2.5"
                                                  Direction="90"
                                                  ShadowDepth="3"
                                                  Opacity="0.32" />
                            </Grid.Effect>

                            <!-- Стекло с фаской -->
                            <Border x:Name="Glass"
                                    CornerRadius="4"
                                    BorderThickness="1.2"
                                    Background="{StaticResource AddDayGlass}"
                                    BorderBrush="{StaticResource AddDayBevel}" />

                            <!--
                              Внутренние слои под скруглённой обрезкой, как clipPath в мокапе:
                              без неё боковые грани и отблеск лежат до прямых краёв и торчат
                              за дугу стекла — кнопка выглядит подрезанной на торцах. Радиус
                              обрезки держать согласованным с CornerRadius у Glass.
                            -->
                            <Grid x:Name="InnerLayers">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,204,28" RadiusX="4" RadiusY="4" />
                                </Grid.Clip>

                                <!-- Верхний белый блик: полоса + тонкая подложка под ней -->
                                <Border x:Name="TopLight"
                                        Height="2"
                                        Margin="1.5,0.8,1.5,0"
                                        VerticalAlignment="Top"
                                        Background="#F2FFFFFF" />
                                <Border x:Name="TopLightThin"
                                        Height="1"
                                        Margin="1.5,2.5,1.5,0"
                                        VerticalAlignment="Top"
                                        Background="#73FFFFFF" />

                                <!-- Нижняя внутренняя тень -->
                                <Border x:Name="BottomShade"
                                        Height="7"
                                        Margin="1.5,0,1.5,0.8"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource AddDayInnerBottom}" />

                                <!-- Нижняя тёмная грань -->
                                <Rectangle x:Name="BottomLine"
                                           Height="1"
                                           Margin="1.5,0,1.5,0"
                                           VerticalAlignment="Bottom"
                                           Fill="#401D5A83" />

                                <!-- Диагональный отблеск -->
                                <Path x:Name="Streak"
                                      Data="M0,28 L0,5 L40,0 L66,0 Z"
                                      Fill="{StaticResource AddDayStreak}" />

                                <!--
                                  Внутренние боковые грани. Отступ 0.6 — половина толщины
                                  фаски: в SVG полоса начинается от центра stroke, и тёмный
                                  контур снаружи остаётся видимым, иначе торцы «перебиваются»
                                  белым и выглядят подрезанными.
                                -->
                                <Rectangle x:Name="LeftEdge"
                                           Width="1"
                                           Margin="0.6,0,0,0"
                                           HorizontalAlignment="Left"
                                           Fill="#BFFFFFFF" />
                                <Rectangle x:Name="RightEdge"
                                           Width="1"
                                           Margin="0,0,0.6,0"
                                           HorizontalAlignment="Right"
                                           Fill="#59FFFFFF" />

                                <!-- Нажатая: блик уходит вниз, тело «вдавливается» -->
                                <Border x:Name="PressedBottomLight"
                                        Height="2"
                                        Margin="1.5,0,1.5,0.8"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed"
                                        Background="#B3FFFFFF" />
                                <Border x:Name="PressedTopShade"
                                        Height="8"
                                        Margin="1.5,0,1.5,0"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed"
                                        Background="#4D1D5A83" />
                                <Rectangle x:Name="PressedTopLine"
                                           Height="1"
                                           Margin="1.5,0,1.5,0"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"
                                           Fill="#731D5A83" />
                                <Path x:Name="PressedStreak"
                                      Data="M0,28 L0,14 L20,4 L36,4 Z"
                                      Visibility="Collapsed"
                                      Fill="#2EFFFFFF" />
                            </Grid>
                        </Grid>

                        <!--
                          Содержимое: иконка «+» и надпись. Отдельно от Chrome, чтобы тень
                          «тела» не ложилась на текст — у него своя, белая (txtShadow).
                        -->
                        <Grid x:Name="ContentRoot" Margin="10,10,10,10">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="0.5"
                                                  Direction="90"
                                                  ShadowDepth="0.7"
                                                  Color="#FFFFFF"
                                                  Opacity="0.9" />
                            </Grid.Effect>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Icon"
                                  Grid.Column="0"
                                  Width="10"
                                  Height="10"
                                  Margin="16,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Data="M1,5 H9 M5,1 V9"
                                  Stroke="#08355C"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square" />

                            <TextBlock x:Name="TextPart"
                                       Grid.Column="1"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Content}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Margin" Value="13,17,13,12" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="6.5" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3"
                                                      Direction="90"
                                                      ShadowDepth="3.5"
                                                      Opacity="0.38" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Glass" Property="Background" Value="{StaticResource AddDayGlassHover}" />
                            <Setter TargetName="Glass" Property="BorderBrush" Value="{StaticResource AddDayBevelHover}" />
                            <Setter TargetName="Glass" Property="BorderThickness" Value="1.4" />
                            <Setter TargetName="TopLight" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="TopLightThin" Property="Background" Value="#8CFFFFFF" />
                            <Setter TargetName="LeftEdge" Property="Fill" Value="#E6FFFFFF" />
                            <Setter TargetName="RightEdge" Property="Fill" Value="#73FFFFFF" />
                            <Setter TargetName="BottomLine" Property="Fill" Value="#5919A0E0" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <!-- Кнопка «утоплена»: тело и содержимое смещаются вниз -->
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ContentRoot" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Glow" Property="Margin" Value="21,26,21,14" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.15" />
                            <Setter TargetName="Chrome" Property="Effect">
                                <Setter.Value>
                                    <x:Null />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Glass" Property="Background" Value="{StaticResource AddDayGlassActive}" />
                            <Setter TargetName="Glass" Property="BorderBrush" Value="{StaticResource AddDayBevelActive}" />
                            <Setter TargetName="Glass" Property="BorderThickness" Value="1.4" />
                            <!-- Подсветка переворачивается: блик у низа, тень у верха -->
                            <Setter TargetName="TopLight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopLightThin" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BottomShade" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Streak" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedBottomLight" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedTopShade" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedTopLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedStreak" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LeftEdge" Property="Fill" Value="#59FFFFFF" />
                            <Setter TargetName="RightEdge" Property="Fill" Value="#33FFFFFF" />
                            <!-- Текст и иконка темнее на вдавленном теле -->
                            <Setter TargetName="TextPart" Property="Foreground" Value="#0B4A72" />
                            <Setter TargetName="Icon" Property="Stroke" Value="#0B4A72" />
                            <Setter TargetName="ContentRoot" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="0.4"
                                                      Direction="90"
                                                      ShadowDepth="0.7"
                                                      Color="#1D5A83"
                                                      Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--
                          Отключённая — по мокапу, своими цветами, а не приглушением.
                          Триггер стоит последним: на недоступной кнопке курсор поднимает
                          IsMouseOver, и этот триггер обязан его перекрыть.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Свечения у недоступной нет, остаётся слабая тень -->
                            <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Chrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="1.4"
                                                      Direction="90"
                                                      ShadowDepth="1.1"
                                                      Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Glass" Property="Background" Value="{StaticResource AddDayGlassDisabled}" />
                            <Setter TargetName="Glass" Property="BorderBrush" Value="{StaticResource AddDayBevelDisabled}" />
                            <Setter TargetName="TopLight" Property="Background" Value="#8CFFFFFF" />
                            <Setter TargetName="TopLightThin" Property="Background" Value="#40FFFFFF" />
                            <Setter TargetName="BottomShade" Property="Background" Value="{StaticResource AddDayInnerBottomDisabled}" />
                            <Setter TargetName="BottomLine" Property="Fill" Value="#2E7F95A5" />
                            <Setter TargetName="Streak" Property="Opacity" Value="0.64" />
                            <Setter TargetName="LeftEdge" Property="Fill" Value="#73FFFFFF" />
                            <Setter TargetName="RightEdge" Property="Fill" Value="#33FFFFFF" />
                            <Setter TargetName="TextPart" Property="Foreground" Value="#94A6B3" />
                            <Setter TargetName="Icon" Property="Stroke" Value="#94A6B3" />
                            <Setter TargetName="ContentRoot" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="0.5"
                                                      Direction="90"
                                                      ShadowDepth="0.7"
                                                      Color="#FFFFFF"
                                                      Opacity="0.7" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
