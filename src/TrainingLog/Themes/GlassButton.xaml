<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:TrainingLog.Controls">
    <!--
      Единый стеклянный стиль кнопок по мокапу docs/addDayButtonStates.svg
      (светлая тема).

      Стили:
      - GlassButton      — общий для текстовых кнопок: без фиксированных размеров,
                           Padding задаёт окну, контент — ContentPresenter;
      - GlassButtonIcon  — для символических (✕ ↑ ↓ ◀ ▶ − + и слоты-номера):
                           компактнее, чтобы строки списков не раздавались в высоту;
      - AddDayButton     — кнопка «Добавить день» журнала: BasedOn с фикс. габаритом,
                           шрифтом 15 и иконкой «+», передаваемой из содержимого.

      Вариант с мягкими углами — GlassButtonSoft / GlassButtonIconSoft / AddDayButtonSoft
      (мокап docs/glassButtonSoftStates.svg): BasedOn на соответствующие стили и радиус 2.
      Радиус живёт в helpers:ButtonChrome.CornerRadius (умолчание 4, мокап
      docs/addDayButtonStates.svg), шаблон читает его привязкой к TemplatedParent.

      Четыре состояния — обычное, наведённое, нажатая, недоступная: Shape-триггеры
      меняют градиенты, прозрачности слоёв, эффекты свечения/тени и «утапливают»
      кнопку вниз на 1px. Цвет состояния живёт в Foreground самой кнопки: текст
      покрасится по наследству, Path-иконки в содержимом — привязкой Fill/Stroke
      к Foreground предка-Button.

      Кисти и цвета текста взяты из палитры Themes/Theme.Light.xaml (DynamicResource):
      тёмная тема заменит их значения, и кнопка перекрасится сама. Остаются в шаблоне
      только белые оверлеи стекла: они частью вида кнопки, а не палитры — блики и
      кромки стекла белыми остаются в любой теме.

      DropShadowEffect/BlurEffect вместо SVG-фильтров: Direction=90 кладёт тень
      строго вниз, как feOffset dy в мокапе. Поля по 6px вокруг тела — запас только
      под тень и ореол с их блюром; ореол держит один видимый габарит во всех
      состояниях (свечение прижато к телу, у нажатой остаётся слабая тень), иначе
      нажатая выглядела бы меньше обычной. BlurEffect рисуется и за границами
      кнопки: подложка окна светлая, на вид это ореол, не артефакт.
    -->
    <!--
      Общий шаблон. Размер тела не фиксирован: тело сидит в Margin 6 (запас под
      свечение/тень), габарит задаёт окно. Ширину и высоту шаблон принимает любые —
      обрезку внутренних слоёв ставит helpers:RoundedClip по факту раскладки.
    -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Grid>
            <!--
              Y2K-подсветка за кнопкой: размытый прямоугольник, в мокапе — rect
              с feGaussianBlur. Поле подогнано к телу (тело стартует от 6, ореол
              от 6 по бокам и 5 сверху): блюром 3 прямоугольник выходит наружу
              на пару пикселей и держит один габарит во всех состояниях — иначе
              нажатая без ореола «съёживается» относительно обычной.
            -->
            <Rectangle x:Name="Glow"
                       Margin="6,5,6,2"
                       RadiusX="{Binding Path=(helpers:ButtonChrome.CornerRadius).TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                       RadiusY="{Binding Path=(helpers:ButtonChrome.CornerRadius).TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                       Fill="#3FC4FF"
                       Opacity="0.22"
                       IsHitTestVisible="False">                <Rectangle.Effect>
                    <BlurEffect Radius="3" />
                </Rectangle.Effect>
            </Rectangle>

            <!-- Тело кнопки: стекло, фаска и внутренние слои. -->
            <Grid x:Name="Chrome" Margin="6">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="2.5"
                                      Direction="90"
                                      ShadowDepth="3"
                                      Opacity="0.32" />
                </Grid.Effect>

                <!--
                  Стекло с фаской. Рамка идёт TemplateBinding'ом, а не напрямую из ресурса:
                  обычное состояние берёт умолчание базового стиля (фаска), но вызывающая
                  сторона может рамку перекрасить — так слоты окна дня подсвечивают выбор
                  рамкой выделения.
                -->
                <Border x:Name="Glass"
                        CornerRadius="{Binding Path=(helpers:ButtonChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{DynamicResource AddDayGlass}"
                        BorderBrush="{TemplateBinding BorderBrush}" />

                <Grid helpers:RoundedClip.Radius="{Binding Path=(helpers:ButtonChrome.CornerRadius).TopLeft, RelativeSource={RelativeSource TemplatedParent}}">
                    <!-- Верхний белый блик: полоса + тонкая подложка под ней -->
                    <Border x:Name="TopLight"
                            Height="2"
                            Margin="1.5,0.8,1.5,0"
                            VerticalAlignment="Top"
                            Background="#F2FFFFFF" />
                    <Border x:Name="TopLightThin"
                            Height="1"
                            Margin="1.5,2.5,1.5,0"
                            VerticalAlignment="Top"
                            Background="#73FFFFFF" />

                    <!-- Нижняя внутренняя тень -->
                    <Border x:Name="BottomShade"
                            Height="7"
                            Margin="1.5,0,1.5,0.8"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AddDayInnerBottom}" />

                    <!-- Нижняя тёмная грань -->
                    <Rectangle x:Name="BottomLine"
                               Height="1"
                               Margin="1.5,0,1.5,0"
                               VerticalAlignment="Bottom"
                               Fill="#401D5A83" />

                    <!--
                      Диагональные отблески — обычный и нажатый. Оба живут во вложенном
                      Canvas: Grid меряет всех своих детей в желаемый размер кнопки, и
                      прежде Streak (66 пикселей геометрии) делал каждое стекло шире
                      содержимого, а при нажатии Streak сворачивался и самый широкий
                      ребёнок становился PressedStreak (36) — кнопка пересчитывалась
                      уже и стекло сжималось. Canvas детей в мерку не включает: оба
                      отблеска продолжают рисоваться (их режет RoundedClip на этой
                      сетке), но размер кнопки задают только Padding и содержимое.
                    -->
                    <Canvas>
                        <Path x:Name="Streak"
                              Data="M0,28 L0,5 L40,0 L66,0 Z"
                              Fill="{DynamicResource AddDayStreak}" />

                        <!-- Нажатая: блик уходит вниз, тело «вдавливается» -->
                        <Path x:Name="PressedStreak"
                              Data="M0,28 L0,14 L20,4 L36,4 Z"
                              Visibility="Collapsed"
                              Fill="#2EFFFFFF" />
                    </Canvas>

                    <!--
                      Внутренние боковые грани. Отступ 0.6 — половина толщины фаски:
                      в SVG полоса начинается от центра stroke, и тёмный контур снаружи
                      остаётся видимым, иначе торцы «перебиваются» белым.
                    -->
                    <Rectangle x:Name="LeftEdge"
                               Width="1"
                               Margin="0.6,0,0,0"
                               HorizontalAlignment="Left"
                               Fill="#BFFFFFFF" />
                    <Rectangle x:Name="RightEdge"
                               Width="1"
                               Margin="0,0,0.6,0"
                               HorizontalAlignment="Right"
                               Fill="#59FFFFFF" />

                    <Border x:Name="PressedBottomLight"
                            Height="2"
                            Margin="1.5,0,1.5,0.8"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed"
                            Background="#B3FFFFFF" />
                    <Border x:Name="PressedTopShade"
                            Height="8"
                            Margin="1.5,0,1.5,0"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Background="#4D1D5A83" />
                    <Rectangle x:Name="PressedTopLine"
                               Height="1"
                               Margin="1.5,0,1.5,0"
                               VerticalAlignment="Top"
                               Visibility="Collapsed"
                               Fill="#731D5A83" />
                </Grid>
            </Grid>

            <!--
              Содержимое. Отдельно от Chrome, чтобы тень «тела» не ложилась на текст.
              На тексте нет Effect: белый эмбосс из мокапа (txtShadow) был DropShadowEffect'ом,
              а Effect переводит поддерево в битмап-рендер и запрещает ClearType — 11px
              надписи читались муточно. Чёткий текст важнее невидимого на малом кегле обвода.
            -->
            <Grid x:Name="ContentRoot" Margin="6">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Ореол плотнее к телу и чуть ярче, но габарит тот же, что у покоя:
                     наведение не должно распухать относительно обычного -->
                <Setter TargetName="Glow" Property="Margin" Value="4,3,4,2" />
                <Setter TargetName="Glow" Property="Opacity" Value="0.35" />
                <Setter TargetName="Glow" Property="Effect">
                    <Setter.Value>
                        <BlurEffect Radius="4" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Chrome" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="3"
                                          Direction="90"
                                          ShadowDepth="3.5"
                                          Opacity="0.38" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Glass" Property="Background" Value="{DynamicResource AddDayGlassHover}" />
                <Setter TargetName="Glass" Property="BorderBrush" Value="{DynamicResource AddDayBevelHover}" />
                <Setter TargetName="Glass" Property="BorderThickness" Value="1.4" />
                <Setter TargetName="TopLight" Property="Background" Value="#FFFFFF" />
                <Setter TargetName="TopLightThin" Property="Background" Value="#8CFFFFFF" />
                <Setter TargetName="LeftEdge" Property="Fill" Value="#E6FFFFFF" />
                <Setter TargetName="RightEdge" Property="Fill" Value="#73FFFFFF" />
                <Setter TargetName="BottomLine" Property="Fill" Value="#5919A0E0" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <!-- Кнопка «утоплена»: тело и содержимое смещаются вниз -->
                <Setter TargetName="Chrome" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="ContentRoot" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
                <!--
                  Свечение слабое, но по месту у тела: габарит не проваливается против
                  обычного состояния. Тень остаётся, но слабее/короче обычной — тело
                  опущено на 1px и легло на поверхность, а не парит.
                -->
                <Setter TargetName="Glow" Property="Margin" Value="6,5,6,2" />
                <Setter TargetName="Glow" Property="Opacity" Value="0.15" />
                <Setter TargetName="Chrome" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="1.5"
                                          Direction="90"
                                          ShadowDepth="2"
                                          Opacity="0.2" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Glass" Property="Background" Value="{DynamicResource AddDayGlassActive}" />
                <Setter TargetName="Glass" Property="BorderBrush" Value="{DynamicResource AddDayBevelActive}" />
                <Setter TargetName="Glass" Property="BorderThickness" Value="1.4" />
                <!-- Подсветка переворачивается: блик у низа, тень у верха -->
                <Setter TargetName="TopLight" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TopLightThin" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="BottomShade" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Streak" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PressedBottomLight" Property="Visibility" Value="Visible" />
                <Setter TargetName="PressedTopShade" Property="Visibility" Value="Visible" />
                <Setter TargetName="PressedTopLine" Property="Visibility" Value="Visible" />
                <Setter TargetName="PressedStreak" Property="Visibility" Value="Visible" />
                <Setter TargetName="LeftEdge" Property="Fill" Value="#59FFFFFF" />
                <Setter TargetName="RightEdge" Property="Fill" Value="#33FFFFFF" />
                <!-- Текст и иконка темнее на вдавленном теле -->
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryPressed}" />
            </Trigger>

            <!--
              Отключённая — по мокапу, своими цветами, а не приглушением.
              Триггер стоит последним: на недоступной кнопке курсор поднимает
              IsMouseOver, и этот триггер обязан его перекрыть.
            -->
            <Trigger Property="IsEnabled" Value="False">
                <!-- Свечения у недоступной нет, остаётся слабая тень -->
                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chrome" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="1.4"
                                          Direction="90"
                                          ShadowDepth="1.1"
                                          Opacity="0.15" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Glass" Property="Background" Value="{DynamicResource AddDayGlassDisabled}" />
                <Setter TargetName="Glass" Property="BorderBrush" Value="{DynamicResource AddDayBevelDisabled}" />
                <Setter TargetName="TopLight" Property="Background" Value="#8CFFFFFF" />
                <Setter TargetName="TopLightThin" Property="Background" Value="#40FFFFFF" />
                <Setter TargetName="BottomShade" Property="Background" Value="{DynamicResource AddDayInnerBottomDisabled}" />
                <Setter TargetName="BottomLine" Property="Fill" Value="#2E7F95A5" />
                <Setter TargetName="Streak" Property="Opacity" Value="0.64" />
                <Setter TargetName="LeftEdge" Property="Fill" Value="#73FFFFFF" />
                <Setter TargetName="RightEdge" Property="Fill" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
      Общая для текстовых кнопок: цвет и шрифт задаём здесь, габарит оставляем окну
      (Padding и Width/Height с места вызова). Минимальную высоту держим так, чтобы
      после Margin 6 шаблона тело было 28 — компактный вариант мокапа.
    -->
    <Style x:Key="GlassButton" TargetType="Button">
        <!--
          Шрифт и кегль — токены приложения, а не Verdana: выбор гарнитуры и масштаб в
          параметрах подменяют их значениями, и DynamicResource доносит замену до
          уже показанных кнопок.
        -->
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <!--
          Умолчания рамки: их же шаблон берёт для рамки стекла через TemplateBinding,
          поэтому все кнопки выглядят как по мокапу, а окну, которому нужна другая
          рамка (выделение слотов дня), достаточно переопределить BorderBrush и
          BorderThickness на самой кнопке.
        -->
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="BorderBrush" Value="{DynamicResource AddDayBevel}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
    </Style>

    <!--
      Символические кнопки (✕ ↑ ↓ ◀ ▶ − + и слоты-номера): тело поменьше (20 после
      Margin 6 шаблона), чтобы строки списков не раздавались в высоту. BlurEffect
      свечения рисуется и за границами кнопки, зарезервированного поля 6 хватает.
    -->
    <Style x:Key="GlassButtonIcon" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!--
      Кнопка «Добавить день» журнала: габарит по компактному мокапу (тело 204×28
      при Margin 6 шаблона — габарит 216×40), шрифт 15. Иконку «+» само содержимое
      несёт: центр шаблона остаётся свободным, главное окно передаёт сетку
      «иконка + надпись» напрямую.
    -->
    <Style x:Key="AddDayButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Width" Value="216" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{DynamicResource LargeSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--
      Вариант с мягкими углами: те же состояния и цвета, радиус 2 вместо 4.
      Цифру можно менять значением свойства, не трогая шаблон; предыдущий
      вариант с прямыми углами выпадал радиусом 0. Соответствует мокапу
      docs/glassButtonSoftStates.svg.
    -->
    <Style x:Key="GlassButtonSoft" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="helpers:ButtonChrome.CornerRadius" Value="2" />
    </Style>

    <Style x:Key="GlassButtonIconSoft" TargetType="Button" BasedOn="{StaticResource GlassButtonIcon}">
        <Setter Property="helpers:ButtonChrome.CornerRadius" Value="2" />
    </Style>

    <Style x:Key="AddDayButtonSoft" TargetType="Button" BasedOn="{StaticResource AddDayButton}">
        <Setter Property="helpers:ButtonChrome.CornerRadius" Value="2" />
    </Style>
</ResourceDictionary>
