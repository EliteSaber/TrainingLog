<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Тема целиком: палитра, стеклянные кнопки, стили контролов. Окна и Application вливают
      только этот словарь — какой стороной он ни подключён, порядок внутри обязателен: палитра
      первой, потому что ею пользуются ссылкой кнопки и контролы (StaticResource в пределах
      одного словаря разрешается при разборе и видит только ранее влитые словари).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Theme.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/GlassButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
