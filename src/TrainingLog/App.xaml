<Application x:Class="TrainingLog.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrainingLog"
             ShutdownMode="OnMainWindowClose">
    <!--
      Завершение по закрытию главного окна. Режимом по умолчанию («по последнему окну») окно
      дня после закрытия журнала оставляло бы приложение жить: окно дня немодальное и без
      владельца, «последним окном» закончится оно, а не журнал.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Токены шрифта живут здесь, а не в окнах: оконный экземпляр словаря перекрыл бы
                  подмену из параметров (поиск DynamicResource от элемента вверх, к окну).
                  Ловушка 6 окна не задевает: она требует ресурсов у окон, а не запрещает
                  ресурсы приложения.
                -->
                <ResourceDictionary Source="pack://application:,,,/TrainingLog;component/Themes/Fonts.xaml" />

                <!--
                  Стили темы — тоже на уровне приложения: отдельные визуальные деревья (ToolTip,
                  ContextMenu, dropdown ComboBox) не поднимаются к окну, и без этой копии
                  DynamicResource в них нашёл бы пустоту. Оконные копии не мешают: в них те же
                  стили.
                -->
                <ResourceDictionary Source="pack://application:,,,/TrainingLog;component/Themes/Styles.xaml" />

                <!--
                  Палитра — только здесь, на уровне приложения, и по той же причине, что и
                  токены шрифта: иначе оконный экземпляр перекрыл бы подмену. Светлая — умолчание,
                  чтобы цвета были и в дизайнере, и до первого вызова переключателя.

                  Переключатель темы (Services/AppTheme) не подменяет этот словарь, а перезаписывает
                  его значения на тёмные: словарь остаётся на месте, и окна, открытые позже, берут
                  из него актуальные цвета.
                -->
                <ResourceDictionary Source="pack://application:,,,/TrainingLog;component/Themes/Palette.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
