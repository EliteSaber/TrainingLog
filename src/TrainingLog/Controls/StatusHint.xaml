<UserControl x:Class="TrainingLog.Controls.StatusHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="0"
             Height="0"
             Focusable="False">

    <!--
      Подсказка окна: об отказе по вводу и о примечании упражнения. Один контрол на оба случая и
      на все окна: вид, срок жизни и поведение при закрытии должны быть одинаковыми, а расходятся
      они дальше только потому, что оказалось скопировано. Различаются тон и срок — их задаёт
      модель (HintState.Kind и HintState.Lifetime). Правило позиционирования — в PopupPlacement и
      тоже одно; здесь оно лишь применяется.

      Показывается элементом поверх содержимого окна, а не отдельным окном Popup: второе окно WPF
      в этом приложении отнимает у главного окна наведение и курсор, причём нажатия при этом
      продолжают работать, и окно выглядит «мёртвым» до самого закрытия подсказки. Проверено
      дважды, на подсказке и на меню шестерёнки (ловушка 34).

      Размеры нулевые не по недосмотру: контрол ничего не занимает в потоке разметки и не должен
      сдвигать ни шапку, ни область подходов. Иначе подсказка двигала бы то, рядом с чем
      появляется.
    -->
    <UserControl.Resources>
        <!--
          Подложка подсказки: системный цвет Control (он же у полей ввода и подложек кнопок в окне
          дня) и прозрачность 0.95.

          Цвет окна (`WindowBrushKey`) для этого не годится: у окон приложения нет собственного
          фона, WPF берёт системный цвет окна, и подсказка была того же цвета, что фон, — то есть
          сливалась с ним. Control темнее окна, поэтому отделяется тоном, а не рамкой.

          Прозрачность задана на кисти, а не на элементе: у Border она пришлась бы и на текст, и
          на крестик, и надпись отказа побледнела бы вместе с подложкой. Brush.Opacity — это
          альфа самой заливки, текст поверх неё остаётся непрозрачным.

          Ресурс, а не инлайн: `DynamicResource` внутри кисти не перестаёт обновляться при смене
          системной темы, потому что кисть объявлена в словаре, а не в разметке элемента.
        -->
        <SolidColorBrush x:Key="HintSurface"
                         Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"
                         Opacity="0.95" />

        <!--
          Прозрачная кнопка со скруглённой подложкой — та же, что у стрелок и «+»/«−» в окне дня
          (AddDayWindow, ArrowButtonTemplate).

          Рамки у кнопки нет намеренно: полоса во всю высоту подсказки в системной рамке
          выглядела бы тяжело, а своей подсветки у прозрачной кнопки больше нет, поэтому она
          описана здесь же. Подложка взята системным цветом Control, как подложки кнопок в окне
          дня, поэтому в тёмной теме она остаётся темнее фона окна, а не станет светлым пятном.
        -->
        <ControlTemplate x:Key="ArrowButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!--
      Canvas нулевого размера без клиппинга: в потоке разметки он не занимает ничего, а его
      ребёнок при этом рисуется и ловит мышь за пределами. Положение задаётся Canvas.Left и
      Canvas.Top из позиционирования ниже, а границы окна держать не приходится: элемент и так
      нарисован внутри окна, выйти за них он не может.

      Значения задаются из code-behind, а не привязками: привязки внутри Popup приходилось бы
      заменять на присваивания по той же причине — см. ловушку 23, молчаливые поломки разметки.
    -->
    <Canvas Width="0" Height="0">
        <!--
          Блок подсказки. Поверх него, ниже по дереву, стоит стрелка у HintArrow: она заходит на
          верхнюю грань блока на 1 px, и рисоваться должна после него.
        -->
        <Border x:Name="HintBlock"
                Padding="10,6"
                Background="{DynamicResource HintSurface}"
                CornerRadius="3"
                Visibility="Collapsed">
            <!--
              Grid, а не горизонтальный StackPanel: панель отдаёт содержимому бесконечную ширину
              при измерении, и при пределе ширины перенос по словам не сработал бы — текст вышел
              бы шире окна. В колонке * ширина конечная, поэтому Wrap работает.

              Обводки нет: отказ должен читаться как строка сообщения, а не как диалог с рамкой.
              Фон при этом остаётся — подсказка висит поверх содержимого окна, и без подложки
              красный текст лёг бы на строки под ним. Подложка полупрозрачная (см. HintSurface), и
              потому границу блока дорисовывать не нужно: сквозь неё видно, что под подсказкой.

              Кнопка закрытия тянется на всю высоту подсказки: при переносе текста на две строки
              крестик на уровне первой строки выглядел бы прилипшим к углу блока. Рисунок внутри
              кнопки центрируется сам.

              Текст лежит в прокрутке, а предел высоты ей ставит код (Place): без него длинное
              примечание упражнения уходит за нижний край окна — предел есть только у ширины, а
              перенос текста по словам увеличивает высоту. Обрезать по месту нельзя: пропавший
              текст пользователь не увидит вообще, поэтому лишнее прокручивается. Предел
              обязателен вместе с прокруткой — без него высота задаётся содержимым, и полоса была
              бы декоративной (ловушка 12).
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="HintTextScroll"
                              Grid.Column="0"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="HintText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <!--
                  Рисунок задан заливкой, а не глифом шрифта и не обводкой: при Stretch="Uniform"
                  толщина штриха масштабировалась бы вместе с рисунком. Две пересекающиеся полосы —
                  тот же приём, что у «+» и «−» в окне дня. Крестик 11×11, толщина по диагонали
                  около 1.4 px, то есть 13 % от размера — ровно как полосы 3 px на 22 px там.

                  Margin="5,0" симметричный и только по горизонтали: полоса подсветки выходит шире
                  рисунка, как у стрелок окна дня (шеврон 22 px в полосе 36 px), и нажать на тонкую
                  диагональ 11 px неудобно. По вертикали отступа нет, а центрирует рисунок
                  ContentPresenter шаблона, так что крестик стоит по центру подсказки.

                  Тон заливки не зашит: он ставится кодом из вида показа (см. SyncHint), потому что
                  у примечания он обычный, а у отказа — предупреждающий, и ресурс с одним ключом
                  для обоих случаев разошёлся бы на первой же смене вида.
                -->
                <Button x:Name="HintButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Template="{StaticResource ArrowButtonTemplate}">
                    <Path x:Name="HintCross"
                          Width="11"
                          Height="11"
                          Margin="5,0"
                          Stretch="Uniform"
                          Data="M 0,1 L 1,0 L 11,10 L 10,11 Z M 10,0 L 11,1 L 1,11 L 0,10 Z" />
                </Button>
            </Grid>
        </Border>

        <!--
          Стрелка, указывающая на поле, от которого пришёл отказ. Положение задаёт Place().

          Рисунок задан двумя кубическими дугами, а не ломаной: у ломаной рёбра прямые, и стрелка
          читается как обычный треугольник. Дуги уходят внутрь — на середине высоты заливка
          занимает лишь треть ширины вместо половины, — и по бокам горловины остаётся воздух,
          сквозь который видно содержимое окна. Этого и добивались: подсказка показывает, откуда
          пришла, и не затыкает то место, на которое указывает.

          Вершина при этом не игла: касательные в ней дают угол около 90°, а не сходятся в один
          пиксель. Это важно под полупрозрачной заливкой — вырожденная вершина мерцает на
          пёстром фоне окна, такая нет.

          Данные заданы в собственной системе координат 12×6, а Width и Height выше — 18×9:
          Stretch="Uniform" разносит ту же кривую сам, и пропорции вогнутых рёбер сохраняются.
          Правьте размер константами в StatusHint.xaml.cs, а не здесь: от него зависит вертикальный
          расклад, который считается через высоту рисунка.

          Заливка та же кисть, что у блока: та же прозрачность и тот же тон, поэтому в тёмной теме
          стрелка не светлеет отдельно от подложки.
        -->
        <Path x:Name="HintArrow"
              Width="18"
              Height="9"
              Stretch="Uniform"
              Data="M 0 6 C 5 5 5 1 6 0 C 7 1 7 5 12 6 Z"
              Fill="{DynamicResource HintSurface}"
              Visibility="Collapsed" />
    </Canvas>
</UserControl>