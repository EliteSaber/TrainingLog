<UserControl x:Class="TrainingLog.Controls.StatusHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="0"
             Height="0"
             Focusable="False">

    <!--
      Подсказка окна: отказ по вводу и примечание упражнения. Один контрол на оба случая и на все
      окна: вид, срок жизни и поведение при закрытии должны быть одинаковыми. Различаются тон и срок —
      их задаёт модель (HintState.Kind и HintState.Lifetime), рисует контрол.

      Показывается элементом поверх содержимого окна, а не окном Popup: второе окно WPF отнимает у
      окна наведение и курсор, и окно выглядит «мёртвым» до самого закрытия подсказки (ловушка 34).
      Размеры нулевые не по недосмотру: контрол ничего не занимает в потоке разметки и не должен
      сдвигать ни шапку, ни область ввода.
    -->
    <UserControl.Resources>
        <!--
          Подложка системным цветом Control: у окон нет собственного фона, WPF берёт цвет окна, и
          подложка слилась бы с ним, а Control темнее. Прозрачность задана на кисти, а не на
          элементе: у Border она пришлась бы и на текст, и на крестик.

          Ресурс, а не инлайн: DynamicResource внутри кисти не перестаёт обновляться при смене
          системной темы, потому что кисть объявлена в словаре.
        -->
        <SolidColorBrush x:Key="HintSurface"
                         Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"
                         Opacity="0.95" />

        <!--
          Прозрачная кнопка со скруглённой подложкой — та же, что у стрелок и «+»/«−» в окне дня.
          Рамки у кнопки нет намеренно: полоса во всю высоту подсказки в системной рамке выглядела
          бы тяжело, а своей подсветки у прозрачной кнопки больше нет.
        -->
        <ControlTemplate x:Key="ArrowButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="Transparent"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface"
                            Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!--
      Canvas нулевого размера без клиппинга: в потоке разметки он не занимает ничего, а ребёнок
      рисуется и ловит мышь за пределами. Положение задаётся Canvas.Left и Canvas.Top из кода.

      Блок подсказки объявлен раньше стрелки: она заходит на его верхнюю грань на 1 px, и рисоваться
      должна после него.
    -->
    <Canvas Width="0" Height="0">
        <Border x:Name="HintBlock"
                Padding="10,6"
                Background="{DynamicResource HintSurface}"
                CornerRadius="3"
                Visibility="Collapsed">
            <!--
              Grid, а не горизонтальный StackPanel: панель отдаёт бесконечную ширину при измерении,
              и при пределе ширины перенос по словам не сработал бы (ловушка 29). В колонке * ширина
              конечная, поэтому Wrap работает.

              Обводки нет: отказ должен читаться как строка сообщения, а не как диалог с рамкой.

              Кнопка закрытия тянется на всю высоту подсказки: при переносе текста на две строки
              крестик на уровне первой строки выглядел бы прилипшим к углу блока.

              Текст лежит в прокрутке, а предел высоты ей ставит код (Place): без него длинное
              примечание уходит за нижний край окна, предел есть только у ширины, а перенос по
              словам увеличивает высоту. Обрезать по месту нельзя — пропавший текст пользователь не
              увидит вовсе, поэтому лишнее прокручивается.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="HintTextScroll"
                              Grid.Column="0"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="HintText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <!--
                  Рисунок задан заливкой, а не глифом шрифта и не обводкой: при Stretch="Uniform"
                  толщина штриха масштабировалась бы вместе с рисунком. Margin="5,0" симметричный и
                  только по горизонтали: полоса подсветки выходит шире рисунка, как у шевронов, и
                  нажать на тонкую диагональ неудобно.

                  Тон зашивать нельзя: он ставится кодом из вида показа, потому что у примечания он
                  обычный, а у отказа — предупреждающий.
                -->
                <Button x:Name="HintButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Template="{StaticResource ArrowButtonTemplate}">
                    <Path x:Name="HintCross"
                          Width="11"
                          Height="11"
                          Margin="5,0"
                          Stretch="Uniform"
                          Data="M 0,1 L 1,0 L 11,10 L 10,11 Z M 10,0 L 11,1 L 1,11 L 0,10 Z" />
                </Button>
            </Grid>
        </Border>

        <!--
          Стрелка указывает на поле, от которого пришёл отказ; положение задаёт Place(). Рисунок задан
          двумя кубическими дугами, а не ломаной: у ломаной рёбра прямые, и стрелка читалась бы как
          обычный треугольник, а у дуг вершина не вырожденная — под полупрозрачной заливкой
          вырожденная вершина мерцает на пёстром фоне.

          Данные заданы в своей системе координат 12×6, а Width и Height выше — 18×9: Stretch
          разносит ту же кривую сам. Правь размер константами в StatusHint.xaml.cs: от него зависит
          вертикальный расклад, который считается через высоту рисунка.
        -->
        <Path x:Name="HintArrow"
              Width="18"
              Height="9"
              Stretch="Uniform"
              Data="M 0 6 C 5 5 5 1 6 0 C 7 1 7 5 12 6 Z"
              Fill="{DynamicResource HintSurface}"
              Visibility="Collapsed" />
    </Canvas>
</UserControl>
